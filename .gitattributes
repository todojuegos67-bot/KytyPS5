# cmd.exe misreads labels (call :label) in batch files with LF line endings.
*.cmd text eol=crlf
*.bat text eol=crlf
# Specialization hints (tools/local/static-precompile/hints-*.hints): zstd-compressed, never converted.
*.hints binary
# FidelityFX SDK patches (tools/local/fsr3-mfg): applied with git apply, keep LF.
*.patch text eol=lf
# AMD FSR 4 model assets (fsr4_shaders/, src/local/fsr4-sr.h): SPIR-V and weights, never converted.
fsr4_shaders/** binary
fsr4_shaders/*.txt text
# Add-to-Steam files and the owner's tested FidelityFX DLL: committed byte-identical, never converted.
tools/local/steam/** -text
tools/local/fsr3-mfg/prebuilt/** -text
# Packaged root files (Demon's Souls launcher and tools): shipped byte-identical to the installed folder, never converted.
/Launcher-souls.ps1 -text
/Launcher-souls-EN.ps1 -text
/metricas.ps1 -text
/kbm_curve.txt -text
/Medir-rendimiento.cmd -text
/Medir-rendimiento.ps1 -text
/Capturar-RT.cmd -text
/Capturar-RT.ps1 -text
*.ttf binary
