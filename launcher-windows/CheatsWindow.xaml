<Window x:Class="KytyLauncher.CheatsWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" Height="560" MinWidth="480" MinHeight="400"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="List" Margin="8,6" />
            </ScrollViewer>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" MinHeight="70">
            <TextBlock x:Name="Description" Style="{StaticResource Desc}" Margin="0" />
        </Border>
        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <Button x:Name="All" Style="{StaticResource FlatButton}" />
            <Button x:Name="None" Style="{StaticResource FlatButton}" Margin="10,0,0,0" />
            <Button x:Name="Cancel" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" IsCancel="True" MinWidth="90" Margin="10,0,0,0" />
            <Button x:Name="Ok" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" IsDefault="True" MinWidth="90" />
        </DockPanel>
    </Grid>
</Window>
