// bb-reactive: FSR 4's model has no reactive input; where the mask asks for this frame's colour
// the upscaled output is blended towards this frame's colour (bilinear, jitter removed).
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D cur_tex;  // render size (linear)
layout(binding = 1) uniform sampler2D mask_tex; // render size (linear)
layout(binding = 2, rgba16f) uniform image2D out_img;
layout(push_constant) uniform Push {
    uvec4 size;  // output width, height, render width, height
    vec4 k;      // jitter x, y (render pixels), strength
} p;

void main() {
    const ivec2 o = ivec2(gl_GlobalInvocationID.xy);
    if (o.x >= int(p.size.x) || o.y >= int(p.size.y)) {
        return;
    }
    const vec2 uv = (vec2(o) + 0.5) / vec2(p.size.xy);
    const vec2 in_size = vec2(p.size.zw);
    const vec2 src = uv + p.k.xy / in_size;
    const float m = textureLod(mask_tex, src, 0.0).r * p.k.z;
    if (m <= 0.004) {
        return;
    }
    const vec4 up = imageLoad(out_img, o);
    const vec3 cur = textureLod(cur_tex, src, 0.0).rgb;
    imageStore(out_img, o, vec4(mix(up.rgb, cur, clamp(m, 0.0, 1.0)), up.a));
}
