// bb-volfog (BB_VOLFOG=1..3): froxel volumetric light inside the game's own fog. A camera-space
// grid (W x H screen tiles x D radial slices, slice s at distance far * s^2) is lit per froxel,
// filtered over time, integrated front to back and added to the game's HDR scene before the
// post-process / upscaler / HUD.
// The medium is the game's distance fog itself (GXLightComposite: opacity
// a1 = A - A * exp2(-(horizontal distance - start) * rate), FC_FogParam v2 = (A, start, rate),
// colour v1): its density along a view ray is d a1 / dt. The game already applied that fog's
// extinction and flat colour, so only light the game lacks is added: moon shafts (the game's
// cascade shadow map) and lamp halos, tinted by the fog colour and attenuated by the fog between
// the froxel and the camera. Where the game has no fog, an own thin haze / ground mist (its own
// extinction) can carry the same light (levels 2 and 3).
//   0 inject     before the shadow-mask pass: moon visibility per froxel -> vis (R16F 3D).
//   1 light      in-scatter per froxel, temporal reprojection -> scat (rgb in-scatter
//                coefficient x light, a own extinction).
//   2 integrate  per column, 3x3 spatial filter, front to back -> integ (rgb added light,
//                a own transmittance).
//   3 apply      scene = scene * T + S (S capped against the scene's log-average luminance).
//   4 measure    log-average luminance of the HDR scene before the fog (64 x 40 samples).
// HDR_R11: the B10G11R11 target through an R32UI view, as bb_rt_post.comp.
#version 460

layout(std140, binding = 0) uniform Params {
    mat4 inv_proj;   // NDC -> view
    mat4 inv_view;   // view -> world
    mat4 prev_view;  // world -> previous view
    mat4 prev_proj;  // previous view -> clip
    mat4 shadow[4];  // world -> cascade i (homogeneous; x y atlas uv after tile, z depth)
    vec4 tile[4];    // cascade output -> atlas uv: xy scale, zw offset
    vec4 tbound[4];  // atlas uv bounds of cascade i: xy min, zw max
    vec4 cdist;      // cascade select view depths 0->1, 1->2, 2->3, end (<= 0: none); x <= 0:
                     // select by bounds only
    uvec4 grid;      // W, H, D, frame
    uvec4 sizes;     // HDR w, h, depth w, h
    vec4 cam;        // world camera position, volume end distance (m)
    vec4 moon_dir;   // world, toward the moon; w: 0 no moon, 1 unshadowed, 2 cascade shadows
    vec4 moon_col;   // rgb, w: Henyey-Greenstein g (moon)
    vec4 amb_col;    // rgb ambient (own medium only), w: Henyey-Greenstein g (point lights)
    vec4 fog;        // own haze density (1/m), haze height falloff (m), mist density, mist height
    vec4 fog2;       // ground reference height (world y), noise amplitude, noise freq (1/m), time
    vec4 wind;       // world wind velocity (m/s), w: albedo
    vec4 misc;       // new-sample weight, history valid, y sign (+1: ndc.y = 1 - 2v), slice jitter
    vec4 misc2;      // scatter strength, debug view, light count, shadow compare (1: lit if z >= d)
    vec4 misc3;      // shadow bias, point-light scale, slice thickness factor (2 far / D), 0
    vec4 gfog;       // game fog: amount A, rate (exp2 per m), start (m), weight (0: none)
    vec4 gfog_col;   // moon light inside the game fog (its colour, luma-mixed), w: shaft scale
    vec4 expo;       // S cap x scene log-avg luminance, light cap x luminance, froxel angle, 0
} p;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(std430, binding = 6) buffer Counters { uint n[16]; } cnt; // [0..2] inject, [8..9] measure

const vec3 Luma = vec3(0.2126, 0.7152, 0.0722);

uint Hash(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

float SliceDist(float s) { return p.cam.w * s * s; }

// Per-froxel slice jitter (interleaved gradient noise rotated by the frame's golden-ratio step).
float Jitter(uvec2 xy) {
    float ign = fract(52.9829189 * fract(0.06711056 * float(xy.x) + 0.00583715 * float(xy.y)));
    return fract(ign + p.misc.w);
}

vec3 ViewRay(vec2 uv) {
    vec4 ndc = vec4(uv.x * 2.0 - 1.0, p.misc.z > 0.0 ? 1.0 - 2.0 * uv.y : 2.0 * uv.y - 1.0, 0.5,
                    1.0);
    vec4 v = p.inv_proj * ndc;
    return normalize(v.xyz / v.w);
}

void Froxel(uvec3 c, out vec3 vdir, out float t) {
    vec2 uv = (vec2(c.xy) + 0.5) / vec2(p.grid.xy);
    vdir = ViewRay(uv);
    t = SliceDist((float(c.z) + Jitter(c.xy)) / float(p.grid.z));
}

// Scene log-average luminance measured this frame (pass 4), 0.02 when not measured.
float SceneLum() {
    float n = float(cnt.n[9]);
    return n > 0.0 ? exp2(float(int(cnt.n[8])) / (256.0 * n)) : 0.02;
}

// The game's distance fog density along a view ray (d a1 / dt): h = horizontal share of the ray.
float GameSigma(float t, float h) {
    if (p.gfog.w <= 0.0) return 0.0;
    float dh = t * h - p.gfog.z;
    if (dh <= 0.0) return 0.0;
    return p.gfog.w * p.gfog.x * p.gfog.y * 0.6931472 * h * exp2(-dh * p.gfog.y);
}

#if VF_PASS == 0
// ---------------------------------------------------------------- inject: moon visibility
layout(binding = 1) uniform sampler2D atlas;
layout(binding = 2, r16f) uniform writeonly image3D vis;

float Lit(float d, float z) {
    return p.misc2.w > 0.5 ? (z >= d - p.misc3.x ? 1.0 : 0.0) : (z <= d + p.misc3.x ? 1.0 : 0.0);
}

float CascadeVis(vec3 w, float vdepth, out bool tested) {
    tested = false;
    const bool by_dist = p.cdist.x > 0.0;
    if (by_dist && p.cdist.w > 0.0 && vdepth >= p.cdist.w) {
        return 1.0;
    }
    for (int i = 0; i < 4; ++i) {
        if (by_dist && i < 3 && !(vdepth < p.cdist[i])) {
            continue;
        }
        vec4 s = p.shadow[i] * vec4(w, 1.0);
        if (abs(s.w) < 1e-8) return 1.0;
        s.xyz /= s.w;
        vec2 uv = s.xy * p.tile[i].xy + p.tile[i].zw;
        bool inside = all(greaterThanEqual(uv, p.tbound[i].xy)) &&
                      all(lessThanEqual(uv, p.tbound[i].zw)) && s.z >= -0.01 && s.z <= 1.01;
        if (!inside) {
            if (by_dist) return 1.0; // outside the selected cascade: unshadowed, as the game
            continue;
        }
        tested = true;
        vec2 ts = vec2(textureSize(atlas, 0));
        vec2 lo = p.tbound[i].xy * ts, hi = p.tbound[i].zw * ts - 1.0;
        vec2 f = uv * ts - 0.5;
        ivec2 i0 = ivec2(floor(f));
        vec2 fr = f - vec2(i0);
        ivec2 a0 = ivec2(clamp(vec2(i0), lo, hi)), a1 = ivec2(clamp(vec2(i0 + 1), lo, hi));
        float a = Lit(texelFetch(atlas, ivec2(a0.x, a0.y), 0).r, s.z);
        float b = Lit(texelFetch(atlas, ivec2(a1.x, a0.y), 0).r, s.z);
        float c = Lit(texelFetch(atlas, ivec2(a0.x, a1.y), 0).r, s.z);
        float d = Lit(texelFetch(atlas, ivec2(a1.x, a1.y), 0).r, s.z);
        return mix(mix(a, b, fr.x), mix(c, d, fr.x), fr.y);
    }
    return 1.0;
}

shared uint s_n[3];

void main() {
    if (gl_LocalInvocationIndex < 3u) s_n[gl_LocalInvocationIndex] = 0u;
    barrier();
    uvec3 c = gl_GlobalInvocationID;
    if (all(lessThan(c, p.grid.xyz))) {
        vec3 vdir;
        float t;
        Froxel(c, vdir, t);
        vec3 w = (p.inv_view * vec4(vdir * t, 1.0)).xyz;
        bool tested;
        float v = CascadeVis(w, abs(vdir.z) * t, tested);
        imageStore(vis, ivec3(c), vec4(v, 0.0, 0.0, 0.0));
        if (tested) {
            atomicAdd(s_n[0], 1u);
            if (v > 0.5) atomicAdd(s_n[1], 1u);
        } else {
            atomicAdd(s_n[2], 1u);
        }
    }
    barrier();
    if (gl_LocalInvocationIndex < 3u) {
        atomicAdd(cnt.n[gl_LocalInvocationIndex], s_n[gl_LocalInvocationIndex]);
    }
}

#elif VF_PASS == 1
// ---------------------------------------------------------------- light
layout(binding = 3) uniform sampler3D vis_tex;  // nearest
layout(binding = 4) uniform sampler3D hist_tex; // previous scat, linear
layout(binding = 5, rgba16f) uniform writeonly image3D scat;
struct Light {
    vec4 pos_r; // world position, radius
    vec4 col;   // diffuse colour (the game's), 0
};
layout(std430, binding = 7) readonly buffer Lights { Light l[]; } lights;

float Corner(ivec3 q) {
    uvec3 u = uvec3(q);
    return float(Hash(u.x ^ Hash(u.y ^ Hash(u.z + 0x9e3779b9u))) & 0xffffu) / 65535.0;
}
float VNoise(vec3 x) {
    ivec3 i = ivec3(floor(x));
    vec3 f = fract(x);
    f = f * f * (3.0 - 2.0 * f);
    float a = mix(Corner(i), Corner(i + ivec3(1, 0, 0)), f.x);
    float b = mix(Corner(i + ivec3(0, 1, 0)), Corner(i + ivec3(1, 1, 0)), f.x);
    float c = mix(Corner(i + ivec3(0, 0, 1)), Corner(i + ivec3(1, 0, 1)), f.x);
    float d = mix(Corner(i + ivec3(0, 1, 1)), Corner(i + ivec3(1, 1, 1)), f.x);
    return mix(mix(a, b, f.y), mix(c, d, f.y), f.z);
}

// Wind-advected noise (two octaves at different speeds: clumping, flowing wisps), 0..1.
float Noise(vec3 w) {
    float tm = p.fog2.w;
    vec3 q = (w - p.wind.xyz * tm) * p.fog2.z;
    vec3 q2 = (w - p.wind.xyz * (tm * 1.6) + vec3(0.0, 0.08 * tm, 0.0)) * (p.fog2.z * 2.7);
    return 0.62 * VNoise(q) + 0.38 * VNoise(q2 + vec3(11.7, 3.9, 7.3));
}

// Own medium (where the game has no fog): height haze + low ground mist, noise-modulated.
float OwnSigma(vec3 w, float n) {
    float h = max(w.y - p.fog2.x, 0.0);
    float haze = p.fog.x * exp(-h / max(p.fog.y, 0.1));
    float mist = p.fog.z * exp(-h / max(p.fog.w, 0.05));
    float a = p.fog2.y;
    return haze * max(1.0 + a * (2.0 * n - 1.0), 0.0) +
           mist * mix(1.0, 2.0 * smoothstep(0.3, 0.7, n), a);
}

float HG(float g, float ct) {
    float g2 = g * g;
    return (1.0 - g2) / pow(max(1.0 + g2 - 2.0 * g * ct, 1e-4), 1.5); // x 4 pi (1: isotropic)
}

void main() {
    uvec3 c = gl_GlobalInvocationID;
    if (any(greaterThanEqual(c, p.grid.xyz))) return;
    vec3 vdir;
    float t;
    Froxel(c, vdir, t);
    vec3 w = (p.inv_view * vec4(vdir * t, 1.0)).xyz;
    vec3 wdir = normalize(w - p.cam.xyz);
    int dbg = int(p.misc2.y);
    float n = Noise(w);
    float sig_o = OwnSigma(w, n);
    // The game's fog density, its wisps broken up by the same noise (mean preserved).
    float sig_g = GameSigma(t, length(wdir.xz)) * max(1.0 + p.fog2.y * (2.0 * n - 1.0), 0.0);
    float Ls = SceneLum();

    // Moon: in the own medium with the moon's colour; inside the game's fog only with the cascade
    // shadows (shafts, nothing flat on top of the game's own fog colour) and in the game fog's
    // own radiance units (its colour, luma-mixed as GXLightComposite does).
    vec3 Lm = vec3(0.0), Lmg = vec3(0.0);
    if (p.moon_dir.w > 0.5 && dbg != 4) {
        float shadowed = p.moon_dir.w > 1.5 ? 1.0 : 0.0;
        float v = shadowed > 0.0 ? texelFetch(vis_tex, ivec3(c), 0).r : 1.0;
        float ph = v * HG(p.moon_col.w, dot(wdir, p.moon_dir.xyz));
        Lm = p.moon_col.rgb * ph;
        Lmg = p.gfog_col.rgb * (p.gfog_col.w * ph * shadowed);
    }
    // Point lights: halos only. The game's falloff max(0, 1/d^2 - 1/r^2) (0 at the radius),
    // its near field spread over the froxel's own size (no hot froxel next to a small light),
    // windowed, and the sum capped against the scene's luminance.
    vec3 Ll = vec3(0.0);
    int nl = int(p.misc2.z);
    float fsz = max(t * p.expo.z, p.misc3.z * sqrt(t / p.cam.w));
    float rs2 = max(0.25, 0.25 * fsz * fsz);
    for (int i = 0; i < nl; ++i) {
        vec4 pr = lights.l[i].pos_r;
        vec3 d = pr.xyz - w;
        float d2 = dot(d, d);
        float r2 = pr.w * pr.w;
        if (d2 >= r2) continue;
        float att = max(1.0 / (d2 + rs2) - 1.0 / (r2 + rs2), 0.0) * (1.0 - d2 / r2);
        Ll += lights.l[i].col.rgb * (att * HG(p.amb_col.w, dot(wdir, d * inversesqrt(max(d2, 1e-6)))));
    }
    Ll *= p.misc3.y;
    float ll = dot(Ll, Luma), cap = p.expo.y * Ls;
    if (ll > cap) Ll *= cap / ll;
    if (dbg == 5) Ll = vec3(0.0);

    vec3 game = sig_g * (Lmg + Ll);
    vec3 own = sig_o * (Lm + Ll + (dbg == 4 ? vec3(0.0) : p.amb_col.rgb));
    vec4 cur = vec4((game + own) * (p.wind.w * p.misc2.x), sig_o);
    if (p.misc.y > 0.5) {
        vec3 pv = (p.prev_view * vec4(w, 1.0)).xyz;
        vec4 clip = p.prev_proj * vec4(pv, 1.0);
        float pt = length(pv);
        if (clip.w > 1e-4 && pt > 1e-3) {
            vec2 ndc = clip.xy / clip.w;
            vec2 uv = vec2(ndc.x * 0.5 + 0.5, p.misc.z > 0.0 ? 0.5 - 0.5 * ndc.y : 0.5 + 0.5 * ndc.y);
            float s = sqrt(pt / p.cam.w);
            if (all(greaterThanEqual(uv, vec2(0.0))) && all(lessThanEqual(uv, vec2(1.0))) &&
                s <= 1.0) {
                vec4 h = textureLod(hist_tex, vec3(uv, s), 0.0);
                if (!any(isnan(h)) && !any(isinf(h))) {
                    cur = mix(h, cur, p.misc.x);
                }
            }
        }
    }
    imageStore(scat, ivec3(c), cur);
}

#elif VF_PASS == 2
// ---------------------------------------------------------------- integrate
layout(binding = 8) uniform sampler3D scat_tex; // nearest
layout(binding = 9, rgba16f) uniform writeonly image3D integ;

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(uvec2(c), p.grid.xy))) return;
    vec3 wdir = normalize((p.inv_view * vec4(ViewRay((vec2(c) + 0.5) / vec2(p.grid.xy)), 0.0)).xyz);
    float hfrac = length(wdir.xz);
    ivec2 mx = ivec2(p.grid.xy) - 1;
    vec3 acc = vec3(0.0);
    float Tall = 1.0, Town = 1.0, prev_t = 0.0;
    int D = int(p.grid.z);
    for (int k = 0; k < D; ++k) {
        float t1 = SliceDist(float(k + 1) / float(D));
        float dt = t1 - prev_t;
        float tm = 0.5 * (t1 + prev_t);
        prev_t = t1;
        // 3x3 tent filter in the slice: no froxel-sized blocks / dots.
        vec4 s = vec4(0.0);
        for (int y = -1; y <= 1; ++y) {
            for (int x = -1; x <= 1; ++x) {
                float wgt = float((2 - abs(x)) * (2 - abs(y)));
                s += wgt * texelFetch(scat_tex, ivec3(clamp(c + ivec2(x, y), ivec2(0), mx), k), 0);
            }
        }
        s /= 16.0;
        float so = max(s.a, 0.0);
        float st = max(so + GameSigma(tm, hfrac), 1e-7);
        float tr = exp(-st * dt);
        acc += Tall * (s.rgb * (1.0 - tr) / st);
        Tall *= tr;
        Town *= exp(-so * dt);
        imageStore(integ, ivec3(c, k), vec4(acc, Town));
    }
}

