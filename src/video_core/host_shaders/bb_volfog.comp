// ---------------------------------------------------------------- measure (before the apply)
shared int s_sum;
shared uint s_cnt;
void main() {
    if (gl_LocalInvocationIndex == 0u) {
        s_sum = 0;
        s_cnt = 0u;
    }
    barrier();
    uvec2 g = gl_GlobalInvocationID.xy; // 64 x 40 samples
    if (g.x < 64u && g.y < 40u) {
        ivec2 px = ivec2((vec2(g) + 0.5) / vec2(64.0, 40.0) * vec2(p.sizes.xy));
        vec3 col = LoadHdr(px);
        float l = dot(col, Luma);
        if (!isnan(l) && !isinf(l)) {
            atomicAdd(s_sum, int(round(clamp(log2(max(l, 1e-4)), -14.0, 8.0) * 256.0)));
            atomicAdd(s_cnt, 1u);
        }
    }
    barrier();
    if (gl_LocalInvocationIndex == 0u) {
        atomicAdd(cnt.n[8], uint(s_sum));
        atomicAdd(cnt.n[9], s_cnt);
    }
}
