// Frame generation's HUD-less image on the in-place path (bb_fg.h). Bloodborne draws its HUD into
// an intermediate image A and then copies A to the presented image in one full-screen pass through
// a 1D curve. A was copied just before its first HUD draw (S); after the frame A holds the frame
// with its HUD (T) and the presented image holds curve(T) (F). Every byte value is mapped
// per channel:
//  mode 0: table[c][T.c] = F.c for every pixel; two different F for the same T is a conflict.
//  mode 1: out = table(S) (gaps between known entries interpolated); where S == T (no HUD there)
//          out must equal F: else a mismatch. The counters gate the result (mode 2).
//  mode 2: when there was a conflict or a mismatch, out = F (a HUD-less image equal to the
//          presented one: frame generation then treats nothing as HUD, as without one).
//  mode 3: resolved[768] = table with its gaps interpolated (768 invocations, once per frame).
// All values are the raw bytes (UNORM views). Cost (0.23): the per-pixel gap scan and the
// per-pixel global atomics of 0.22 made this pass take hundreds of ms; mode 0 now only issues an
// atomic when an entry is new or differs, gaps are resolved once in mode 3, and the counters are
// summed per workgroup. Modes 0 and 2 and the counting run only on the sampled check frames
// (p.size.w = 1); other frames run mode 3 + mode 1 on the last checked table.
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D t_tex;
layout(binding = 1) uniform sampler2D f_tex;
layout(binding = 2) uniform sampler2D s_tex;
layout(binding = 3, rgba8) uniform image2D out_img;
layout(std430, binding = 4) buffer Lut {
    uint conflicts;
    uint mismatches;
    uint gaps;
    uint hud;
    uint table[768];
    uint resolved[768];
} lut;
layout(push_constant) uniform Push {
    uvec4 size; // width, height, mode, check
} p;

shared uint g_mismatch;
shared uint g_hud;

uvec3 Bytes(vec4 c) {
    return uvec3(round(clamp(c.rgb, 0.0, 1.0) * 255.0));
}

uint Resolve(uint c, uint v) {
    uint e = lut.table[c * 256u + v];
    if (e != 0u) {
        return e - 1u;
    }
    int lo = int(v) - 1, hi = int(v) + 1;
    while (lo >= 0 && lut.table[c * 256u + uint(lo)] == 0u) --lo;
    while (hi <= 255 && lut.table[c * 256u + uint(hi)] == 0u) ++hi;
    if (p.size.w != 0u) atomicAdd(lut.gaps, 1u);
    if (lo < 0 && hi > 255) return v;
    if (lo < 0) return lut.table[c * 256u + uint(hi)] - 1u;
    if (hi > 255) return lut.table[c * 256u + uint(lo)] - 1u;
    const float a = float(lut.table[c * 256u + uint(lo)] - 1u);
    const float b = float(lut.table[c * 256u + uint(hi)] - 1u);
    return uint(round(mix(a, b, float(int(v) - lo) / float(hi - lo))));
}

void main() {
    if (p.size.z == 3u) {
        const uint i = gl_GlobalInvocationID.y * 96u + gl_GlobalInvocationID.x;
        if (i < 768u) {
            lut.resolved[i] = Resolve(i / 256u, i % 256u);
        }
        return;
    }
    const bool count = p.size.w != 0u && p.size.z == 1u;
    if (count) {
        if (gl_LocalInvocationIndex == 0u) {
            g_mismatch = 0u;
            g_hud = 0u;
        }
        barrier();
    }
    ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    const bool inside = xy.x < int(p.size.x) && xy.y < int(p.size.y);
    if (inside) {
        const vec4 fc = texelFetch(f_tex, xy, 0);
        if (p.size.z == 0u) {
            const uvec3 t = Bytes(texelFetch(t_tex, xy, 0));
            const uvec3 f = Bytes(fc);
            for (uint c = 0u; c < 3u; ++c) {
                const uint idx = c * 256u + t[c];
                const uint want = f[c] + 1u;
                if (lut.table[idx] == want) continue; // the common case: no atomic
                const uint prev = atomicCompSwap(lut.table[idx], 0u, want);
                if (prev != 0u && prev != want) {
                    atomicAdd(lut.conflicts, 1u);
                }
            }
        } else if (p.size.z == 1u) {
            const uvec3 s = Bytes(texelFetch(s_tex, xy, 0));
            const uvec3 o = uvec3(lut.resolved[s.r], lut.resolved[256u + s.g],
                                  lut.resolved[512u + s.b]);
            if (count) {
                const uvec3 t = Bytes(texelFetch(t_tex, xy, 0));
                if (all(equal(s, t))) {
                    if (any(notEqual(o, Bytes(fc)))) atomicAdd(g_mismatch, 1u);
                } else {
                    atomicAdd(g_hud, 1u);
                }
            }
            imageStore(out_img, xy, vec4(vec3(o) / 255.0, fc.a));
        } else if (lut.conflicts != 0u || lut.mismatches != 0u) {
            imageStore(out_img, xy, fc);
        }
    }
    if (count) {
        barrier();
        if (gl_LocalInvocationIndex == 0u) {
            if (g_mismatch != 0u) atomicAdd(lut.mismatches, g_mismatch);
            if (g_hud != 0u) atomicAdd(lut.hud, g_hud);
        }
    }
}
