// The HUD on top of the window-size upscale (BB upscaling, bb_upscale.h): the game drew its HUD
// at its own size into the presented image after the copy the upscaler read (hudless). Where the two
// differ, that difference (the HUD, scaled to the window with bilinear filtering) is added to the
// upscaled image; where the HUD covers the scene the game's own pixels are taken. Without HUD the
// difference is exactly zero and the upscaled image is presented as is.
//
// Colour: everything is brought into the space the presenter expects from the flip view (linear
// for an sRGB flip, which the presenter's post process encodes once). With flag 1 the upscaler
// was given (and returned) sRGB-encoded perceptual LDR values and the HUD-less copy holds the
// same encoded values: both are decoded here, the flip (final_tex, an sRGB view) is already
// linear. Non-finite colour from a back end is cleared here (the separate alpha pass is skipped
// on this path: the presenter never reads alpha).
// Flag 4: frame generation's HUD-less image (bb_fg.h): the HUD-less copy stands in for the
// presented image, so the result is the upscaled image alone, in the same colour space.
// Flag 8: sharp (EASU-like) reconstruction of the HUD layer instead of bilinear (see SharpSample).
// Flag 2: frame self-check, the luminance of a 64x64 grid of the game's image and of ours is
// summed into lum (16.16 fixed point) for the host to compare.
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D upscaled_tex;
layout(binding = 1) uniform sampler2D final_tex;
layout(binding = 2) uniform sampler2D hudless_tex;
layout(binding = 3, rgba16f) uniform writeonly image2D out_img;
layout(std430, binding = 4) buffer Lum {
    uint sums[12]; // luminance source, output, count, 0, saturation source, output, luminance^2 source, output
} lum;
layout(push_constant) uniform Push {
    uvec4 size; // width, height, decode sRGB at the end (flip read raw, presenter view sRGB), flags
} p;

float Saturation(vec3 c) {
    float hi = max(max(c.r, c.g), c.b);
    float lo = min(min(c.r, c.g), c.b);
    return hi > 1e-5 ? clamp((hi - lo) / hi, 0.0, 1.0) : 0.0;
}

vec3 SrgbToLinear(vec3 c) {
    return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), greaterThan(c, vec3(0.04045)));
}

// 0.69 (full-frame scaling): the game's final image and its HUD-less copy are both at the render
// size. 0.64 read them with one bilinear tap each, so the HUD (text, icons, menus) was a blurry
// bilinear stretch on top of a sharp upscaled scene. Now (flag 8, default) both go through the
// same 4x4 Catmull-Rom (Lanczos-like) kernel, its result clamped to the 2x2 nearest texels as
// FSR 1 EASU does (no ringing around text), so the HUD is reconstructed sharply at the window size
// and the difference fin - bare stays exactly zero wherever the game drew no HUD (one linear
// kernel applied to two equal neighbourhoods).
vec4 CubicW(float t) {
    float t2 = t * t, t3 = t2 * t;
    return vec4(-0.5 * t3 + t2 - 0.5 * t, 1.5 * t3 - 2.5 * t2 + 1.0,
                -1.5 * t3 + 2.0 * t2 + 0.5 * t, 0.5 * t3 - 0.5 * t2);
}

vec3 SharpSample(sampler2D tex, vec2 uv) {
    vec2 size = vec2(textureSize(tex, 0));
    vec2 pos = uv * size - 0.5;
    vec2 base = floor(pos);
    vec2 f = pos - base;
    vec4 wx = CubicW(f.x), wy = CubicW(f.y);
    ivec2 b = ivec2(base);
    ivec2 hi = ivec2(size) - 1;
    vec3 acc = vec3(0.0);
    vec3 lo4 = vec3(1e9), hi4 = vec3(-1e9);
    for (int j = 0; j < 4; ++j) {
        for (int i = 0; i < 4; ++i) {
            vec3 t = texelFetch(tex, clamp(b + ivec2(i - 1, j - 1), ivec2(0), hi), 0).rgb;
            acc += t * (wx[i] * wy[j]);
            if ((i == 1 || i == 2) && (j == 1 || j == 2)) {
                lo4 = min(lo4, t);
                hi4 = max(hi4, t);
            }
        }
    }
    return clamp(acc, lo4, hi4);
}

float Luma(vec3 c) {
    return dot(clamp(c, 0.0, 1.0), vec3(0.2126, 0.7152, 0.0722));
}

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (c.x >= int(p.size.x) || c.y >= int(p.size.y)) {
        return;
    }
    vec2 uv = (vec2(c) + 0.5) / vec2(p.size.xy);
    vec3 up = texelFetch(upscaled_tex, c, 0).rgb;
    if (any(isnan(up)) || any(isinf(up))) {
        up = vec3(0.0);
    }
    up = clamp(up, 0.0, 1.0);
    const bool sharp = (p.size.w & 8u) != 0u;
    vec3 fin = sharp ? SharpSample(final_tex, uv) : textureLod(final_tex, uv, 0.0).rgb;
    vec3 bare = sharp ? SharpSample(hudless_tex, uv) : textureLod(hudless_tex, uv, 0.0).rgb;
    if ((p.size.w & 1u) != 0u) {
        up = SrgbToLinear(up);
        bare = SrgbToLinear(bare);
    }
    if ((p.size.w & 4u) != 0u) {
        fin = bare;
    }
    vec3 hud = fin - bare;
    float cover = smoothstep(0.25, 0.5, max(max(abs(hud.r), abs(hud.g)), abs(hud.b)));
    vec3 color = clamp(mix(up + hud, fin, cover), 0.0, 1.0);
    if (p.size.z != 0u) {
        color = SrgbToLinear(color);
        fin = SrgbToLinear(clamp(fin, 0.0, 1.0));
    }
    if ((p.size.w & 2u) != 0u) {
        ivec2 cell = ivec2(vec2(c) * 64.0 / vec2(p.size.xy));
        ivec2 centre = ivec2((vec2(cell) + 0.5) * vec2(p.size.xy) / 64.0);
        if (c == centre) {
            atomicAdd(lum.sums[0], uint(Luma(fin) * 65536.0 + 0.5));
            atomicAdd(lum.sums[1], uint(Luma(color) * 65536.0 + 0.5));
            atomicAdd(lum.sums[2], 1u);
            atomicAdd(lum.sums[4], uint(Saturation(fin) * 65536.0 + 0.5));
            atomicAdd(lum.sums[5], uint(Saturation(color) * 65536.0 + 0.5));
            atomicAdd(lum.sums[6], uint(Luma(fin) * Luma(fin) * 65536.0 + 0.5));
            atomicAdd(lum.sums[7], uint(Luma(color) * Luma(color) * 65536.0 + 0.5));
            atomicAdd(lum.sums[8], uint(clamp(fin.r, 0.0, 1.0) * 65536.0 + 0.5));
            atomicAdd(lum.sums[9], uint(clamp(color.r, 0.0, 1.0) * 65536.0 + 0.5));
            atomicAdd(lum.sums[10], uint(clamp(fin.b, 0.0, 1.0) * 65536.0 + 0.5));
            atomicAdd(lum.sums[11], uint(clamp(color.b, 0.0, 1.0) * 65536.0 + 0.5));
        }
    }
    imageStore(out_img, c, vec4(color, 1.0));
}
