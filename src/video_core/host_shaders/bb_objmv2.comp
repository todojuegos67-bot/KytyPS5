// BB object motion vectors v2 (bb_objmv2.h): the G-buffer pass wrote per-object vectors (vertex
// shader run once more with last frame's buffers, only for skinned / blended draws) into an
// RGBA16F image: (dx, dy, class, weight); class 1 moving opaque, 2 static draw (check only,
// never replaces), 3 blended (alpha-weighted), 4 skinned (BB_NATIVE_MV2; replaces as class 1).
// Units and sign as bb_mv.comp: render pixels, previous minus current, y down, no jitter (the
// guest positions are never jittered).
// Additive mode (flags bit 1): the snapshots do not hold the camera (static draws give ~0),
// so the vector is the object's own motion and the camera vector is added to it.
// Every frame the pass is a fetch + store on object pixels only; the statistics (flags bit 0)
// and the colour reprojection check (bit 3, previous colour stored the frame before, bit 2)
// run once every 60 frames.
// Stats words: 0 object px, 1 blended px, 2 all px, 3 checked px, 4 err obj, 5 err cam,
// 6 px where obj wins, 7 px where cam wins, 8 static px, 9 sum |obj-cam| (1/16 px),
// 10 sum |obj| (1/16 px).
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D obj_mv;
layout(binding = 1, rg16f) uniform image2D mv_out;
layout(binding = 2, std430) buffer Stats {
    uint s[16];
} st;
layout(binding = 3) uniform sampler2D cur_color;
layout(binding = 4) uniform sampler2D prev_color;
layout(binding = 5, rgba16f) uniform writeonly image2D next_prev_color;
layout(push_constant) uniform Push {
    uvec4 size; // width, height, replace (0 on history resets), flags
} p;

shared uint g_nz, g_obj, g_blend, g_all, g_chk, g_eo, g_ec, g_wo, g_wc, g_st, g_sa, g_sz;

float Luma(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// bb-player-mv: refine a player pixel's vector against last frame's colour.
float PatchCost(ivec2 c, vec2 v, vec2 size) {
    float e = 0.0;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            const ivec2 q = clamp(c + ivec2(dx, dy), ivec2(0), ivec2(size) - 1);
            const vec2 uv = (vec2(q) + 0.5 + v) / size;
            e += abs(Luma(texelFetch(cur_color, q, 0).rgb) - Luma(textureLod(prev_color, uv, 0.0).rgb));
        }
    }
    return e / 9.0;
}
bool PlayerPixel(ivec2 c, vec2 size) {
    const vec2 uv = (vec2(c) + 0.5) / size;
    return abs(uv.x - 0.5) < 0.16 && uv.y > 0.22 && uv.y < 0.97;
}
vec2 Refine(ivec2 c, vec2 v, bool additive) {
    const vec2 size = vec2(p.size.xy);
    const float e0 = PatchCost(c, v, size);
    float best = e0;
    vec2 bv = v;
    for (int i = 0; i < 12; ++i) {
        vec2 cand;
        if (i < 8) {
            const ivec2 o8[8] = ivec2[](ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1),
                                        ivec2(1, 1), ivec2(-1, -1), ivec2(1, -1), ivec2(-1, 1));
            cand = v + vec2(o8[i]);
        } else {
            const ivec2 n4[4] = ivec2[](ivec2(4, 0), ivec2(-4, 0), ivec2(0, 4), ivec2(0, -4));
            const ivec2 q = clamp(c + n4[i - 8], ivec2(0), ivec2(size) - 1);
            const vec4 o = texelFetch(obj_mv, q, 0);
            if (!((o.z > 0.5 && o.z < 1.5) || o.z > 3.5) || any(isnan(o.xy)) || any(isinf(o.xy))) {
                continue;
            }
            cand = additive ? o.xy + imageLoad(mv_out, q).xy : o.xy;
        }
        const float e = PatchCost(c, cand, size);
        if (e < best) { best = e; bv = cand; }
    }
    const bool change = best < e0 * 0.85 - 0.002;
    if (change) atomicAdd(st.s[13], 1u);
    atomicAdd(st.s[14], uint(clamp(e0, 0.0, 4.0) * 1024.0));
    atomicAdd(st.s[15], uint(clamp(change ? best : e0, 0.0, 4.0) * 1024.0));
    return change ? bv : v;
}

void main() {
    const ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    const bool inside = c.x < int(p.size.x) && c.y < int(p.size.y);
    const uint flags = p.size.w;
    const bool additive = (flags & 2u) != 0u;
    // bb-native-mv2 (flags bit 5): skinned draws are class 4 and the player mask is them in the
    // centre (else: moving opaque pixels in the centre whose vector differs from the camera's).
    const bool characters = (flags & 32u) != 0u;
    if ((flags & 1u) == 0u) {
        // Normal frame: replace the camera vector on object pixels, nothing else.
        if (!inside || p.size.z == 0u) return;
        const vec4 o = texelFetch(obj_mv, c, 0);
        bool player = false;
        if ((o.z > 0.5 && o.z < 1.5) || o.z > 2.5) {
            if (!any(isnan(o.xy)) && !any(isinf(o.xy))) {
                const vec2 camv = imageLoad(mv_out, c).xy;
                vec2 v = o.xy;
                if (additive) v += camv;
                // Only what moves against the world (the player, not the tree behind it: static
                // scenery in the centre took refined vectors and deformed).
                const bool candidate =
                    PlayerPixel(c, vec2(p.size.xy)) &&
                    (characters ? o.z > 3.5 : (o.z < 1.5 && length(v - camv) > 0.75));
                if (candidate && (characters || (flags & 16u) != 0u)) {
                    player = true;
                    atomicAdd(st.s[12], 1u);
                    if ((flags & 16u) != 0u) v = Refine(c, v, additive);
                }
                imageStore(mv_out, c, vec4(v, 0.0, 0.0));
            }
        }
        if ((flags & 4u) != 0u) {
            // .a: the player mask (BB_FSR3_PLAYER_REAL reads it: the player from the real frame)
            imageStore(next_prev_color, c, vec4(texelFetch(cur_color, c, 0).rgb, player ? 1.0 : 0.0));
        }
        return;
    }
    // Statistics frame (1 in 60).
    if (gl_LocalInvocationIndex == 0u) {
        g_nz = 0u; g_obj = 0u; g_blend = 0u; g_all = 0u; g_chk = 0u;
        g_eo = 0u; g_ec = 0u; g_wo = 0u; g_wc = 0u; g_st = 0u; g_sa = 0u; g_sz = 0u;
    }
    barrier();
    if (inside) {
        atomicAdd(g_all, 1u);
        const vec4 o = texelFetch(obj_mv, c, 0);
        if (any(notEqual(o, vec4(0.0)))) atomicAdd(g_nz, 1u);
        const vec2 cam = imageLoad(mv_out, c).xy;
        const bool finite = !any(isnan(o.xy)) && !any(isinf(o.xy));
        if (finite && o.z > 1.5 && o.z < 2.5) {
            // Static draw: its object vector must equal the camera vector (absolute mode) or
            // be ~0 (additive mode).
            atomicAdd(g_st, 1u);
            atomicAdd(g_sa, uint(min(length(o.xy - cam), 64.0) * 16.0));
            atomicAdd(g_sz, uint(min(length(o.xy), 64.0) * 16.0));
        } else if (finite && ((o.z > 0.5 && o.z < 1.5) || o.z > 2.5)) {
            const vec2 ov = additive ? o.xy + cam : o.xy;
            if (o.z > 2.5 && o.z < 3.5) atomicAdd(g_blend, 1u);
            atomicAdd(g_obj, 1u);
            if ((flags & 8u) != 0u && length(ov - cam) > 1.0) {
                const vec2 size = vec2(p.size.xy);
                const vec2 uv = (vec2(c) + 0.5) / size;
                const float cur = Luma(texelFetch(cur_color, c, 0).rgb);
                const float eo = abs(Luma(textureLod(prev_color, uv + ov / size, 0.0).rgb) - cur);
                const float ec = abs(Luma(textureLod(prev_color, uv + cam / size, 0.0).rgb) - cur);
                atomicAdd(g_chk, 1u);
                atomicAdd(g_eo, uint(clamp(eo, 0.0, 4.0) * 1024.0));
                atomicAdd(g_ec, uint(clamp(ec, 0.0, 4.0) * 1024.0));
                if (eo + 1e-3 < ec) atomicAdd(g_wo, 1u);
                else if (ec + 1e-3 < eo) atomicAdd(g_wc, 1u);
            }
            if (p.size.z != 0u) {
                imageStore(mv_out, c, vec4(ov, 0.0, 0.0));
            }
        }
        if ((flags & 4u) != 0u) {
            const bool pl = finite && PlayerPixel(c, vec2(p.size.xy)) &&
                            (characters ? o.z > 3.5
                                        : (o.z > 0.5 && o.z < 1.5 &&
                                           length((additive ? o.xy + cam : o.xy) - cam) > 0.75));
            imageStore(next_prev_color, c, vec4(texelFetch(cur_color, c, 0).rgb, pl ? 1.0 : 0.0));
        }
    }
    barrier();
    if (gl_LocalInvocationIndex == 0u) {
        if (g_nz != 0u) atomicAdd(st.s[11], g_nz);
        if (g_obj != 0u) atomicAdd(st.s[0], g_obj);
        if (g_blend != 0u) atomicAdd(st.s[1], g_blend);
        atomicAdd(st.s[2], g_all);
        if (g_chk != 0u) {
            atomicAdd(st.s[3], g_chk);
            atomicAdd(st.s[4], g_eo);
            atomicAdd(st.s[5], g_ec);
            atomicAdd(st.s[6], g_wo);
            atomicAdd(st.s[7], g_wc);
        }
        if (g_st != 0u) {
            atomicAdd(st.s[8], g_st);
            atomicAdd(st.s[9], g_sa);
            atomicAdd(st.s[10], g_sz);
        }
    }
}
