// BB object motion vectors v2 (bb_objmv2.h): the G-buffer pass wrote per-object vectors (vertex
// shader run once more with last frame's buffers, only for skinned / blended draws) into an
// RGBA16F image: (dx, dy, class, weight); class 1 moving opaque, 2 static draw (check only,
// never replaces), 3 blended (alpha-weighted), 4 skinned (BB_NATIVE_MV2; replaces as class 1).
// Units and sign as bb_mv.comp: render pixels, previous minus current, y down, no jitter (the
// guest positions are never jittered).
// Additive mode (flags bit 1): the snapshots do not hold the camera (static draws give ~0),
// so the vector is the object's own motion and the camera vector is added to it.
// Every frame the pass is a fetch + store on object pixels only; the statistics (flags bit 0)
// and the colour reprojection check (bit 3, previous colour stored the frame before, bit 2)
// run once every 60 frames.
// Stats words: 0 object px, 1 blended px, 2 all px, 3 checked px, 4 err obj, 5 err cam,
// 6 px where obj wins, 7 px where cam wins, 8 static px, 9 sum |obj-cam| (1/16 px),
// 10 sum |obj| (1/16 px), 16 fog px (coverage > 0.02), 17 sum coverage (1/1024), 18 dense fog px
// (coverage > 0.5), 19 fog px over an object's own vector (class 1 / 4).
// bb-fog-mv (flags bit 6): .w is the coverage of the blended draws (fog, smoke, particles) that
// wrote their own static-world vector over the one behind ((dx, dy) already weighted by the
// blending). Where nothing opaque wrote a vector (class 0: sky, backup) the camera vector is what
// lies behind them: v = (dx, dy) + (1 - coverage) * camera. Bit 7: the coverage also raises the
// upscaler's reactive mask (binding 6).
// bb-mv-fill (flags bit 9, BB_FG_SPARKS=1): class 5 = an additive / premultiplied effect (sparks,
// embers, glows) wrote its own static-world vector there (weight 1 where its contribution was
// bright): that vector replaces the one behind, (not reactive for the upscaler), and bit 1
// of .a of the stored colour marks it for the HUD-less pass (FG takes it from the real frame).
// Stats word 22: class-5 px (statistics frames).
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D obj_mv;
layout(binding = 1, rg16f) uniform image2D mv_out;
layout(binding = 2, std430) buffer Stats {
    uint s[24];
} st;
layout(binding = 3) uniform sampler2D cur_color;
layout(binding = 4) uniform sampler2D prev_color;
layout(binding = 5, rgba16f) uniform writeonly image2D next_prev_color;
layout(binding = 6, r16f) uniform image2D reactive_io;
layout(binding = 7) uniform sampler2D scene_depth; // bb-mv-sky (p.sky.z == 1)
layout(push_constant) uniform Push {
    uvec4 size; // width, height, replace (0 on history resets), flags
    vec4 sky;   // bb-mv-sky: depth threshold, 1: greater = nearer, 1: on
} p;

shared uint g_nz, g_obj, g_blend, g_all, g_chk, g_eo, g_ec, g_wo, g_wc, g_st, g_sa, g_sz;
shared uint g_fp, g_fw, g_fd, g_fo, g_kk, g_kd, g_sp, g_ss;

const float kFogMin = 0.02;

// bb-fog-mv: the vector of a pixel with blended coverage `cov` (class o.z of the opaque draw
// behind: > 0.5 when it wrote a vector, which the blending already weighted).
vec2 FogVector(vec4 o, vec2 camv, float cov) {
    return o.z > 0.5 ? o.xy : o.xy + (1.0 - cov) * camv;
}

// bb-fog-keepobj (flags bit 8): on a pixel with an object's own vector (class 1 / 4) the blended
// layers mixed their static-world vector into it: o.xy = cov * fog + (1 - cov) * object. The fog
// vector is the static-world one (absolute mode: ~ the camera vector, additive: ~ 0), so the
// object's vector is recovered: (o.xy - cov * camera) / (1 - cov). Dense layers (cov > 0.9): no
// reliable recovery, the blended vector stays. Either way the pixel is made reactive.
const float kKeepMax = 0.9;
vec2 KeepObject(vec4 o, vec2 camv, float cov, bool additive) {
    const vec2 fogv = additive ? vec2(0.0) : camv;
    return (o.xy - cov * fogv) / (1.0 - cov);
}
void KeepReactive(ivec2 c, float cov) {
    const float r = imageLoad(reactive_io, c).r;
    imageStore(reactive_io, c, vec4(max(r, smoothstep(0.05, 0.9, cov) * 0.7)));
}

// bb-mv-candles (flags bit 9 with bit 6): with BB_FG_SPARKS the blended draws write the class
// channel too: 0 (B = class * (1 - .w)) or 5 with weight 1 where their own contribution is bright
// (.w then 1). Effect draws set .w = 1 where they write 5. Decoded here to the opaque class, or 5.
vec4 Fetch(ivec2 q) {
    vec4 o = texelFetch(obj_mv, q, 0);
    const uint fl = p.size.w;
    if ((fl & 512u) != 0u && (fl & 64u) != 0u) {
        const float cov = clamp(o.w, 0.0, 1.0);
        // (review) below .995 class 5 cannot occur (its .w is 1): cap the decode at 4 so fp16
        // rounding of a dense stack over a character (class 4) never reads as a spark.
        o.z = cov > 0.995 ? (o.z > 5.5 ? 6.0 : (o.z > 0.5 ? 5.0 : 0.0))
                          : min(o.z / (1.0 - cov), 4.0);
    }
    return o;
}

// bb-mv-sky: the opaque depth behind the pixel is the sky (view distance >= half the far plane):
// a bright blended layer there is the moon or moonlit cloud / mist, not a spark: as "real-frame
// pixels" in the HUD-less image it popped against the interpolated sky around it (blocky moon
// edge, cloud pattern jumping in the generated frames, fallo3.mp4 263 / 265).
bool SkyAt(ivec2 c) {
    if (p.sky.z < 0.5) return false;
    const float d = texelFetch(scene_depth, c, 0).r;
    return p.sky.y > 0.5 ? d <= p.sky.x : d >= p.sky.x;
}
bool IsSparkRaw(vec4 o, bool sparks) {
    return sparks && o.z > 4.5 && o.z < 6.5;
}
// bb-mv-fire: class 6 = an effect composited from the game's own effect buffer (screen-space
// draw, no vector of its own): marked for the HUD-less image only, the vector behind it stays.
bool MarkOnly(vec4 o) {
    return o.z > 5.5;
}
bool IsSpark(vec4 o, bool sparks, ivec2 c) {
    return IsSparkRaw(o, sparks) && !SkyAt(c);
}
// bb-mv-dots: spark pixels no longer raise the upscaler's reactive mask (0.9 made DLSS / FSR drop
// their history there: aliasing on anything marked, e.g. bright rims on the character). Only frame
// generation needs them (the HUD-less marking).

void FogReactive(ivec2 c, float cov) {
    const float r = imageLoad(reactive_io, c).r;
    imageStore(reactive_io, c, vec4(max(r, smoothstep(0.2, 0.9, cov) * 0.5)));
}

float Luma(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// bb-player-mv: refine a player pixel's vector against last frame's colour.
float PatchCost(ivec2 c, vec2 v, vec2 size) {
    float e = 0.0;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            const ivec2 q = clamp(c + ivec2(dx, dy), ivec2(0), ivec2(size) - 1);
            const vec2 uv = (vec2(q) + 0.5 + v) / size;
            e += abs(Luma(texelFetch(cur_color, q, 0).rgb) - Luma(textureLod(prev_color, uv, 0.0).rgb));
        }
    }
    return e / 9.0;
}
bool PlayerPixel(ivec2 c, vec2 size) {
    const vec2 uv = (vec2(c) + 0.5) / size;
    return abs(uv.x - 0.5) < 0.16 && uv.y > 0.22 && uv.y < 0.97;
}
vec2 Refine(ivec2 c, vec2 v, bool additive) {
    const vec2 size = vec2(p.size.xy);
    const float e0 = PatchCost(c, v, size);
    float best = e0;
    vec2 bv = v;
    for (int i = 0; i < 12; ++i) {
        vec2 cand;
        if (i < 8) {
            const ivec2 o8[8] = ivec2[](ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1),
                                        ivec2(1, 1), ivec2(-1, -1), ivec2(1, -1), ivec2(-1, 1));
            cand = v + vec2(o8[i]);
        } else {
            const ivec2 n4[4] = ivec2[](ivec2(4, 0), ivec2(-4, 0), ivec2(0, 4), ivec2(0, -4));
            const ivec2 q = clamp(c + n4[i - 8], ivec2(0), ivec2(size) - 1);
            const vec4 o = Fetch(q);
            if (!((o.z > 0.5 && o.z < 1.5) || o.z > 3.5) || any(isnan(o.xy)) || any(isinf(o.xy))) {
                continue;
            }
            cand = additive ? o.xy + imageLoad(mv_out, q).xy : o.xy;
        }
        const float e = PatchCost(c, cand, size);
        if (e < best) { best = e; bv = cand; }
    }
    const bool change = best < e0 * 0.85 - 0.002;
    if (change) atomicAdd(st.s[13], 1u);
    atomicAdd(st.s[14], uint(clamp(e0, 0.0, 4.0) * 1024.0));
    atomicAdd(st.s[15], uint(clamp(change ? best : e0, 0.0, 4.0) * 1024.0));
    return change ? bv : v;
}

void main() {
    const ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    const bool inside = c.x < int(p.size.x) && c.y < int(p.size.y);
    const uint flags = p.size.w;
    const bool additive = (flags & 2u) != 0u;
    // bb-native-mv2 (flags bit 5): skinned draws are class 4 and the player mask is them in the
    // centre (else: moving opaque pixels in the centre whose vector differs from the camera's).
    const bool characters = (flags & 32u) != 0u;
    const bool fog = (flags & 64u) != 0u;
    const bool fog_rx = (flags & 128u) != 0u;
    const bool keep = fog && (flags & 256u) != 0u;
    const bool sparks = (flags & 512u) != 0u;
    if ((flags & 1u) == 0u) {
        // Normal frame: replace the camera vector on object pixels (and, bb-fog-mv, under
        // blended draws with their own vector), nothing else.
        if (!inside || p.size.z == 0u) return;
        const vec4 o = Fetch(c);
        if (IsSpark(o, sparks, c)) {
            // bb-mv-fill: the effect's own static-world vector (not the surface behind it).
            if (!MarkOnly(o) && !any(isnan(o.xy)) && !any(isinf(o.xy))) {
                const vec2 camv = imageLoad(mv_out, c).xy;
                imageStore(mv_out, c, vec4(additive ? o.xy + camv : o.xy, 0.0, 0.0));
            }
            if ((flags & 4u) != 0u) {
                // bit 10: the marked area is under BB_FG_SPARKS_MAXPCT (else no HUD-less marking)
                imageStore(next_prev_color, c, vec4(texelFetch(cur_color, c, 0).rgb,
                                                    (flags & 1024u) != 0u ? 2.0 : 0.0));
            }
            return;
        }
        const float cov = fog ? clamp(o.w, 0.0, 1.0) : 0.0;
        const bool object = (o.z > 0.5 && o.z < 1.5) || o.z > 2.5;
        const bool fogged = cov > kFogMin;
        bool player = false;
        if (object || fogged) {
            if (!any(isnan(o.xy)) && !any(isinf(o.xy))) {
                const vec2 camv = imageLoad(mv_out, c).xy;
                const bool own = (o.z > 0.5 && o.z < 1.5) || o.z > 3.5;
                const bool kept = keep && fogged && own && cov <= kKeepMax;
                vec2 v = kept ? KeepObject(o, camv, cov, additive)
                              : (fogged ? FogVector(o, camv, cov) : o.xy);
                if (additive) v += camv;
                // Only what moves against the world (the player, not the tree behind it: static
                // scenery in the centre took refined vectors and deformed).
                // (bb-fog-mv: not under dense fog / smoke, whose vector is no longer the object's.)
                const bool candidate =
                    object && cov <= 0.5 && PlayerPixel(c, vec2(p.size.xy)) &&
                    (characters ? (o.z > 3.5 && o.z < 4.5)
                                : (o.z < 1.5 && length(v - camv) > 0.75));
                if (candidate && (characters || (flags & 16u) != 0u)) {
                    player = true;
                    atomicAdd(st.s[12], 1u);
                    if ((flags & 16u) != 0u) v = Refine(c, v, additive);
                }
                imageStore(mv_out, c, vec4(v, 0.0, 0.0));
                if (keep && fogged && own) {
                    KeepReactive(c, cov);
                } else if (fog_rx && fogged) {
                    FogReactive(c, cov);
                }
            }
        }
        if ((flags & 4u) != 0u) {
            // .a: the player mask (BB_FSR3_PLAYER_REAL reads it: the player from the real frame)
            imageStore(next_prev_color, c, vec4(texelFetch(cur_color, c, 0).rgb, player ? 1.0 : 0.0));
        }
        return;
    }
    // Statistics frame (1 in 60).
    if (gl_LocalInvocationIndex == 0u) {
        g_nz = 0u; g_obj = 0u; g_blend = 0u; g_all = 0u; g_chk = 0u;
        g_eo = 0u; g_ec = 0u; g_wo = 0u; g_wc = 0u; g_st = 0u; g_sa = 0u; g_sz = 0u;
        g_fp = 0u; g_fw = 0u; g_fd = 0u; g_fo = 0u; g_kk = 0u; g_kd = 0u; g_sp = 0u; g_ss = 0u;
    }
    barrier();
    if (inside) {
        atomicAdd(g_all, 1u);
        const vec4 o = Fetch(c);
        if (any(notEqual(o, vec4(0.0)))) atomicAdd(g_nz, 1u);
        const vec2 cam = imageLoad(mv_out, c).xy;
        const bool finite = !any(isnan(o.xy)) && !any(isinf(o.xy));
        const float cov = fog ? clamp(o.w, 0.0, 1.0) : 0.0;
        const bool spark = IsSpark(o, sparks, c);
        if (!spark && IsSparkRaw(o, sparks)) atomicAdd(g_ss, 1u);
        if (spark) {
            atomicAdd(g_sp, 1u);
            if (p.size.z != 0u && finite && !MarkOnly(o)) {
                imageStore(mv_out, c, vec4(additive ? o.xy + cam : o.xy, 0.0, 0.0));
            }
        } else if (cov > kFogMin) {
            atomicAdd(g_fp, 1u);
            atomicAdd(g_fw, uint(cov * 1024.0));
            if (cov > 0.5) atomicAdd(g_fd, 1u);
            if ((o.z > 0.5 && o.z < 1.5) || o.z > 3.5) atomicAdd(g_fo, 1u);
        }
        if (spark) {
            // bb-mv-fill: done above
        } else if (finite && cov > kFogMin && !((o.z > 0.5 && o.z < 1.5) || o.z > 2.5)) {
            // bb-fog-mv: blended draws over the camera vector (class 0) or a sampled static draw
            // (class 2: its statistics stay those of the draw).
            if (o.z > 1.5 && o.z < 2.5) {
                atomicAdd(g_st, 1u);
                atomicAdd(g_sa, uint(min(length(o.xy - cam), 64.0) * 16.0));
                atomicAdd(g_sz, uint(min(length(o.xy), 64.0) * 16.0));
            }
            if (p.size.z != 0u) {
                imageStore(mv_out, c, vec4(FogVector(o, cam, cov) + (additive ? cam : vec2(0.0)),
                                           0.0, 0.0));
                if (fog_rx) FogReactive(c, cov);
            }
        } else if (finite && o.z > 1.5 && o.z < 2.5) {
            // Static draw: its object vector must equal the camera vector (absolute mode) or
            // be ~0 (additive mode).
            atomicAdd(g_st, 1u);
            atomicAdd(g_sa, uint(min(length(o.xy - cam), 64.0) * 16.0));
            atomicAdd(g_sz, uint(min(length(o.xy), 64.0) * 16.0));
        } else if (finite && ((o.z > 0.5 && o.z < 1.5) || o.z > 2.5)) {
            const bool own = (o.z > 0.5 && o.z < 1.5) || o.z > 3.5;
            const bool fogged = cov > kFogMin;
            const bool kept = keep && fogged && own && cov <= kKeepMax;
            if (keep && fogged && own) {
                if (kept) atomicAdd(g_kk, 1u); else atomicAdd(g_kd, 1u);
            }
            const vec2 base = kept ? KeepObject(o, cam, cov, additive) : o.xy;
            const vec2 ov = additive ? base + cam : base;
            if (o.z > 2.5 && o.z < 3.5) atomicAdd(g_blend, 1u);
            atomicAdd(g_obj, 1u);
            if ((flags & 8u) != 0u && length(ov - cam) > 1.0) {
                const vec2 size = vec2(p.size.xy);
                const vec2 uv = (vec2(c) + 0.5) / size;
                const float cur = Luma(texelFetch(cur_color, c, 0).rgb);
                const float eo = abs(Luma(textureLod(prev_color, uv + ov / size, 0.0).rgb) - cur);
                const float ec = abs(Luma(textureLod(prev_color, uv + cam / size, 0.0).rgb) - cur);
                atomicAdd(g_chk, 1u);
                atomicAdd(g_eo, uint(clamp(eo, 0.0, 4.0) * 1024.0));
                atomicAdd(g_ec, uint(clamp(ec, 0.0, 4.0) * 1024.0));
                if (eo + 1e-3 < ec) atomicAdd(g_wo, 1u);
                else if (ec + 1e-3 < eo) atomicAdd(g_wc, 1u);
            }
            if (p.size.z != 0u) {
                imageStore(mv_out, c, vec4(ov, 0.0, 0.0)); // (fog already weighted into o.xy)
                if (keep && fogged && own) {
                    KeepReactive(c, cov);
                } else if (fog_rx && cov > kFogMin) {
                    FogReactive(c, cov);
                }
            }
        }
        if ((flags & 4u) != 0u) {
            const bool pl = !spark && finite && cov <= 0.5 && PlayerPixel(c, vec2(p.size.xy)) &&
                            (characters ? (o.z > 3.5 && o.z < 4.5)
                                        : (o.z > 0.5 && o.z < 1.5 &&
                                           length((additive ? o.xy + cam : o.xy) - cam) > 0.75));
            imageStore(next_prev_color, c,
                       vec4(texelFetch(cur_color, c, 0).rgb,
                            pl ? 1.0 : (spark && (flags & 1024u) != 0u ? 2.0 : 0.0)));
        }
    }
    barrier();
    if (gl_LocalInvocationIndex == 0u) {
        if (g_nz != 0u) atomicAdd(st.s[11], g_nz);
        if (g_obj != 0u) atomicAdd(st.s[0], g_obj);
        if (g_blend != 0u) atomicAdd(st.s[1], g_blend);
        atomicAdd(st.s[2], g_all);
        if (g_chk != 0u) {
            atomicAdd(st.s[3], g_chk);
            atomicAdd(st.s[4], g_eo);
            atomicAdd(st.s[5], g_ec);
            atomicAdd(st.s[6], g_wo);
            atomicAdd(st.s[7], g_wc);
        }
        if (g_fp != 0u) {
            atomicAdd(st.s[16], g_fp);
            atomicAdd(st.s[17], g_fw);
            atomicAdd(st.s[18], g_fd);
            atomicAdd(st.s[19], g_fo);
        }
        if (g_kk != 0u) atomicAdd(st.s[20], g_kk);
        if (g_sp != 0u) atomicAdd(st.s[22], g_sp);
        if (g_ss != 0u) atomicAdd(st.s[23], g_ss);
        if (g_kd != 0u) atomicAdd(st.s[21], g_kd);
        if (g_st != 0u) {
            atomicAdd(st.s[8], g_st);
            atomicAdd(st.s[9], g_sa);
            atomicAdd(st.s[10], g_sz);
        }
    }
}
