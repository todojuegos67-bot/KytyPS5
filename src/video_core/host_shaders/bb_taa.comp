// bb-clean-021-taa: temporal anti-aliasing at native resolution (BB_UPSCALER=taa).
// Current frame unjittered with a 3x3 Blackman-Harris reconstruction, history reprojected with the
// camera motion vectors (bb_mv.comp, render pixels towards the previous frame) and sampled with a
// 5-tap Catmull-Rom, clipped to the 3x3 YCoCg variance box, rejected on depth disocclusion, then
// blended with luminance-weighted feedback. Writes the new history and this frame's depth.
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D color_tex;   // nearest
layout(binding = 1) uniform sampler2D depth_tex;   // nearest
layout(binding = 2) uniform sampler2D motion_tex;  // nearest
layout(binding = 3) uniform sampler2D history_tex; // linear
layout(binding = 4) uniform sampler2D prev_depth_tex; // nearest
layout(binding = 5, rgba16f) uniform writeonly image2D history_out;
layout(binding = 6, r32f) uniform writeonly image2D depth_out;
layout(push_constant) uniform Push {
    uvec4 size;  // width, height, flags (1 reset, 2 camera valid, 4 depth greater-is-closer), 0
    vec4 params; // jitter x, jitter y, feedback, variance gamma
} p;

vec3 RGBToYCoCg(vec3 c) {
    return vec3(0.25 * c.r + 0.5 * c.g + 0.25 * c.b, 0.5 * c.r - 0.5 * c.b,
                -0.25 * c.r + 0.5 * c.g - 0.25 * c.b);
}
vec3 YCoCgToRGB(vec3 c) {
    return vec3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z);
}
float Luma(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}
float LinDepth(float d) {
    float x = (p.size.z & 4u) != 0u ? d : 1.0 - d;
    return 1.0 / max(x, 1e-7);
}

// 5-tap Catmull-Rom (bilinear taps), uv in [0,1].
vec3 SampleCatmullRom(vec2 uv, vec2 tex_size) {
    vec2 pos = uv * tex_size;
    vec2 c1 = floor(pos - 0.5) + 0.5;
    vec2 f = pos - c1;
    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);
    vec2 w12 = w1 + w2;
    vec2 tc12 = (c1 + w2 / w12) / tex_size;
    vec2 tc0 = (c1 - 1.0) / tex_size;
    vec2 tc3 = (c1 + 2.0) / tex_size;
    vec3 r = vec3(0.0);
    r += textureLod(history_tex, vec2(tc12.x, tc0.y), 0).rgb * (w12.x * w0.y);
    r += textureLod(history_tex, vec2(tc0.x, tc12.y), 0).rgb * (w0.x * w12.y);
    r += textureLod(history_tex, vec2(tc12.x, tc12.y), 0).rgb * (w12.x * w12.y);
    r += textureLod(history_tex, vec2(tc3.x, tc12.y), 0).rgb * (w3.x * w12.y);
    r += textureLod(history_tex, vec2(tc12.x, tc3.y), 0).rgb * (w12.x * w3.y);
    float wsum = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;
    return max(r / max(wsum, 1e-5), vec3(0.0));
}

// Clip `h` towards the centre of the box (Playdead / INSIDE).
vec3 ClipAABB(vec3 lo, vec3 hi, vec3 h) {
    vec3 c = 0.5 * (hi + lo);
    vec3 e = 0.5 * (hi - lo) + 1e-5;
    vec3 v = h - c;
    vec3 a = abs(v / e);
    float m = max(a.x, max(a.y, a.z));
    return m > 1.0 ? c + v / m : h;
}

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = ivec2(p.size.xy);
    if (c.x >= sz.x || c.y >= sz.y) {
        return;
    }
    vec2 tex_size = vec2(sz);
    vec2 jitter = p.params.xy;

    // 3x3: unjittered reconstruction, moments, nearest (closest) depth for the motion vector.
    vec3 sum = vec3(0.0);
    float wsum = 0.0;
    vec3 m1 = vec3(0.0), m2 = vec3(0.0);
    vec3 cmin = vec3(1e9), cmax = vec3(-1e9);
    bool greater = (p.size.z & 4u) != 0u;
    float best_d = greater ? -1.0 : 2.0;
    ivec2 best_c = c;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 q = clamp(c + ivec2(x, y), ivec2(0), sz - 1);
            vec3 rgb = max(texelFetch(color_tex, q, 0).rgb, vec3(0.0));
            vec3 ycc = RGBToYCoCg(rgb / (1.0 + Luma(rgb))); // tonemapped space: stable on HDR
            m1 += ycc;
            m2 += ycc * ycc;
            cmin = min(cmin, ycc);
            cmax = max(cmax, ycc);
            // The sample of pixel q lies at q + 0.5 - jitter (unjittered space).
            vec2 dlt = vec2(x, y) - jitter;
            float d2 = dot(dlt, dlt);
            float w = exp(-2.29 * d2); // Blackman-Harris fit, radius ~1
            sum += ycc * w;
            wsum += w;
            float d = texelFetch(depth_tex, q, 0).r;
            if (greater ? d > best_d : d < best_d) {
                best_d = d;
                best_c = q;
            }
        }
    }
    vec3 cur = sum / max(wsum, 1e-5);
    float depth_c = texelFetch(depth_tex, c, 0).r;
    imageStore(depth_out, c, vec4(depth_c, 0.0, 0.0, 0.0));

    bool reset = (p.size.z & 1u) != 0u;
    bool camera = (p.size.z & 2u) != 0u;
    if (reset) {
        vec3 rgb = YCoCgToRGB(cur);
        imageStore(history_out, c, vec4(rgb / max(1.0 - Luma(rgb), 1e-3), 1.0));
        return;
    }

    vec2 mv = camera ? texelFetch(motion_tex, best_c, 0).rg : vec2(0.0);
    vec2 prev_pos = vec2(c) + 0.5 + mv;
    vec2 prev_uv = prev_pos / tex_size;
    bool offscreen = any(lessThan(prev_uv, vec2(0.0))) || any(greaterThan(prev_uv, vec2(1.0)));

    vec3 hist_rgb = SampleCatmullRom(clamp(prev_uv, vec2(0.0), vec2(1.0)), tex_size);
    vec3 hist = RGBToYCoCg(hist_rgb / (1.0 + Luma(hist_rgb)));

    // Variance box (gamma: tighter without the camera, where the history is not reprojected).
    vec3 mu = m1 / 9.0;
    vec3 sigma = sqrt(max(m2 / 9.0 - mu * mu, vec3(0.0)));
    float gamma = p.params.w;
    vec3 lo = max(mu - gamma * sigma, cmin);
    vec3 hi = min(mu + gamma * sigma, cmax);
    hist = ClipAABB(lo, hi, hist);

    // Depth disocclusion: the previous depth nearest to the reprojected point (2x2) is much
    // farther / closer than this pixel's (linearised, relative).
    float alpha = p.params.z;
    if (offscreen) {
        alpha = 1.0;
    } else {
        ivec2 pq = ivec2(floor(prev_pos - 0.5));
        float lc = LinDepth(best_d);
        float diff = 1e9;
        for (int y = 0; y <= 1; ++y) {
            for (int x = 0; x <= 1; ++x) {
                ivec2 q = clamp(pq + ivec2(x, y), ivec2(0), sz - 1);
                float lp = LinDepth(texelFetch(prev_depth_tex, q, 0).r);
                diff = min(diff, abs(lp - lc) / max(min(lp, lc), 1e-6));
            }
        }
        float thr = camera ? 0.1 : 0.03;
        alpha = mix(alpha, 1.0, smoothstep(thr, thr * 3.0, diff));
        // Fast motion: trust the current frame a little more (less ghosting).
        alpha = mix(alpha, 0.35, clamp(length(mv) / 32.0, 0.0, 1.0) * float(alpha < 0.35));
    }

    // Luminance-weighted blend (Karis): avoids fireflies flickering in the history.
    float wc = alpha / (1.0 + cur.x);
    float wh = (1.0 - alpha) / (1.0 + hist.x);
    vec3 res = (cur * wc + hist * wh) / max(wc + wh, 1e-6);
    vec3 rgb = YCoCgToRGB(res);
    rgb = max(rgb, vec3(0.0));
    rgb = rgb / max(1.0 - Luma(rgb), 1e-3); // inverse of x / (1 + luma)
    if (any(isnan(rgb)) || any(isinf(rgb))) {
        rgb = texelFetch(color_tex, c, 0).rgb;
    }
    imageStore(history_out, c, vec4(rgb, 1.0));
}
