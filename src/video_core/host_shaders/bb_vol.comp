// Screen-space volumetric approximation (BB_VOL=1, bb_upscale.h): a distance haze that mixes the
// scene colour towards the sky colour with depth, and light shafts that march from each pixel
// towards the brightest sky region of the previous frame; the sky mask (far depth) occludes.
// The sky colour and sun position come from a reduction of this frame's image, read back a frame
// later (ping-pong buffers: 0 sky count, 1-3 sky colour sums, 4 bright count, 5-6 bright sums).
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D depth_tex;
layout(binding = 1) uniform sampler2D color_tex;
layout(binding = 2, rgba16f) uniform writeonly image2D color_out;
layout(std430, binding = 3) readonly buffer Prev {
    uint v[8];
}
prev;
layout(std430, binding = 4) buffer Cur {
    uint v[8];
}
cur;
layout(push_constant) uniform Push {
    uvec4 size; // width, height, depth inverted, 0
    vec4 planes; // near, far (0 = infinite), haze density, shaft gain
} p;

const int STEPS = 24;
const float SHAFT_REACH = 0.5;
const float DECAY = 0.92;
const float HAZE_MAX = 0.35;
const float BRIGHT = 0.85;
const float COLOR_SCALE = 64.0;
const float POS_SCALE = 2048.0;
const vec3 SUN_TINT = vec3(1.0, 0.93, 0.8);

float StandardDepth(float d) {
    return p.size.z != 0u ? 1.0 - d : d;
}

bool IsSky(float d) {
    return StandardDepth(d) >= 0.999999;
}

float LinearDistance(float d) {
    float n = p.planes.x;
    float ratio = p.planes.y > 0.0 ? n / p.planes.y : 0.0;
    return n / max(1.0 - StandardDepth(d) * (1.0 - ratio), 1e-6);
}

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (c.x >= int(p.size.x) || c.y >= int(p.size.y)) {
        return;
    }
    vec2 size = vec2(p.size.xy);
    vec2 uv = (vec2(c) + 0.5) / size;
    vec4 src = texelFetch(color_tex, c, 0);
    float d = texelFetch(depth_tex, c, 0).r;
    vec3 col = src.rgb;

    if (any(isnan(col)) || any(isinf(col))) {
        col = vec3(0.0);
    }
    if (c.x % 4 == 0 && c.y % 4 == 0) {
        if (IsSky(d)) {
            atomicAdd(cur.v[0], 1u);
            atomicAdd(cur.v[1], uint(clamp(col.r, 0.0, 4.0) * COLOR_SCALE));
            atomicAdd(cur.v[2], uint(clamp(col.g, 0.0, 4.0) * COLOR_SCALE));
            atomicAdd(cur.v[3], uint(clamp(col.b, 0.0, 4.0) * COLOR_SCALE));
            if (dot(col, vec3(0.2126, 0.7152, 0.0722)) > BRIGHT) {
                atomicAdd(cur.v[4], 1u);
                atomicAdd(cur.v[5], uint(uv.x * POS_SCALE));
                atomicAdd(cur.v[6], uint(uv.y * POS_SCALE));
            }
        }
    }

    bool sky_known = prev.v[0] > 0u;
    vec3 sky = sky_known ? vec3(prev.v[1], prev.v[2], prev.v[3]) / (float(prev.v[0]) * COLOR_SCALE)
                         : vec3(0.0);
    float haze = 0.0;
    if (sky_known && !IsSky(d)) {
        float far = p.planes.y > 0.0 ? p.planes.y : 10000.0 * p.planes.x;
        float t = LinearDistance(d) / far;
        haze = min(HAZE_MAX, 1.0 - exp(-p.planes.z * t));
        col = mix(col, sky, haze);
    }

    if (prev.v[4] > 0u) {
        vec2 sun = vec2(prev.v[5], prev.v[6]) / (float(prev.v[4]) * POS_SCALE);
        vec2 stride = (sun - uv) * (SHAFT_REACH / float(STEPS));
        vec2 q = uv;
        float w = 1.0;
        float lit = 0.0;
        for (int i = 0; i < STEPS; ++i) {
            q += stride;
            float sd = textureLod(depth_tex, clamp(q, vec2(0.0), vec2(1.0)), 0.0).r;
            lit += (IsSky(sd) ? 1.0 : 0.0) * w;
            w *= DECAY;
        }
        col += lit / float(STEPS) * p.planes.w * SUN_TINT;
    }

    imageStore(color_out, c, vec4(col, src.a));
}
