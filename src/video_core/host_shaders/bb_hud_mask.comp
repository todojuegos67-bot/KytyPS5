// bb-clean: the HUD of the presented frame as a separate UI layer for frame generation
// (premultiplied RGBA8, output size). HUD pixels: where the finished frame differs from the
// HUD-less copy taken at the HUD cut (dilated 1 px for anti-aliased edges) and, as a fallback that
// needs no HUD detection, pixels identical to the previous real frame (a still HUD over a moving
// world). The UI layer is drawn over every generated frame (DLSS-G: bb_hud_over.comp; FSR 3: its
// registered UI resource), so the HUD is never interpolated with the scene's motion vectors.
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D frame_tex;
layout(binding = 1) uniform sampler2D hudless_tex;
layout(binding = 2) uniform sampler2D prev_tex;
layout(binding = 3, rgba8) uniform writeonly image2D ui_out;
layout(push_constant) uniform Push {
    uvec4 size; // width, height, flags: bit 0 HUD-less valid, bit 1 previous frame valid
} p;

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    ivec2 last = ivec2(p.size.xy) - 1;
    if (c.x > last.x || c.y > last.y) {
        return;
    }
    vec3 f = texelFetch(frame_tex, c, 0).rgb;
    float m = 0.0;
    if ((p.size.z & 1u) != 0u) {
        for (int y = -1; y <= 1; ++y) {
            for (int x = -1; x <= 1; ++x) {
                ivec2 q = clamp(c + ivec2(x, y), ivec2(0), last);
                vec3 d = abs(texelFetch(frame_tex, q, 0).rgb - texelFetch(hudless_tex, q, 0).rgb);
                if (max(d.r, max(d.g, d.b)) > 3.0 / 255.0) {
                    m = 1.0;
                }
            }
        }
    }
    if (m == 0.0 && (p.size.z & 2u) != 0u) {
        vec3 d = abs(f - texelFetch(prev_tex, c, 0).rgb);
        if (max(d.r, max(d.g, d.b)) <= 0.5 / 255.0) {
            m = 1.0;
        }
    }
    imageStore(ui_out, c, vec4(f * m, m));
}
