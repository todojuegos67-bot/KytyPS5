// BB object motion vectors (bb_objmv.h): where the G-buffer pass wrote an object vector (skinned
// characters, weapons, animated props: the vertex shader's own previous / current clip positions),
// it replaces the camera-only vector bb_mv.comp reconstructed from depth. Same units and sign:
// render pixels towards the previous position, unjittered (the jitter is a viewport offset that
// clip positions never see).
// 1.20: o.y is the class (1: small skeleton / rigid, 2: large skeleton = characters).
// p.size.w bit 0: BB_OBJMV_DEBUG statistics (stats buffer); bit 1: BB_MV_VIEW colour (viz).
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0, rg32ui) uniform readonly uimage2D obj_mv;
layout(binding = 1, rg16f) uniform image2D mv_out;
layout(binding = 2, std430) buffer Stats {
    uint s[16];
} st;
layout(binding = 3, rgba8) uniform writeonly image2D viz;
layout(push_constant) uniform Push {
    uvec4 size; // width, height, enabled, flags
} p;

void Count(uint i, float v) {
    atomicAdd(st.s[i], uint(clamp(v, 0.0, 4096.0) * 16.0 + 0.5));
}

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (c.x >= int(p.size.x) || c.y >= int(p.size.y) || p.size.z == 0u) {
        return;
    }
    vec2 cam = imageLoad(mv_out, c).xy;
    uvec2 o = imageLoad(obj_mv, c).xy;
    vec2 v = cam;
    bool obj = false;
    if (o.y != 0u) {
        vec2 ov = unpackHalf2x16(o.x);
        if (!any(isnan(ov)) && !any(isinf(ov))) {
            v = ov;
            obj = true;
            imageStore(mv_out, c, vec4(v, 0.0, 0.0));
        }
    }
    if ((p.size.w & 1u) != 0u) {
        if (obj && o.y >= 2u) {
            // Character (large skeleton) pixels: object vs camera magnitude here.
            atomicAdd(st.s[0], 1u);
            Count(1u, length(v));
            Count(2u, length(cam));
            if (length(v - cam) > 1.0) atomicAdd(st.s[3], 1u);
            atomicMax(st.s[4], uint(clamp(length(v), 0.0, 4096.0) * 16.0));
            if (length(v) < 0.25) atomicAdd(st.s[5], 1u);
        } else if (obj) {
            atomicAdd(st.s[6], 1u);
            Count(7u, length(v));
            Count(8u, length(cam));
        } else {
            atomicAdd(st.s[9], 1u);
            Count(10u, length(cam));
        }
    }
    if ((p.size.w & 2u) != 0u) {
        // Hue = direction, brightness = magnitude (8 px full); object pixels with a tint (blue:
        // characters, magenta: props) so their area shows even when not moving.
        float m = clamp(length(v) / 8.0, 0.0, 1.0);
        vec2 d = length(v) > 1e-4 ? normalize(v) : vec2(0.0);
        vec3 col = vec3(0.5 + 0.5 * d.x, 0.5 + 0.5 * d.y, 0.5) * m;
        if (obj) col += o.y >= 2u ? vec3(0.0, 0.0, 0.35) : vec3(0.25, 0.0, 0.25);
        imageStore(viz, c, vec4(clamp(col, 0.0, 1.0), 1.0));
    }
}
