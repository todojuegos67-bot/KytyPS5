// bb-hud-layer: the game's in-game HUD layer (drawn by the UI-movie shaders into its own target,
// composited over the scene by a post pass) drawn over the upscaled scene at the output's pixels.
// The post pass ran with a transparent layer (the upscaler saw no HUD); this puts the HUD back.
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D scene_tex; // the upscaled scene (output size)
layout(binding = 1) uniform sampler2D hud_tex;   // the HUD layer (any size, filtered)
layout(binding = 2, rgba8) uniform writeonly image2D out_img;
layout(push_constant) uniform Push {
    uvec4 p; // width, height, flags: bit 0 straight alpha, bit 1 layer read linear (sRGB view)
} pc;

vec3 Encode(vec3 c) {
    c = clamp(c, 0.0, 1.0);
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
}

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (c.x >= int(pc.p.x) || c.y >= int(pc.p.y)) {
        return;
    }
    vec4 s = texelFetch(scene_tex, c, 0);
    vec2 uv = (vec2(c) + 0.5) / vec2(pc.p.xy);
    vec4 h = textureLod(hud_tex, uv, 0.0);
    float a = clamp(h.a, 0.0, 1.0);
    vec3 rgb = (pc.p.z & 2u) != 0u ? Encode(h.rgb) : clamp(h.rgb, 0.0, 1.0);
    if ((pc.p.z & 1u) != 0u) {
        rgb *= a;
    }
    imageStore(out_img, c, vec4(s.rgb * (1.0 - a) + rgb, s.a));
}
