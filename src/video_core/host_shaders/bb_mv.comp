// bb-clean-021: camera motion vectors from the scene depth (one pass, static geometry only), and
// the presented image copied into RGBA16F linear for the upscaler.
// Each pixel's surface point, unprojected with the scene viewport and moved into the previous
// frame's clip space (clip_to_prev = prevViewProj * inverse(viewProj)) gives render pixels towards
// its previous position. Unjittered: the jitter the scene was drawn with is taken out first.
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D depth_tex;
layout(binding = 1, rg16f) uniform writeonly image2D mv_out;
layout(binding = 2) uniform sampler2D color_tex;
layout(binding = 3, rgba16f) uniform writeonly image2D color_out;
// bb-hudmv: the presented image with the HUD (the scene copy is color_tex when the HUD split is on).
layout(binding = 4) uniform sampler2D full_tex;
layout(push_constant) uniform Push {
    vec4 r0;
    vec4 r1;
    vec4 r2;
    vec4 r3;
    vec4 vp_xy; // xscale, xoffset, yscale, yoffset
    vec4 vp_z;  // zscale, zoffset, jitter x, jitter y
    uvec4 size; // width, height, camera valid, flags: bit 0 decode sRGB, bit 1 HUD mask
} p;

vec3 SrgbToLinear(vec3 c) {
    return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), greaterThan(c, vec3(0.04045)));
}

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (c.x >= int(p.size.x) || c.y >= int(p.size.y)) {
        return;
    }
    vec3 col = texelFetch(color_tex, c, 0).rgb;
    if ((p.size.w & 1u) != 0u) {
        col = SrgbToLinear(clamp(col, 0.0, 1.0));
    }
    imageStore(color_out, c, vec4(col, 1.0));

    // HUD (bb-hudmv): the presented image differs from the scene copy at a 3x3 neighbourhood of
    // this pixel. The HUD is fixed on screen: zero motion (no camera vector from the scene depth
    // behind the text, which made the frame generator move the letters).
    if ((p.size.w & 2u) != 0u) {
        bool hud = false;
        for (int dy = -1; dy <= 1 && !hud; ++dy) {
            for (int dx = -1; dx <= 1 && !hud; ++dx) {
                ivec2 q = clamp(c + ivec2(dx, dy), ivec2(0), ivec2(int(p.size.x) - 1, int(p.size.y) - 1));
                vec3 dif = abs(texelFetch(full_tex, q, 0).rgb - texelFetch(color_tex, q, 0).rgb);
                hud = max(dif.r, max(dif.g, dif.b)) > 0.02;
            }
        }
        if (hud) {
            imageStore(mv_out, c, vec4(0.0, 0.0, 0.0, 0.0));
            return;
        }
    }
    vec2 mv = vec2(0.0);
    if (p.size.z != 0u) {
        float d = texelFetch(depth_tex, c, 0).r;
        vec2 s = vec2(c) + 0.5 - p.vp_z.zw;
        vec4 ndc = vec4((s.x - p.vp_xy.y) / p.vp_xy.x, (s.y - p.vp_xy.w) / p.vp_xy.z,
                        (d - p.vp_z.y) / p.vp_z.x, 1.0);
        vec4 prev = vec4(dot(p.r0, ndc), dot(p.r1, ndc), dot(p.r2, ndc), dot(p.r3, ndc));
        if (abs(prev.w) > 1e-6) {
            prev.xy /= prev.w;
            vec2 ps = vec2(prev.x * p.vp_xy.x + p.vp_xy.y, prev.y * p.vp_xy.z + p.vp_xy.w);
            mv = ps - s;
            if (any(isnan(mv)) || any(isinf(mv))) {
                mv = vec2(0.0);
            }
        }
    }
    imageStore(mv_out, c, vec4(mv, 0.0, 0.0));
}
