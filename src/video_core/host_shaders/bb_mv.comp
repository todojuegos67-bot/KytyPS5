// bb-clean-021: camera motion vectors from the scene depth (one pass, static geometry only), and
// the presented image copied into RGBA16F linear for the upscaler.
// The camera vectors use the formula of Supermedo's Bloodborne port (camera_motion.comp).
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D depth_tex;
layout(binding = 1, rg16f) uniform writeonly image2D mv_out;
layout(binding = 2) uniform sampler2D color_tex;
layout(binding = 3, rgba16f) uniform writeonly image2D color_out;
layout(push_constant) uniform Push {
    vec4 r0;
    vec4 r1;
    vec4 r2;
    vec4 r3;
    vec4 vp_xy; // previous projection: x scale, y scale, z scale, z offset
    vec4 vp_z;  // (unused), (unused), jitter x, jitter y
    uvec4 size; // width, height, camera valid, flags: bit 0 decode sRGB
} p;

vec3 SrgbToLinear(vec3 c) {
    return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), greaterThan(c, vec3(0.04045)));
}

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (c.x >= int(p.size.x) || c.y >= int(p.size.y)) {
        return;
    }
    vec3 col = texelFetch(color_tex, c, 0).rgb;
    if ((p.size.w & 1u) != 0u) {
        col = SrgbToLinear(clamp(col, 0.0, 1.0));
    }
    imageStore(color_out, c, vec4(col, 1.0));

    // bb-clean-021-bbport: Supermedo's camera_motion.comp (GPL-2.0-or-later): r0..r2 = previous
    // view * inverse current view (3x4 rows), r3 = current projection (x, y, z scale, z offset),
    // vp_xy = previous projection, vp_z.zw = the jitter (render pixels, x right, y down).
    vec2 mv = vec2(0.0);
    if (p.size.z != 0u) {
        const vec2 size = vec2(p.size.xy);
        const vec4 proj = p.r3;
        const vec4 prev_proj = p.vp_xy;
        const float depth = texelFetch(depth_tex, c, 0).r;
        const vec2 uv = (vec2(c) + 0.5) / size;
        const vec2 scene_uv = uv - p.vp_z.zw / size;
        const vec2 ndc = vec2(scene_uv.x * 2.0 - 1.0, 1.0 - scene_uv.y * 2.0);
        // Clip z = zs * z + zo, w = z; depth = zs + zo / z (zo < 0, depth < zs in front).
        const bool sky = depth >= 1.0;
        const float denom = min(depth - proj.z, -1e-8);
        const float z = sky ? 1.0 : proj.w / denom;
        // Clear depth is an infinite direction: rotated with the camera, without translation.
        const vec4 view = vec4(ndc.x * z / proj.x, ndc.y * z / proj.y, z, sky ? 0.0 : 1.0);
        const vec3 prev_view = vec3(dot(p.r0, view), dot(p.r1, view), dot(p.r2, view));
        const vec2 prev_ndc =
            vec2(prev_view.x * prev_proj.x, prev_view.y * prev_proj.y) / max(prev_view.z, 1e-4);
        const vec2 prev_uv = vec2(prev_ndc.x * 0.5 + 0.5, 0.5 - prev_ndc.y * 0.5);
        mv = (prev_uv - scene_uv) * size;
        if (any(isnan(mv)) || any(isinf(mv))) {
            mv = vec2(0.0);
        }
    }
    imageStore(mv_out, c, vec4(mv, 0.0, 0.0));
}
