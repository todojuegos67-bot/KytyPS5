// bb-rt-reflect (BB_RT_REFLECT=1): denoise, upsample and composite of the ray-traced reflections.
// All colours are premultiplied by the blend weight a and compressed (c / (1 + luma c)).
//   mode 0  temporal (trace size): glossy pixels reproject their surface, mirrors (water, puddles)
//           the virtual image behind the mirror (view ray at the hit distance), so a reflection
//           does not smear when the camera moves. History is accepted only where the previous
//           frame saw the same surface (class, distance, normal) and is clipped to this frame's
//           3x3 neighbourhood (mean +- k sigma within min / max): no ghosting, no stale flashes.
//   mode 1  edge-aware a-trous step (push step 1 / 2) on glossy pixels only; mirrors stay sharp.
//   mode 2  (render size) depth-aware upsample (4 taps, bilinear x distance agreement) and blend
//           into the HDR scene: c = mix(scene, reflection, a). Debug views 5 class mask, 6
//           reflection only, 7 blend weight.
#version 460
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src_tex;    // this frame's input (texelFetch)
layout(binding = 1) uniform sampler2D hist_tex;   // previous accumulated result (linear)
layout(binding = 2) uniform sampler2D guide_tex;  // this frame's guide
layout(binding = 3) uniform sampler2D pguide_tex; // previous frame's guide
layout(binding = 4, rgba16f) uniform writeonly image2D dst;
layout(std140, binding = 5) uniform Params {
    mat4 proj;
    mat4 inv_proj;
    mat4 view;
    mat4 reproj;
    mat4 prev_proj;
    uvec4 size;
    vec4 misc;
    vec4 misc2;
    vec4 misc3;
    vec4 misc4;
    vec4 misc5;
    vec4 misc6;
    mat4 inv_view;
} p;
layout(std430, binding = 6) buffer Counters { uint n[24]; } cnt;
layout(binding = 7) uniform sampler2D depth_tex;            // final scene depth (mode 2)
#ifdef HDR_R11
// The game's HDR target is B10G11R11_UFLOAT (Bloodborne: composite target 0x2709f0000): written
// through an R32UI view of that (mutable-format) image, packed / unpacked here, because storage
// support for B10G11R11 itself is optional.
layout(binding = 8, r32ui) uniform uimage2D hdr;
vec3 UnpackR11(uint v) {
    // 11-bit / 10-bit unsigned floats = the top bits of a half (5-bit exponent, bias 15).
    vec2 rg = unpackHalf2x16(((v & 0x7FFu) << 4) | (((v >> 11) & 0x7FFu) << 20));
    float b = unpackHalf2x16(((v >> 22) & 0x3FFu) << 5).x;
    return vec3(rg, b);
}
uint PackUf(float x, uint drop, uint maxv) {
    x = isnan(x) ? 0.0 : clamp(x, 0.0, 65000.0);
    uint hb = packHalf2x16(vec2(x, 0.0)) & 0x7FFFu;
    return min((hb + (1u << (drop - 1u))) >> drop, maxv);
}
uint PackR11(vec3 c) {
    return PackUf(c.r, 4u, 0x7BFu) | (PackUf(c.g, 4u, 0x7BFu) << 11) |
           (PackUf(c.b, 5u, 0x3DFu) << 22);
}
vec4 LoadHdr(ivec2 c) { return vec4(UnpackR11(imageLoad(hdr, c).r), 1.0); }
void StoreHdr(ivec2 c, vec4 v) { imageStore(hdr, c, uvec4(PackR11(v.rgb))); }
#else
layout(binding = 8, rgba16f) uniform image2D hdr;           // HDR scene (mode 2, in place)
vec4 LoadHdr(ivec2 c) { return imageLoad(hdr, c); }
void StoreHdr(ivec2 c, vec4 v) { imageStore(hdr, c, v); }
#endif
layout(push_constant) uniform Push { uint mode; uint step; } pc;

shared uint s_ok;

ivec2 TS() { return ivec2(p.misc6.zw); }

vec3 OctDecode(vec2 o) {
    vec3 n = vec3(o, 1.0 - abs(o.x) - abs(o.y));
    if (n.z < 0.0) {
        n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    }
    return normalize(n);
}
uint GClass(vec4 g) { return uint(clamp(floor(g.x * 0.25 + 0.5), 0.0, 3.0)); }
vec3 GNormal(vec4 g) { return OctDecode(vec2(g.x - 4.0 * float(GClass(g)), g.y)); }
float GRough(vec4 g) { return g.w < 0.0 ? -g.w : 0.0; }

vec3 ViewDir(vec2 uv) {
    vec4 ndc = vec4(uv.x * 2.0 - 1.0, p.misc.y > 0.0 ? 1.0 - 2.0 * uv.y : 2.0 * uv.y - 1.0, 0.5, 1.0);
    vec4 v = p.inv_proj * ndc;
    return normalize(v.xyz / v.w);
}

vec2 PrevUv(vec3 Pv, out bool on, out vec3 Q) {
    Q = (p.reproj * vec4(Pv, 1.0)).xyz;
    vec4 clip = p.prev_proj * vec4(Q, 1.0);
    on = clip.w > 1e-6;
    vec2 ndc = clip.xy / (on ? clip.w : 1.0);
    vec2 uv = vec2(ndc.x * 0.5 + 0.5, p.misc.y > 0.0 ? 0.5 - 0.5 * ndc.y : 0.5 + 0.5 * ndc.y);
    on = on && all(greaterThan(uv, vec2(0.0))) && all(lessThan(uv, vec2(1.0)));
    return uv;
}

vec3 Decompress(vec3 c) {
    float l = min(dot(c, vec3(0.2126, 0.7152, 0.0722)), 0.98);
    return c / (1.0 - l);
}

void Temporal(ivec2 c, ivec2 sz) {
    vec4 g = texelFetch(guide_tex, c, 0);
    vec4 cur = texelFetch(src_tex, c, 0);
    uint cls = GClass(g);
    if (g.z <= 0.0 || cls == 0u || p.misc2.x < 0.5) {
        imageStore(dst, c, cur);
        return;
    }
    vec4 m1 = vec4(0.0), m2 = vec4(0.0), mn = vec4(1e9), mx = vec4(-1e9);
    float nw = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 q = clamp(c + ivec2(x, y), ivec2(0), sz - 1);
            if (GClass(texelFetch(guide_tex, q, 0)) != cls) {
                continue;
            }
            vec4 s = texelFetch(src_tex, q, 0);
            m1 += s;
            m2 += s * s;
            mn = min(mn, s);
            mx = max(mx, s);
            nw += 1.0;
        }
    }
    m1 /= nw;
    vec4 sigma = sqrt(max(m2 / nw - m1 * m1, vec4(0.0)));
    const bool mirror = cls != 3u;
    vec2 uv = (vec2(c) + 0.5) / vec2(sz);
    vec3 dir = ViewDir(uv);
    bool on_s;
    vec3 Qs;
    vec2 uv_s = PrevUv(dir * g.z, on_s, Qs);
    vec4 outv = cur;
    if (on_s) {
        vec4 pg = texelFetch(pguide_tex, clamp(ivec2(uv_s * vec2(sz)), ivec2(0), sz - 1), 0);
        float qd = length(Qs);
        vec3 nprev = mat3(p.reproj) * GNormal(g);
        bool same = pg.z > 0.0 && GClass(pg) == cls && abs(pg.z - qd) < 0.03 * qd + 0.05 &&
                    dot(GNormal(pg), nprev) > (mirror ? 0.8 : 0.9);
        vec2 uv_h = uv_s;
        bool on_h = true;
        if (same && mirror && g.w > 0.0) {
            vec3 Qv;
            uv_h = PrevUv(dir * g.w, on_h, Qv);
        }
        if (same && on_h) {
            vec4 h = textureLod(hist_tex, uv_h, 0.0);
            float k = mirror ? 1.0 : 1.25;
            h = clamp(h, max(mn, m1 - k * sigma), min(mx, m1 + k * sigma));
            if (!any(isnan(h)) && !any(isinf(h))) {
                float blend = mirror ? p.misc3.y : p.misc3.x;
                outv = mix(h, cur, blend);
                atomicAdd(s_ok, 1u);
            }
        }
    }
    imageStore(dst, c, outv);
}

void Spatial(ivec2 c, ivec2 sz) {
    vec4 g = texelFetch(guide_tex, c, 0);
    vec4 cur = texelFetch(src_tex, c, 0);
    uint cls = GClass(g);
    if (g.z <= 0.0 || cls != 3u) {
        imageStore(dst, c, cur);
        return;
    }
    const int step = int(max(pc.step, 1u));
    float spread = clamp(GRough(g) * 4.0, 0.0, 1.0) * p.misc3.z;
    vec3 n0 = GNormal(g);
    vec4 sum = cur;
    float wsum = 1.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            if (x == 0 && y == 0) continue;
            ivec2 q = c + ivec2(x, y) * step;
            if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, sz))) continue;
            vec4 gq = texelFetch(guide_tex, q, 0);
            if (gq.z <= 0.0 || GClass(gq) != 3u) continue;
            float k = (x == 0 || y == 0) ? 0.5 : 0.25;
            float wd = exp(-abs(gq.z - g.z) / (0.02 * g.z + 0.01));
            float wn = pow(max(dot(GNormal(gq), n0), 0.0), 32.0);
            float w = k * wd * wn * spread;
            sum += texelFetch(src_tex, q, 0) * w;
            wsum += w;
        }
    }
    imageStore(dst, c, sum / wsum);
}

void Composite(ivec2 c) {
    ivec2 hsz = imageSize(hdr);
    if (any(greaterThanEqual(c, hsz))) {
        return;
    }
    ivec2 sz = TS();
    vec2 uv = (vec2(c) + 0.5) / vec2(hsz);
    ivec2 dsz = textureSize(depth_tex, 0);
    float d = texelFetch(depth_tex, clamp(ivec2(uv * vec2(dsz)), ivec2(0), dsz - 1), 0).r;
    vec4 ndc = vec4(uv.x * 2.0 - 1.0, p.misc.y > 0.0 ? 1.0 - 2.0 * uv.y : 2.0 * uv.y - 1.0, d, 1.0);
    vec4 v = p.inv_proj * ndc;
    float dist = length(v.xyz / v.w);
    if (!(dist < p.misc.x * 0.95) || isnan(dist)) {
        return;
    }
    vec2 tc = uv * vec2(sz) - 0.5;
    ivec2 b = ivec2(floor(tc));
    vec2 f = tc - vec2(b);
    vec4 acc = vec4(0.0);
    float wacc = 0.0, best = 1e9;
    vec4 nearest = vec4(0.0);
    uint ncls = 0u;
    for (int i = 0; i < 4; ++i) {
        ivec2 o = ivec2(i & 1, i >> 1);
        ivec2 q = clamp(b + o, ivec2(0), sz - 1);
        vec4 gq = texelFetch(guide_tex, q, 0);
        if (gq.z <= 0.0) continue;
        float rel = abs(gq.z - dist) / (0.02 * dist + 0.02);
        float wb = (o.x == 1 ? f.x : 1.0 - f.x) * (o.y == 1 ? f.y : 1.0 - f.y);
        float w = wb * exp(-rel * rel);
        vec4 s = texelFetch(src_tex, q, 0);
        acc += s * w;
        wacc += w;
        if (rel < best) {
            best = rel;
            nearest = s;
            ncls = GClass(gq);
        }
    }
    vec4 r = wacc > 1e-3 ? acc / wacc : (best < 2.0 ? nearest : vec4(0.0));
    uint dbg = uint(p.misc.w + 0.5);
    if (r.a < 0.002 && dbg < 5u) {
        return;
    }
    vec4 scene = LoadHdr(c);
    vec3 refl = r.a > 1e-4 ? Decompress(r.rgb / r.a) : vec3(0.0);
    float a = clamp(r.a, 0.0, 0.95);
    vec3 o = mix(scene.rgb, refl, a);
    if (dbg == 5u) {
        vec3 tint = ncls == 1u ? vec3(0.1, 0.35, 1.0) : ncls == 2u ? vec3(0.0, 1.0, 1.0)
                  : ncls == 3u ? vec3(1.0, 0.0, 1.0) : vec3(0.0);
        float l = dot(scene.rgb, vec3(0.2126, 0.7152, 0.0722));
        o = ncls != 0u ? mix(vec3(l), tint * max(l, 0.05) * 3.0, 0.4 + 0.6 * clamp(a * 2.0, 0.0, 1.0))
                       : vec3(l * 0.5);
    } else if (dbg == 6u) {
        o = refl;
    } else if (dbg == 7u) {
        o = vec3(a);
    }
    if (any(isnan(o)) || any(isinf(o))) {
        return;
    }
    StoreHdr(c, vec4(o, scene.a));
}

void main() {
    if (gl_LocalInvocationIndex == 0u) {
        s_ok = 0u;
    }
    barrier();
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = TS();
    if (pc.mode == 2u) {
        Composite(c);
    } else if (all(lessThan(c, sz))) {
        if (pc.mode == 0u) {
            Temporal(c, sz);
        } else {
            Spatial(c, sz);
        }
    }
    barrier();
    if (gl_LocalInvocationIndex == 0u && pc.mode == 0u && s_ok != 0u) {
        atomicAdd(cnt.n[9], s_ok);
    }
}
