#version 450
// KYTY_KBM_WARP (kbm-warp.cpp): late reprojection of the pending mouse turn, the HUD left where it is.
// The 3D is sampled from a source rectangle `rect` (UV origin xy, UV size zw): the pending turn moves it, and a small
// smoothed zoom (rect smaller than the image) keeps it inside the image, so no edge strip is ever uncovered (before
// (10-24) the uncovered strip repeated the edge pixels and flickered as the shift changed every frame).
// mode 0 (color): `a` the game's final image F (HUD composited), `b` the same composite drawn without its HUD texture H,
//   both at the output's size. The HUD is where F and H differ (as hud-split.comp finds it); there F is kept, unmoved,
//   elsewhere H is sampled through `rect`. out0 = that, out1 = the warped H alone (FSR 3's HUD-less input).
// mode 1 (motion): `a` the motion vectors (UV; vector * mv_sign = UV offset to the previous position). out0 = the
//   vectors of the warped image: the source point's previous position mapped through the previous real frame's `prev`.
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D a;
layout(binding = 1) uniform sampler2D b;
layout(binding = 2, rgba16f) uniform writeonly image2D out0;
layout(binding = 3, rgba16f) uniform writeonly image2D out1;

layout(push_constant) uniform Push {
	vec4  rect;      // this frame's source rectangle (UV)
	vec4  prev;      // mode 1: the previous real frame's
	float threshold; // mode 0: a difference above it (any channel) is HUD
	int   radius;    // mode 0: the HUD's edges widened by it (pixels)
	int   mode;
	int   write1;    // mode 0: out1 written too (a separate image)
	float mv_sign;   // mode 1
	float pad0;
	float pad1;
	float pad2;
} push;

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size  = imageSize(out0);
	if (pixel.x >= size.x || pixel.y >= size.y) return;
	vec2 here = (vec2(pixel) + 0.5) / vec2(size);
	vec2 uv   = clamp(push.rect.xy + here * push.rect.zw, vec2(0.0), vec2(1.0));
	if (push.mode == 1) {
		ivec2 msize = textureSize(a, 0);
		ivec2 at    = clamp(ivec2(floor(uv * vec2(msize))), ivec2(0), msize - 1);
		vec4  mv    = texelFetch(a, at, 0);
		vec2  then  = uv + mv.xy * push.mv_sign;           // the point's previous source position
		vec2  shown = (then - push.prev.xy) / push.prev.zw; // where the previous warped frame showed it
		imageStore(out0, pixel, vec4((shown - here) / push.mv_sign, mv.zw));
		return;
	}
	ivec2 source     = textureSize(a, 0);
	float difference = 0.0;
	for (int dy = -push.radius; dy <= push.radius; ++dy) {
		for (int dx = -push.radius; dx <= push.radius; ++dx) {
			ivec2 at = clamp(pixel + ivec2(dx, dy), ivec2(0), source - 1);
			vec3  d  = abs(texelFetch(a, at, 0).rgb - texelFetch(b, at, 0).rgb);
			difference = max(difference, max(d.r, max(d.g, d.b)));
		}
	}
	float coverage = smoothstep(push.threshold, push.threshold * 2.0, difference);
	vec4  moved    = textureLod(b, uv, 0.0);
	vec4  frame    = texelFetch(a, clamp(pixel, ivec2(0), source - 1), 0);
	imageStore(out0, pixel, vec4(mix(moved.rgb, frame.rgb, coverage), 1.0));
	if (push.write1 != 0) imageStore(out1, pixel, vec4(moved.rgb, 1.0));
}
