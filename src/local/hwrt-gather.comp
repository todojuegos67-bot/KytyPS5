#version 460
// KYTY_HWRT (hwrt-scene.cpp): one captured mesh's clip-space vertices (the game's gl_Position, stored by its patched
// vertex shader) to world space through the inverse view-projection. Mode 0 writes the mesh's BLAS vertex buffer;
// mode 1 compares with it (the largest move, relative to 5 cm + 0.2 % of the distance to the camera, into a result).
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 256) in;
layout(buffer_reference, std430, buffer_reference_align = 16) buffer Vec4s { vec4 v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Uints { uint u[]; };
layout(push_constant) uniform Push {
	vec4     r0, r1, r2, r3; // clip -> world rows
	vec4     cam;
	uint     src_base, count, mode, result;
	uint64_t src, dst, results;
} p;

void main() {
	const uint i = gl_GlobalInvocationID.x;
	if (i >= p.count) return;
	const vec4 c = Vec4s(p.src).v[p.src_base + i];
	const vec4 h = vec4(dot(p.r0, c), dot(p.r1, c), dot(p.r2, c), dot(p.r3, c));
	vec3       w = vec3(uintBitsToFloat(0x7fc00000u)); // (NaN: an inactive triangle)
	const bool ok = abs(h.w) > 1e-20 && !any(isnan(c)) && !any(isinf(c));
	if (ok) w = h.xyz / h.w;
	if (p.mode == 0u) {
		Vec4s(p.dst).v[i] = vec4(w, 1.0);
		return;
	}
	const vec3 old = Vec4s(p.dst).v[i].xyz;
	if (!ok || any(isnan(old)) || any(isnan(w))) return;
	const float d = length(w - old) / (0.05 + 0.002 * length(old - p.cam.xyz));
	atomicMax(Uints(p.results).u[p.result], floatBitsToUint(min(d, 1e30)));
}
