#version 450
// KYTY_UPSCALE_SHARPNESS=<0..1> (frame-gen.cpp, UpscaleComposite): sharpening after DLSS or XeSS (FSR has its own,
// RCAS). An unsharp mask on the 4 neighbours in a tonemapped space (HDR values would make it ring), its result held
// within the neighbourhood's range (no halos), then back.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba16f) uniform writeonly image2D dst;
layout(push_constant) uniform Push {
	float amount;
} push;

vec3 Tonemap(vec3 c) {
	return c / (1.0 + max(c.r, max(c.g, c.b)));
}
vec3 Untonemap(vec3 c) {
	return c / max(1.0 - max(c.r, max(c.g, c.b)), 1.0 / 64.0);
}

void main() {
	ivec2 p    = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = textureSize(src, 0);
	if (p.x >= size.x || p.y >= size.y) return;
	vec4 center = texelFetch(src, p, 0);
	vec3 c = Tonemap(max(center.rgb, vec3(0.0)));
	vec3 n = Tonemap(max(texelFetch(src, clamp(p + ivec2(0, -1), ivec2(0), size - 1), 0).rgb, vec3(0.0)));
	vec3 s = Tonemap(max(texelFetch(src, clamp(p + ivec2(0, 1), ivec2(0), size - 1), 0).rgb, vec3(0.0)));
	vec3 w = Tonemap(max(texelFetch(src, clamp(p + ivec2(-1, 0), ivec2(0), size - 1), 0).rgb, vec3(0.0)));
	vec3 e = Tonemap(max(texelFetch(src, clamp(p + ivec2(1, 0), ivec2(0), size - 1), 0).rgb, vec3(0.0)));
	vec3 mn = min(c, min(min(n, s), min(w, e)));
	vec3 mx = max(c, max(max(n, s), max(w, e)));
	vec3 sharpened = c + (c - 0.25 * (n + s + w + e)) * (push.amount * 2.0);
	sharpened      = clamp(sharpened, mn, mx);
	imageStore(dst, p, vec4(Untonemap(sharpened), center.a));
}
