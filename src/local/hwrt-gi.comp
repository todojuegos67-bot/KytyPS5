#version 460
// KYTY_HWRT_AO / KYTY_HWRT_GI (hwrt-gi.cpp): ray-traced ambient occlusion and one-bounce diffuse GI through the scene TLAS
// (hwrt-scene.cpp) on the PS5 Pro path's render-resolution color, recorded right before the upscaler in GTAO's place.
//
// Modes (push.mode):
//   0 trace:     per trace pixel (half res at levels 1-2, full at 3; a pixel of each 2x2 block, rotating, at half): the
//                world position from the game's depth through the scene camera's clip -> world, the normal (G-buffer
//                world normal where it agrees with the depth's), then
//                AO: short cosine rays (first hit), occlusion 1 - (t / radius)^2 -> .a (visibility)
//                GI: cosine rays (closest hit) up to the range; a hit on screen and not hidden takes the lit colour
//                there (the game's own lighting of the hit surface = its outgoing radiance), a hidden / off-screen hit
//                a dim local estimate, a miss nothing (the sky's light is already in the game's ambient) -> .rgb
//                + gout (world normal, distance)
//   1 temporal:  motion-vector reprojection, disocclusion by distance / normal, alpha max(1 / count, 0.06), the history
//                clamped to the 3x3 neighbourhood's mean +- k sigma; count in aux_out.z
//   2 a-trous:   5x5 edge-aware (distance, normal) blur, steps 1, 2 (, 4)
//   3 composite: depth-aware upsample to render res; color * AO (floored) + albedo x bounce x intensity (soft-capped
//                against the pixel's own light); sky untouched; faded out far away; view 1 AO, 2 the added bounce x 4.
#extension GL_EXT_ray_query : require
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D color_tex;
layout(binding = 1) uniform sampler2D depth_tex;
layout(binding = 2) uniform sampler2D motion_tex;
layout(binding = 3) uniform sampler2D src_a;
layout(binding = 4) uniform sampler2D src_b;
layout(binding = 5) uniform sampler2D gbuf_cur;
layout(binding = 6) uniform sampler2D gbuf_prev;
layout(binding = 7, rgba16f) uniform writeonly image2D out_img;
layout(binding = 8, rgba16f) uniform writeonly image2D gbuf_out;
layout(binding = 9) uniform sampler2D aux_tex;
layout(binding = 10, rgba16f) uniform writeonly image2D aux_out;
layout(binding = 11) uniform usampler2D gb_normal; // G-buffer layer 3 (oct 8:8 world normal; flag 4), else a 1x1 stand-in
layout(binding = 12) uniform usampler2D gb_albedo; // G-buffer layer 0 (albedo rgb8; flag 8), else a 1x1 stand-in
layout(binding = 13) uniform accelerationStructureEXT tlas;
layout(binding = 16) uniform sampler2D dyn_tex; // (ao-fix) temporal: the trace's share of AO weight from moving occluders (.x)
layout(std140, binding = 14) uniform Frame {
	vec4  inv[4];   // clip -> world rows
	vec4  vp[4];    // world -> clip rows
	vec4  cam;      // xyz the camera, w the AO radius (m)
	vec4  motion;   // motion scale xy, render size zw
	vec4  trace;    // trace size xy, AO strength, GI intensity
	vec4  par;      // GI range (m), AO floor, fade start (m), fade end (m)
	ivec4 cfg;      // AO rays, GI rays, level, flags (1 reset, 2 history valid, 4 G-buffer normal, 8 G-buffer albedo, 16 half res, 32 AO on, 64 GI on, 128 y flip, 256 camera still)
	ivec4 cfg2;     // frame, view mode, stats slot, w (gi-1027): bit 0 trust the 0x02 mask as 'moving', bits 8.. the ambient scale x 100
	vec4  proj;      // the upscaler's view_to_clip: M[0], M[5], M[8], M[9]
	vec4  depth_map; // A = M[10], B = M[14], C = M[11], D = M[15]
	vec4  fog;       // x the fog distance (m: AO and GI weight exp(-dist / x); 0 off), y 1: raw (no temporal / a-trous),
	                 // z the frame's geometric-mean light (0 unknown), w the AO's lit-pixel relief (0..1)
	vec4  pvp[4];    // the previous frame's world -> clip rows (the scene camera's)
	vec4  pcam;      // the previous frame's camera, w 1 valid
} u;
// (diag) self-test counters, one 64-word slot a frame (cfg2.z), read on the CPU 4 frames later (hwrt-gi.cpp, the
// "HWRTGI: self-test" line): 0 traced pixels, 1 AO rays, 2 AO hits, 3 GI rays, 4 GI hits, 5 GI hits seen on screen,
// 6 normals up (y > 0.7), 7 down (y < -0.7), 8 G-buffer normal taken (agrees), 9 G-buffer normal present but disagrees,
// 10 G-buffer normal y > 0.7, 11 its y < -0.7; 12 the centre written; 16.. the centre pixel (floats, see Diag).
layout(std430, binding = 15) buffer Stats { uint st[]; };
layout(push_constant) uniform Push {
	int   mode;
	float step;
	int   pad0, pad1;
} push;

const float PI = 3.14159265;
// (hwrt5a perf) the self-test counters on 1 trace pixel of 4x4 only: every pixel's atomics on the same few words were
// serialised (most of the pass's 3-4 ms); percentages are unchanged
bool g_stat = false;
#define STAT(a, b) if (g_stat) atomicAdd(a, b)

vec2  RenderSize() { return u.motion.zw; }
vec2  TraceSize() { return u.trace.xy; }
float Luma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }
bool  IsSky(float d);

vec2 Ndc(vec2 uv) {
	vec2 n = uv * 2.0 - 1.0;
	if ((u.cfg.w & 128) != 0) n.y = -n.y;
	return n;
}
// (fix 2) The depth buffer's value is not the scene camera's clip z / w (its depth convention differs: points slid along
// their view rays, wrong by an amount that changed with the camera's pitch). Only x / y go through the scene camera:
// the pixel's world-space view ray (two points of it, any z convention); the distance along it comes from the depth
// through the upscaler's view_to_clip (GTAO's ViewPos: view space, exact length).
vec3 ClipToWorld(vec4 c) {
	vec4 h = vec4(dot(u.inv[0], c), dot(u.inv[1], c), dot(u.inv[2], c), dot(u.inv[3], c));
	return h.xyz / (abs(h.w) > 1e-20 ? h.w : 1e-20);
}
vec3 RayDir(vec2 uv) {
	vec2 n = Ndc(uv);
	vec3 a = ClipToWorld(vec4(n, 0.25, 1.0)), b = ClipToWorld(vec4(n, 0.75, 1.0));
	vec3 d = normalize(b - a);
	// toward the scene, away from the camera
	if (dot(d, a - u.cam.xyz) < 0.0 && dot(d, b - u.cam.xyz) < 0.0) d = -d;
	return d;
}
float ViewZ(float d) {
	float den = d * u.depth_map.z - u.depth_map.x;
	return abs(den) > 1e-12 ? (u.depth_map.y - d * u.depth_map.w) / den : 1e6;
}
float ViewDist(vec2 uv, float d) {
	float z  = ViewZ(d);
	float w  = z * u.depth_map.z + u.depth_map.w;
	vec2  nd = uv * 2.0 - 1.0;
	vec3  v  = vec3((nd.x * w - z * u.proj.z) / u.proj.x, (nd.y * w - z * u.proj.w) / u.proj.y, z);
	return length(v);
}
bool IsSky(float d) { return d <= 1e-7 || d >= 0.9999999 || abs(ViewZ(d)) > 2e3; }
vec3 World(vec2 uv, float d) { return u.cam.xyz + RayDir(uv) * ViewDist(uv, d); }
// world -> uv (w > 0: in front)
vec3 Project(vec3 p) {
	vec4 c = vec4(p, 1.0);
	vec4 h = vec4(dot(u.vp[0], c), dot(u.vp[1], c), dot(u.vp[2], c), dot(u.vp[3], c));
	if (h.w <= 1e-6) return vec3(-1.0, -1.0, -1.0);
	vec2 n = h.xy / h.w;
	if ((u.cfg.w & 128) != 0) n.y = -n.y;
	return vec3(n * 0.5 + 0.5, h.z / h.w);
}

float Hash(uvec3 v) {
	v = v * 1664525u + 1013904223u;
	v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
	v ^= v >> 16u;
	v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
	return float(v.x & 0xffffffu) / 16777216.0;
}
// R2 low-discrepancy offset per frame on top of a per-pixel hash (cosine sample i of n)
vec2 Rand2(ivec2 px, int i) {
	float f = float(u.cfg2.x & 1023) + float(i) * 37.0;
	vec2  h = vec2(Hash(uvec3(px, 7u)), Hash(uvec3(px, 13u)));
	return fract(h + f * vec2(0.7548776662, 0.5698402910));
}
vec3 Cosine(vec3 n, vec2 r) {
	vec3  t   = abs(n.y) < 0.99 ? normalize(cross(n, vec3(0, 1, 0))) : normalize(cross(n, vec3(1, 0, 0)));
	vec3  b   = cross(n, t);
	float phi = 2.0 * PI * r.x;
	float s   = sqrt(r.y);
	return normalize(t * (cos(phi) * s) + b * (sin(phi) * s) + n * sqrt(max(1.0 - r.y, 0.0)));
}

float Bits8(uint w, int sh) { return float((w >> uint(sh)) & 255u) / 255.0; }
vec3 OctDec(vec2 e) {
	e       = e * 2.0 - 1.0;
	vec3  n = vec3(e, 1.0 - abs(e.x) - abs(e.y));
	float t = max(-n.z, 0.0);
	n.x += n.x >= 0.0 ? -t : t;
	n.y += n.y >= 0.0 ? -t : t;
	return normalize(n);
}

// The world normal: the depth's (cross of the nearer neighbours' positions, facing the camera); the G-buffer's where it
// agrees with it (smooth on flat walls, no 1-pixel staircase noise), the depth's at edges / over particles.
vec3 g_gbn = vec3(0); // (diag) the G-buffer's decoded normal at the last NormalAt (0: none)
vec3 g_ng  = vec3(0);
vec3 NormalAt(vec2 uv, vec3 P) {
	vec2  t  = 1.0 / RenderSize();
	vec3  px = World(uv + vec2(t.x, 0), textureLod(depth_tex, uv + vec2(t.x, 0), 0).r);
	vec3  nx = World(uv - vec2(t.x, 0), textureLod(depth_tex, uv - vec2(t.x, 0), 0).r);
	vec3  py = World(uv + vec2(0, t.y), textureLod(depth_tex, uv + vec2(0, t.y), 0).r);
	vec3  ny = World(uv - vec2(0, t.y), textureLod(depth_tex, uv - vec2(0, t.y), 0).r);
	vec3  dx = distance(px, P) < distance(P, nx) ? px - P : P - nx;
	vec3  dy = distance(py, P) < distance(P, ny) ? py - P : P - ny;
	vec3  ng = cross(dx, dy);
	float l  = length(ng);
	vec3  V  = u.cam.xyz - P;
	ng       = l > 1e-12 ? ng / l : normalize(V);
	if (dot(ng, V) < 0.0) ng = -ng;
	g_ng = ng;
	if ((u.cfg.w & 4) == 0) return ng;
	ivec2 gs = textureSize(gb_normal, 0);
	uint  w  = texelFetch(gb_normal, clamp(ivec2(uv * vec2(gs)), ivec2(0), gs - 1), 0).r;
	if (w == 0u) return ng;
	vec3 n = OctDec(vec2(Bits8(w, 0), Bits8(w, 8)));
	g_gbn  = n;
	if (dot(n, V) < 0.0) n = -n;
	return normalize(mix(ng, n, smoothstep(0.6, 0.85, dot(n, ng))));
}

void Trace(ivec2 pixel) {
	// the render pixel this trace pixel stands for (half res: the top-left of its 2x2)
	// (ao-fix) fixed, not rotating every frame: on an edge the rotating pixel fell on the foreground one frame and the
	// background the next, so the temporal pass saw a disocclusion there every frame (edge shimmer, halos round
	// characters); the depth- and normal-aware upsample fills the other three
	ivec2 rp = (u.cfg.w & 16) != 0 ? pixel * 2 : pixel;
	rp       = min(rp, ivec2(RenderSize()) - 1);
	vec2  uv = (vec2(rp) + 0.5) / RenderSize();
	float d  = texelFetch(depth_tex, rp, 0).r;
	if (IsSky(d)) {
		imageStore(out_img, pixel, vec4(0, 0, 0, 1));
		imageStore(gbuf_out, pixel, vec4(0, 0, 0, 1e6));
		imageStore(aux_out, pixel, vec4(0));
		return;
	}
	g_stat     = ((pixel.x | pixel.y) & 3) == 0;
	vec3  P    = World(uv, d);
	float dist = distance(P, u.cam.xyz);
	// (hwrt5a perf) beyond what the fog fade leaves (exp(-4) < 2 %) or the distance fade's end: no rays
	if ((u.fog.x > 0.0 && dist > 4.0 * u.fog.x) || dist > u.par.w) {
		imageStore(out_img, pixel, vec4(0, 0, 0, 1));
		imageStore(gbuf_out, pixel, vec4(normalize(u.cam.xyz - P), dist));
		imageStore(aux_out, pixel, vec4(0));
		return;
	}
	if (g_stat) { // (ao-fix) the frame's light as a geometric mean (exposure-free: the composite works on ratios to it)
		float l = Luma(textureLod(color_tex, uv, 0).rgb);
		atomicAdd(st[uint(u.cfg2.z) * 64u + 48u], uint(clamp(log2(max(l, 1e-6)) + 32.0, 0.0, 64.0) * 256.0));
		atomicAdd(st[uint(u.cfg2.z) * 64u + 49u], 1u);
	}
	vec3  N    = NormalAt(uv, P);
	vec3  O    = P + N * (0.015 + 0.0015 * dist);
	float ao   = 1.0;
	const uint sb = uint(u.cfg2.z) * 64u;
	STAT(st[sb + 0u], 1u);
	if (N.y > 0.7) STAT(st[sb + 6u], 1u);
	if (N.y < -0.7) STAT(st[sb + 7u], 1u);
	if (g_gbn != vec3(0)) {
		STAT(st[sb + (dot(normalize(g_gbn * sign(dot(g_gbn, u.cam.xyz - P))), g_ng) > 0.6 ? 8u : 9u)], 1u);
		if (g_gbn.y > 0.7) STAT(st[sb + 10u], 1u);
		if (g_gbn.y < -0.7) STAT(st[sb + 11u], 1u);
	}
	// the centre pixel: this path's point against a primary ray from the camera through the TLAS (the hwrt2 / debug
	// view convention: inverse view-projection at NDC (x, y), y = uv.y * 2 - 1), the legacy inv(VP) * (ndc, depth)
	ivec2 cp = ivec2(TraceSize()) / 2;
	if (pixel == cp) {
		vec3 rd = RayDir(uv);
		vec4 c0 = vec4(Ndc(uv), 0.5, 1.0);
		vec3 dbg = normalize(ClipToWorld(c0) - u.cam.xyz);
		rayQueryEXT pq;
		rayQueryInitializeEXT(pq, tlas, gl_RayFlagsOpaqueEXT, 0xff, u.cam.xyz, 0.05, dbg, 100000.0);
		while (rayQueryProceedEXT(pq)) {}
		float pt = rayQueryGetIntersectionTypeEXT(pq, true) == gl_RayQueryCommittedIntersectionTriangleEXT ? rayQueryGetIntersectionTEXT(pq, true) : -1.0;
		vec3  legacy = ClipToWorld(vec4(Ndc(uv), d, 1.0));
		float f[24] = float[](P.x, P.y, P.z, dist, u.cam.x, u.cam.y, u.cam.z, pt,
		                      u.cam.x + dbg.x * pt, u.cam.y + dbg.y * pt, u.cam.z + dbg.z * pt, d,
		                      legacy.x, legacy.y, legacy.z, dot(rd, dbg),
		                      g_ng.x, g_ng.y, g_ng.z, 0.0, g_gbn.x, g_gbn.y, g_gbn.z, ViewZ(d));
		for (int i = 0; i < 24; ++i) st[sb + 16u + uint(i)] = floatBitsToUint(f[i]);
		st[sb + 12u] = 1u;
	}
	// (hwrt5a) The screen's y convention against the TLAS, measured: on a sparse grid (1 trace pixel of 16x16), a primary
	// ray from the camera through this pixel as the flag has it (A) and with NDC y mirrored (B); each agrees when its hit
	// lies at this pixel's view distance (3 % + 5 cm). A wrong convention mirrors every ray about the horizon: only a band
	// there lands on geometry (the rest floats in the air: no occlusion anywhere, the grey view flat white). The CPU reads
	// the votes (words 40.. of the slot) and turns the flag over when B wins (hwrt-gi.cpp).
	if ((pixel.x & 15) == 8 && (pixel.y & 15) == 8) {
		g_stat = true;
		vec2 n  = Ndc(uv);
		vec3 da = normalize(ClipToWorld(vec4(n, 0.5, 1.0)) - u.cam.xyz);
		vec3 db = normalize(ClipToWorld(vec4(n.x, -n.y, 0.5, 1.0)) - u.cam.xyz);
		float ta = -1.0, tb = -1.0;
		rayQueryEXT pa;
		rayQueryInitializeEXT(pa, tlas, gl_RayFlagsOpaqueEXT, 0xff, u.cam.xyz, 0.05, da, 5000.0);
		while (rayQueryProceedEXT(pa)) {}
		if (rayQueryGetIntersectionTypeEXT(pa, true) == gl_RayQueryCommittedIntersectionTriangleEXT) ta = rayQueryGetIntersectionTEXT(pa, true);
		rayQueryEXT pb;
		rayQueryInitializeEXT(pb, tlas, gl_RayFlagsOpaqueEXT, 0xff, u.cam.xyz, 0.05, db, 5000.0);
		while (rayQueryProceedEXT(pb)) {}
		if (rayQueryGetIntersectionTypeEXT(pb, true) == gl_RayQueryCommittedIntersectionTriangleEXT) tb = rayQueryGetIntersectionTEXT(pb, true);
		float tol = 0.03 * dist + 0.05;
		STAT(st[sb + 40u], 1u);
		if (ta >= 0.0 && abs(ta - dist) < tol) STAT(st[sb + 41u], 1u);
		if (tb >= 0.0 && abs(tb - dist) < tol) STAT(st[sb + 42u], 1u);
		if (abs(n.y) > 0.3) STAT(st[sb + 43u], 1u); // (off the horizon: where the two conventions differ)
	}
	g_stat = ((pixel.x | pixel.y) & 3) == 0;
	if ((u.cfg.w & 32) != 0) {
		float occ = 0.0, occ_dyn = 0.0;
		float R    = u.cam.w;
		float tmin = 0.01 + 0.0005 * dist;
		for (int i = 0; i < u.cfg.x; ++i) {
			vec3 dir = Cosine(N, Rand2(pixel, i));
			// (fix 3) t_min: a receiver a hair behind its own triangle (depth precision, jitter) hits that triangle's back
			// at once and read as fully occluded. (rt3fx) closest hit, not TerminateOnFirstHit (the first hit found is
			// not the nearest: t too long, every crease too light). (ao-fix) the 0x03 closest hit as two rays: static
			// (0x01) to R, then dynamic (0x02) only up to the static hit (few instances: cheap); the same nearest hit,
			// and it says whether the occluder is a moving one, so the temporal pass can let go of the history it left
			// behind (dark ghosting behind moving characters). 0x04 (stale positions) and 0x08 (tiny cards) never.
			float       t   = R;
			bool        hit = false, dyn = false;
			rayQueryEXT rs;
			rayQueryInitializeEXT(rs, tlas, gl_RayFlagsOpaqueEXT, 0x01, O, tmin, dir, R);
			while (rayQueryProceedEXT(rs)) {}
			if (rayQueryGetIntersectionTypeEXT(rs, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
				t = rayQueryGetIntersectionTEXT(rs, true), hit = true;
				if (rayQueryGetIntersectionFrontFaceEXT(rs, true)) STAT(st[sb + 13u], 1u);
			}
			rayQueryEXT rd;
			rayQueryInitializeEXT(rd, tlas, gl_RayFlagsOpaqueEXT, 0x02, O, tmin, dir, t);
			while (rayQueryProceedEXT(rd)) {}
			if (rayQueryGetIntersectionTypeEXT(rd, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
				t = rayQueryGetIntersectionTEXT(rd, true), hit = dyn = true;
				if (rayQueryGetIntersectionFrontFaceEXT(rd, true)) STAT(st[sb + 13u], 1u);
			}
			if (hit) {
				// (ao-fix) contact falloff (1 - t / R)^2: near occluders count fully, the radius' far half little; the
				// linear falloff over 2 m gave every open floor a share from far walls / terrain (the grey veil)
				float w = clamp(1.0 - t / R, 0.0, 1.0);
				w *= w;
				occ += w;
				if (dyn) occ_dyn += w;
				STAT(st[sb + 2u], 1u);
				if (dyn) STAT(st[sb + 45u], 1u);
				else STAT(st[sb + 44u], 1u);
			}
		}
		imageStore(aux_out, pixel, vec4(occ > 1e-4 ? occ_dyn / occ : 0.0, 0, 0, 0));
		ao = 1.0 - occ / float(max(u.cfg.x, 1));
		// (hwrt5a) alpha-tested foliage (opaque cards in the TLAS): where the G-buffer normal and the depth's disagree
		// the receiver is a leaf / thin edge with noisy depth; half weight there (no black speckle clouds in trees)
		if (g_gbn != vec3(0) && dot(normalize(g_gbn * sign(dot(g_gbn, u.cam.xyz - P))), g_ng) < 0.6) ao = mix(ao, 1.0, 0.5);
		STAT(st[sb + 1u], uint(u.cfg.x));
	}
	vec3 gi = vec3(0);
	if ((u.cfg.w & 64) != 0) {
		vec3 own = textureLod(color_tex, uv, 0).rgb;
		for (int i = 0; i < u.cfg.y; ++i) {
			vec3        dir = Cosine(N, Rand2(pixel, i + 8));
			rayQueryEXT rq;
			// (gi-1027) t_min against self-hits and mask 0x03 (no stale positions 0x04, no tiny cards 0x08): with t_min 0
			// every ray from a receiver a hair behind its own triangle hit that triangle at t ~ 0, where the bounce weight
			// smoothstep(0, 0.05, t) is 0: hits that blocked the real bounce and added nothing
			rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT, 0x03, O, 0.01 + 0.0005 * dist, dir, u.par.x);
			while (rayQueryProceedEXT(rq)) {}
			STAT(st[sb + 3u], 1u);
			if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionTriangleEXT) continue;
			STAT(st[sb + 4u], 1u);
			float t    = rayQueryGetIntersectionTEXT(rq, true);
			vec3  H    = O + dir * t;
			vec3  huv  = Project(H);
			vec3  L    = vec3(0);
			bool  seen = false;
			if (all(greaterThanEqual(huv.xy, vec2(0.002))) && all(lessThanEqual(huv.xy, vec2(0.998)))) {
				float hd = textureLod(depth_tex, huv.xy, 0).r;
				if (!IsSky(hd)) {
					float dh = distance(H, u.cam.xyz);
					float ds = distance(World(huv.xy, hd), u.cam.xyz);
					// visible: the depth there is the hit (within 5 % + 10 cm); else something hides it
					if (abs(ds - dh) < 0.05 * dh + 0.1) {
						L    = textureLod(color_tex, huv.xy, 0).rgb;
						seen = true;
						STAT(st[sb + 5u], 1u);
					}
				}
			}
			// hidden / off screen: a dim estimate from the receiver's own light (the surroundings lit alike)
			if (!seen) L = own * 0.2; // (gi-1027) 0.1 -> 0.2
			// near hits are mostly the receiver's own crease: keep their bounce, but no light from inside a millimetre
			gi += min(L, vec3(64.0)) * smoothstep(0.0, 0.05, t);
		}
		gi /= float(max(u.cfg.y, 1));
	}
	if ((u.cfg.w & 32) == 0) imageStore(aux_out, pixel, vec4(0));
	imageStore(out_img, pixel, vec4(gi, ao));
	imageStore(gbuf_out, pixel, vec4(N, dist));
}

void Temporal(ivec2 pixel) {
	vec2 ts  = 1.0 / TraceSize();
	vec2 uv  = (vec2(pixel) + 0.5) * ts;
	vec4 cur = textureLod(src_a, uv, 0);
	vec4 g   = textureLod(gbuf_cur, uv, 0);
	if (g.w > 1e5) {
		imageStore(out_img, pixel, vec4(0, 0, 0, 1));
		imageStore(aux_out, pixel, vec4(0));
		return;
	}
	const bool still = (u.cfg.w & 256) != 0;
	float      dcur  = 0.0; // (ao-fix) moving occluders here or next to here this frame
	// (gi-1027) the 0x02 mask is not 'moving' in Demon's Souls: every instance of the world is captured as dynamic (the
	// HWRTAO line: of the hits static 0.0 % / moving 100.0 %), so every occluded pixel let go of its history at alpha
	// 0.3 toward a 3x3 mean of 3 rays: the RTFLICKER ao 8 % / max jump 154 %. Only trusted when asked
	float dyn_trust = (u.cfg2.w & 1) != 0 ? 1.0 : 0.0;
	vec4  m1 = vec4(0), m2 = vec4(0);
	float wn = 0.0;
	for (int y = -1; y <= 1; ++y)
		for (int x = -1; x <= 1; ++x) {
			vec2  suv = uv + vec2(x, y) * ts;
			vec4  sg  = textureLod(gbuf_cur, suv, 0);
			float w   = (abs(sg.w - g.w) < 0.05 * g.w && dot(sg.xyz, g.xyz) > 0.8) ? 1.0 : 0.0;
			vec4  sv  = textureLod(src_a, suv, 0);
			dcur = max(dcur, textureLod(dyn_tex, suv, 0).x * dyn_trust);
			m1 += sv * w;
			m2 += sv * sv * w;
			wn += w;
		}
	wn = max(wn, 1.0);
	m1 /= wn, m2 /= wn;
	vec4  sigma = sqrt(max(m2 - m1 * m1, vec4(0)));
	// (ao-fix) the camera holding still: a longer mean (no reprojection error to hide), the noise about half
	float a_min = still ? 0.02 : u.cfg.z >= 3 ? 0.05 : 0.06;
	float n_max = still ? 64.0 : 24.0;
	float count = 1.0;
	float dyn   = dcur;
	// (rt3fx) no history (disocclusion, reset): the 3x3 neighbourhood's mean (same surface), not this pixel's 2-3 rays
	// alone: a lone noisy sample was a one-frame dark / light speck wherever something moved
	vec4  res   = wn > 1.5 ? m1 : cur;
	// the motion vectors are at render res: the render pixel under this trace pixel's centre
	// (fix 3) the point's own reprojection through the scene camera's previous view-projection (world space: no motion
	// vector sign / scale convention to get wrong; the vertical trails were history pulled from the wrong rows)
	vec2 puv = vec2(-1.0);
	float pdist = g.w;
	if (u.pcam.w > 0.5) {
		vec3 Pw = u.cam.xyz + RayDir(uv) * g.w;
		vec4 c  = vec4(Pw, 1.0);
		vec4 h  = vec4(dot(u.pvp[0], c), dot(u.pvp[1], c), dot(u.pvp[2], c), dot(u.pvp[3], c));
		if (h.w > 1e-6) {
			vec2 n = h.xy / h.w;
			if ((u.cfg.w & 128) != 0) n.y = -n.y;
			puv = n * 0.5 + 0.5;
		}
		pdist = distance(Pw, u.pcam.xyz);
	}
	if ((u.cfg.w & 1) == 0 && (u.cfg.w & 2) != 0 && all(greaterThanEqual(puv, vec2(0))) && all(lessThanEqual(puv, vec2(1)))) {
		vec4  pg = textureLod(gbuf_prev, puv, 0);
		float dz = abs(pg.w - pdist) / max(pdist, 1e-3);
		if (dz < 0.05 && dot(pg.xyz, g.xyz) > 0.9) {
			vec4 pa = textureLod(aux_tex, puv, 0);
			count   = min(max(pa.z, 1.0) + 1.0, n_max);
			// (ao-fix) history darkened by a moving occluder (this frame's or the last frames'): the occluder may have
			// left, so that history lets go fast, toward the neighbourhood mean (not one pixel's 2-4 rays), and the
			// variance clamp tightens
			dyn         = max(dcur, pa.y * 0.8);
			float alpha = max(max(1.0 / count, a_min), 0.3 * dyn);
			float k     = mix(1.25, 3.0, clamp(count / 24.0, 0.0, 1.0)) * mix(1.0, 0.5, dyn);
			vec4  hraw  = textureLod(src_b, puv, 0);
			vec4  hist  = clamp(hraw, m1 - k * sigma - vec4(vec3(0.002), 0.02), m1 + k * sigma + vec4(vec3(0.002), 0.02));
			// (gi-1027) occluder / light really changed (in place of the mask): the 3x3 mean this frame lies far outside the
			// history, measured in the mean's own standard error; noise alone stays near 1 (no release while still)
			vec4  se    = sigma / sqrt(wn) + vec4(vec3(0.004), 0.015);
			vec4  dv    = abs(m1 - hraw) / (3.0 * se);
			float rel   = smoothstep(1.0, 2.5, max(dv.a, Luma(dv.rgb)));
			dyn         = max(dyn, rel);
			alpha       = max(alpha, 0.5 * rel);
			res         = mix(hist, mix(cur, m1, dyn), alpha);
		}
	}
	imageStore(out_img, pixel, max(res, vec4(0)));
	imageStore(aux_out, pixel, vec4(0, dyn, count, 0));
}

void Atrous(ivec2 pixel) {
	vec2 ts = 1.0 / TraceSize();
	vec2 uv = (vec2(pixel) + 0.5) * ts;
	vec4 g  = textureLod(gbuf_cur, uv, 0);
	vec4 c  = textureLod(src_a, uv, 0);
	if (g.w > 1e5) {
		imageStore(out_img, pixel, c);
		return;
	}
	const float kern[3] = float[](0.375, 0.25, 0.0625);
	// fewer history frames: a wider effective blur (the a-trous weights' normal / depth stops stay)
	float count = textureLod(aux_tex, uv, 0).z;
	float sharp = mix(0.5, 1.0, clamp(count / 8.0, 0.0, 1.0));
	vec4  sum   = vec4(0);
	float wsum  = 0.0;
	for (int y = -2; y <= 2; ++y)
		for (int x = -2; x <= 2; ++x) {
			vec2  suv = uv + vec2(x, y) * push.step * ts;
			vec4  sg  = textureLod(gbuf_cur, suv, 0);
			if (sg.w > 1e5) continue;
			float wd = exp(-abs(sg.w - g.w) / max(0.02 * g.w, 1e-3) * sharp);
			float wn = pow(max(dot(sg.xyz, g.xyz), 0.0), 16.0 * sharp);
			float w  = kern[abs(x)] * kern[abs(y)] * wd * wn;
			sum += textureLod(src_a, suv, 0) * w;
			wsum += w;
		}
	imageStore(out_img, pixel, wsum > 1e-6 ? sum / wsum : c);
}

void Composite(ivec2 pixel) {
	vec2  uv  = (vec2(pixel) + 0.5) / RenderSize();
	vec4  col = texelFetch(color_tex, pixel, 0);
	float d   = texelFetch(depth_tex, pixel, 0).r;
	if (IsSky(d)) {
		imageStore(out_img, pixel, (u.cfg2.y == 0) ? col : vec4(u.cfg2.y == 1 ? vec3(1) : vec3(0), col.a));
		return;
	}
	float dist = distance(World(uv, d), u.cam.xyz);
	// depth-aware upsample: the 2x2 trace texels around, weighted by bilinear x distance agreement
	vec4 r;
	if ((u.cfg.w & 16) != 0) {
		vec2  tp   = uv * TraceSize() - 0.5;
		ivec2 b    = ivec2(floor(tp));
		vec2  f    = tp - vec2(b);
		// (ao-fix) and normal agreement (the G-buffer's, when there is one): a character's edge pixel no longer takes the
		// wall behind it (halos), a floor pixel at a wall's base not the wall's; none agreeing: the nearest in depth
		vec3 nr = vec3(0);
		if ((u.cfg.w & 4) != 0) {
			ivec2 gs = textureSize(gb_normal, 0);
			uint  w  = texelFetch(gb_normal, clamp(ivec2(uv * vec2(gs)), ivec2(0), gs - 1), 0).r;
			if (w != 0u) {
				nr = OctDec(vec2(Bits8(w, 0), Bits8(w, 8)));
				if (dot(nr, u.cam.xyz - World(uv, d)) < 0.0) nr = -nr;
			}
		}
		vec4  sum  = vec4(0);
		float wsum = 0.0, best = 1e30;
		vec4  near = vec4(0, 0, 0, 1);
		for (int i = 0; i < 4; ++i) {
			ivec2 o  = ivec2(i & 1, i >> 1);
			ivec2 q  = clamp(b + o, ivec2(0), ivec2(TraceSize()) - 1);
			vec4  g  = texelFetch(gbuf_cur, q, 0);
			vec4  v  = texelFetch(src_a, q, 0);
			float dd = abs(g.w - dist);
			if (dd < best) best = dd, near = v;
			float wb = (o.x == 1 ? f.x : 1.0 - f.x) * (o.y == 1 ? f.y : 1.0 - f.y);
			float wz = exp(-dd / max(0.02 * dist, 1e-3));
			float wn = nr != vec3(0) && g.w < 1e5 ? mix(0.02, 1.0, smoothstep(0.5, 0.9, dot(g.xyz, nr))) : 1.0;
			float w  = (wb + 1e-3) * wz * wn;
			sum += v * w;
			wsum += w;
		}
		r = wsum > 1e-4 ? sum / wsum : near;
	} else {
		r = texelFetch(src_a, pixel, 0);
	}
	float fade = 1.0 - smoothstep(u.par.z, u.par.w, dist);
	float ao   = (u.cfg.w & 32) != 0 ? clamp(r.a, 0.0, 1.0) : 1.0;
	ao         = ao * ao; // (hwrt5a) contrast: few rays and the temporal mean make creases read too light
	// (fog) the colour here is after the game's height / volumetric fog: the fog in front of the surface must not be
	// darkened or lit, so both terms scale with an estimate of its transmittance, exp(-distance / fog distance)
	if (u.fog.x > 0.0) fade *= exp(-dist / u.fog.x);
	// (ao-fix) the ambient share: AO occludes the ambient / bounce light, not the sun or a torch on the surface. The
	// colour is already lit (the game's own small-scale shading in it), so pixels much brighter than the frame's light
	// (geometric mean: exposure-free) are mostly direct light and take less of the AO (no double darkening of sunlit
	// stone; the game's exposure untouched: a pure ratio, never a level)
	float amb = 1.0;
	bool amb_model = (u.cfg.w & 8) != 0 && u.fog.z > 0.0 && (u.cfg2.w >> 8) > 0;
	if (u.fog.z > 0.0 && !amb_model) amb = 1.0 - u.fog.w * smoothstep(1.5, 6.0, Luma(col.rgb) / u.fog.z);
	float k_ao = max(mix(1.0, ao, u.trace.z * fade * amb), mix(1.0, u.par.y, fade));
	// (gi-1027) AO on the ambient term only: the ambient part of this pixel is at most albedo x the frame's ambient light
	// (the geometric-mean light x KYTY_HWRT_GI_AMBIENT); light above that is direct (sun, torches) and keeps its level
	vec3 amb_part = col.rgb;
	vec3 gb_alb   = vec3(0.4);
	if ((u.cfg.w & 8) != 0) {
		ivec2 gs = textureSize(gb_albedo, 0);
		uint  w  = texelFetch(gb_albedo, clamp(ivec2(uv * vec2(gs)), ivec2(0), gs - 1), 0).r;
		gb_alb   = clamp(vec3(float(w & 255u), float((w >> 8) & 255u), float((w >> 16) & 255u)) / 255.0, vec3(0.02), vec3(0.9));
	}
	if (amb_model) amb_part = min(col.rgb, gb_alb * (u.fog.z * float(u.cfg2.w >> 8) / 100.0));
	vec3  add  = vec3(0);
	if ((u.cfg.w & 64) != 0) {
		float l      = Luma(col.rgb);
		vec3  albedo = clamp(col.rgb / max(l, 1e-3), vec3(0), vec3(2)) * 0.4; // (no G-buffer: the colour's chroma)
		if ((u.cfg.w & 8) != 0) {
			ivec2 gs = textureSize(gb_albedo, 0);
			uint  w  = texelFetch(gb_albedo, clamp(ivec2(uv * vec2(gs)), ivec2(0), gs - 1), 0).r;
			albedo   = clamp(vec3(float(w & 255u), float((w >> 8) & 255u), float((w >> 16) & 255u)) / 255.0, vec3(0.02), vec3(0.9));
		}
		// the bounce is occluded by the same AO the rays saw only through its own misses: nothing more applied
		add       = albedo * r.rgb * u.trace.w * fade;
		// soft cap: at most ~the pixel's own light plus a little (dark corners lift, nothing glows)
		float la  = Luma(add);
		float cap = 0.8 * l + 0.4 * Luma(r.rgb) * u.trace.w; // (gi-1027) 0.25 -> 0.4: dark rooms fill from lit openings
		if (la > cap) add *= cap / max(la, 1e-6);
	}
	if (u.cfg2.y == 1) {
		// (hwrt5a) the debug view shows what the rays saw: no strength, floor, distance or fog fade (those turned it into
		// a flat light grey beyond a few metres and hid whether the AO worked at all)
		imageStore(out_img, pixel, vec4(vec3(ao), col.a));
		return;
	}
	if (u.cfg2.y == 2) {
		imageStore(out_img, pixel, vec4(add * 4.0, col.a));
		return;
	}
	// the bounce lights the ambient term too, so the same AO occludes it (its rays' misses already did most)
	imageStore(out_img, pixel, vec4(col.rgb - amb_part * (1.0 - k_ao) + add * mix(1.0, k_ao, 0.5), col.a));
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size  = ivec2(push.mode == 3 ? RenderSize() : TraceSize());
	if (any(greaterThanEqual(pixel, size))) return;
	if (push.mode == 0) Trace(pixel);
	else if (push.mode == 1) Temporal(pixel);
	else if (push.mode == 2) Atrous(pixel);
	else Composite(pixel);
}
