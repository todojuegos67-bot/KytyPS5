#version 450
// KYTY_TORCH / KYTY_TORCH_FLARE (torch.cpp): "Luz de antorchas RT" and "Destellos de lente" on the PS5 Pro path's
// pre-exposure HDR color, before the upscaler. Screen-space / G-buffer only: no acceleration structure, no ray query.
// Modes (push.misc.x):
//   0 detect:    a 32x18 grid of cells, 8x8 fixed taps a cell: fire pixels (exposed luminance above the threshold, warm
//                hue r/g, far above what their G-buffer albedo could reflect, 0.8..120 m) -> cand[cell]: weight, the
//                weighted uv, the nearest depth, the mean colour, the tap count
//   1 track:     one thread: the cells clustered into blobs (8-connected, depth-coherent), the strongest kept; the
//                tracked lights (2 / 4 / 8 slots) reprojected with the motion vectors and matched to them; position,
//                hue and power smoothed; a slow and a fast power -> the flicker (fast 0.3 s / slow 2 s, +-6 %, plus two slow
//                sines, clamped 0.9..1.1, low-passed 0.25 s); fade in ~0.35 s, a 0.15 s hold, out ~0.5 s; the flare's
//                visibility (depth-tested at the source, eased ~0.35 s)
//   2 light:     full resolution: every lit G-buffer surface within a light's range gets a point light: G-buffer
//                normal (world oct 8:8, rotated to view) and albedo, windowed inverse-square falloff, N.L, a short
//                screen-space march toward the light in the depth buffer (occlusion: no light through walls or
//                through characters), a GGX glint from the G-buffer roughness (the fire seen on wet / smooth
//                surfaces); added display-referred (x the game's exposure), soft-capped, faded with distance;
//                the sky, the far plane and the fire pixels themselves untouched. The occlusion is not marched here:
//                the light is multiplied by the filtered visibility ratio of modes 4 / 5 / 7 (src_tex .r).
//   3 flare:     full resolution, after every other pass: per visible light a tiny starburst, a short anamorphic
//                streak, 4 ghosts and a faint ring along the axis through the screen centre; faded at the screen
//                edges and with the light's visibility. No bloom wash: everything is small and capped.
//   4 shadow:    (torch-shadow-1028) full resolution: per light, a march in the depth buffer from the surface toward a
//                point jittered on the flame's disc (0.1 m), its samples uniform in SCREEN space (perspective-correct t),
//                ~1 per 5 px, 4..push.light.z, the start jittered per pixel and per frame (interleaved gradient noise +
//                the golden ratio); a sample occludes only when it lies behind the depth by more than a bias and LESS
//                than an object thickness (0.4 m + 8 % of z, <= 3 m): a character a metre in front of the ray no longer
//                shadows it (90fae059's 4 m window: the knight's stacked shadow copies, one per fixed step). Out
//                aux_img: (sum w_k v_k / W, W, k + share of W whose march was inconclusive (off-screen / behind a
//                much nearer surface: the hybrid's ray), view z); W the lights' unshadowed luminance weight.
//   5 temporal:  aux_img = the ratio reprojected with the motion vectors (src_tex this frame's, hist_tex last frame's),
//                rejected on a depth mismatch, variance-clamped to this frame's 3x3 neighbourhood, up to 24 frames:
//                (ratio, n, variance, z). The hybrid's rays come in already folded into src_tex: same history.
//   7 spatial:   aux_img = one a-trous iteration (steps 1, 2, 4: three passes) with depth, normal and variance stops.
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D color_tex;
layout(binding = 1) uniform sampler2D depth_tex;
layout(binding = 2) uniform usampler2D packed0;
layout(binding = 3) uniform usampler2D packed1;
layout(binding = 4) uniform usampler2D packed2;
layout(binding = 5) uniform usampler2D packed3;
layout(binding = 6, rgba16f) uniform writeonly image2D out_img;
layout(binding = 9) uniform sampler2D motion_tex;
layout(binding = 10) uniform sampler2D src_tex;  // (modes 2 / 5 / 7: their input)
layout(binding = 11) uniform sampler2D hist_tex; // (mode 5: last frame's history)
layout(binding = 12, rgba16f) uniform writeonly image2D aux_img;
layout(std430, binding = 7) buffer Frame {
	vec4 view_rot[3]; // words 0..11: world -> view rotation rows
	vec4 hp;          // 12..15: x 1.0 (exposure when the game gives none), y fire threshold (exposed), z slots, w -
	uint stats[16];   // 16..31: 0 frames, 1 blobs, 2 lights in use, 3 flares drawn, 4 sampled pixels, 5 lit pixels,
	                  // 6 lit (W > 0) sampled, 7 of them inconclusive, 8 traced (hybrid), 9 hit, 10 history n sum, 11 shadowed
	                  // (ratio < 0.5), 12 self / player rejected, 13 lit radius sum (cm),
	                  // 14 max lit radius this frame (cm, reset in mode 1), 15 lit beyond 4 m
	vec4 lights[32];  // 32..159: 8 slots x [0] (uv, view z, fade) [1] (hue rgb, slow power) [2] (fast power, flicker,
	                  // flare visibility, missing frames) [3] (view position xyz, power used)
	vec4 cand[];      // 160..: 32x18 cells x (weight, uv x, uv y, nearest z), (mean exposed rgb, taps)
};
layout(std430, binding = 8) readonly buffer Exposure {
	float exposure_values[];
};

layout(push_constant) uniform Push {
	vec4  proj;      // M[0], M[5], M[8], M[9]
	vec4  depth_map; // M[10], M[14], M[11], M[15]
	vec4  size;      // render w, h, strength, added-luminance cap (exposed)
	vec4  light;     // range scale, glint strength, march steps, max distance (m)
	vec4  flare;     // strength, aspect (w / h), time (s, wrapped), -
	vec4  motion;    // motion scale x, y, history valid (1), frame dt (s)
	ivec4 misc;      // mode, frame, flags (1 row 0 = NDC y +1, 2 G-buffer usable, 4 motion bound, 8 debug), exposure index
	ivec4 dec;       // normal code, roughness field, -, -
} push;

const int   CW    = 32;
const int   CH    = 18;
const int   NCELL = CW * CH;
const float PI    = 3.14159265;

vec2  RenderSize() { return push.size.xy; }
float YS() { return (push.misc.z & 1) != 0 ? -1.0 : 1.0; }
bool  Gbuf() { return (push.misc.z & 2) != 0; }
float ViewZ(float d) {
	float den = d * push.depth_map.z - push.depth_map.x;
	return abs(den) > 1e-12 ? (push.depth_map.y - d * push.depth_map.w) / den : 1e6;
}
vec3 ViewPosZ(vec2 uv, float z) {
	float w  = z * push.depth_map.z + push.depth_map.w;
	vec2  nd = uv * 2.0 - 1.0;
	nd.y *= YS();
	return vec3((nd.x * w - z * push.proj.z) / push.proj.x, (nd.y * w - z * push.proj.w) / push.proj.y, z);
}
bool Project(vec3 v, out vec2 uv) {
	float w = v.z * push.depth_map.z + push.depth_map.w;
	uv      = vec2(-1.0);
	if (w <= 1e-5) return false;
	vec2 nd = vec2((v.x * push.proj.x + v.z * push.proj.z) / w, (v.y * push.proj.y + v.z * push.proj.w) / w);
	nd.y *= YS();
	uv = nd * 0.5 + 0.5;
	return true;
}
bool  IsSky(float d) { return d <= 1e-7 || d >= 0.9999999 || abs(ViewZ(d)) > 2e3; }
float Luma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }
vec3  Safe(vec3 c) { return (any(isnan(c)) || any(isinf(c))) ? vec3(0) : clamp(c, vec3(0), vec3(6.0e4)); }
float Sat(float x) { return clamp(x, 0.0, 1.0); }
float Smooth01(float x) {
	x = Sat(x);
	return x * x * (3.0 - 2.0 * x);
}
float GameExposure() {
	float e = exposure_values[push.misc.w];
	return (e > 1e-12 && e < 1e12) ? e : 1.0;
}
float DepthAt(vec2 uv) { return textureLod(depth_tex, uv, 0).r; }
float ZAt(ivec2 p) {
	float d = texelFetch(depth_tex, p, 0).r;
	return IsSky(d) ? 1e6 : ViewZ(d);
}

// ---- G-buffer (Demon's Souls: L0 albedo rgb8, L3 world normal oct 8:8, L2 byte 0 roughness; codes as in shine) ----
uint Packed(int layer, ivec2 p) {
	if (layer == 0) return texelFetch(packed0, p, 0).r;
	if (layer == 1) return texelFetch(packed1, p, 0).r;
	if (layer == 2) return texelFetch(packed2, p, 0).r;
	return texelFetch(packed3, p, 0).r;
}
float Bits(uint w, int shift, int bits) { return float((w >> uint(shift)) & ((1u << uint(bits)) - 1u)) / float((1u << uint(bits)) - 1u); }
vec3  OctDecode(vec2 e) {
	e       = e * 2.0 - 1.0;
	vec3  n = vec3(e, 1.0 - abs(e.x) - abs(e.y));
	float t = max(-n.z, 0.0);
	n.x += n.x >= 0.0 ? -t : t;
	n.y += n.y >= 0.0 ? -t : t;
	return normalize(n);
}
vec3 DecodeNormal(uint w, int l) {
	if (l == 0) return OctDecode(vec2(Bits(w, 0, 16), Bits(w, 16, 16)));
	if (l == 5) return OctDecode(vec2(Bits(w, 16, 16), Bits(w, 0, 16)));
	if (l == 10) return OctDecode(vec2(Bits(w, 16, 8), Bits(w, 24, 8)));
	return OctDecode(vec2(Bits(w, 0, 8), Bits(w, 8, 8)));
}
vec3 ToView(vec3 n) { return vec3(dot(view_rot[0].xyz, n), dot(view_rot[1].xyz, n), dot(view_rot[2].xyz, n)); }
// The depth-derived normal (the smaller-step side on each axis: no smearing across edges), facing the camera.
vec3 DepthNormal(ivec2 p, vec3 pos) {
	ivec2 sz = ivec2(RenderSize());
	vec2  rs = RenderSize();
	ivec2 px = clamp(p + ivec2(1, 0), ivec2(0), sz - 1), nx = clamp(p - ivec2(1, 0), ivec2(0), sz - 1);
	ivec2 py = clamp(p + ivec2(0, 1), ivec2(0), sz - 1), ny = clamp(p - ivec2(0, 1), ivec2(0), sz - 1);
	vec3  a  = ViewPosZ((vec2(px) + 0.5) / rs, ZAt(px)) - pos;
	vec3  b  = pos - ViewPosZ((vec2(nx) + 0.5) / rs, ZAt(nx));
	vec3  c  = ViewPosZ((vec2(py) + 0.5) / rs, ZAt(py)) - pos;
	vec3  d  = pos - ViewPosZ((vec2(ny) + 0.5) / rs, ZAt(ny));
	vec3  dx = abs(a.z) < abs(b.z) ? a : b;
	vec3  dy = abs(c.z) < abs(d.z) ? c : d;
	vec3  n  = cross(dx, dy);
	float l  = length(n);
	if (!(l > 1e-12)) return normalize(-pos);
	n /= l;
	return dot(n, -pos) < 0.0 ? -n : n;
}
vec3 NormalAt(ivec2 p, vec3 pos) {
	if (!Gbuf()) return DepthNormal(p, pos);
	int  c = push.dec.x;
	vec3 n = DecodeNormal(Packed(c & 3, p), (c >> 2) & 15);
	if ((c & 64) != 0) n = ToView(n);
	if ((c & 128) != 0) n = -n;
	if (dot(n, -pos) < 0.0) n = -n;
	return normalize(n);
}
float Field(int f, ivec2 p) {
	if (f < 0) return 0.5;
	float v = Bits(Packed(f & 3, p), (f >> 2) & 31, max((f >> 7) & 31, 1));
	return (f & 4096) != 0 ? 1.0 - v : v;
}
// The diffuse albedo, roughly linear (the G-buffer's 8-bit albedo is gamma-like: squared); without the G-buffer the
// lit colour's chroma at a fixed dark-stone reflectance.
vec3 AlbedoAt(ivec2 p, vec3 col) {
	if (Gbuf()) {
		uint a0 = Packed(0, p);
		vec3 a  = vec3(Bits(a0, 0, 8), Bits(a0, 8, 8), Bits(a0, 16, 8));
		return clamp(a * a, vec3(0.02), vec3(0.9));
	}
	float l = Luma(col);
	return l > 1e-5 ? clamp(col / l, vec3(0), vec3(2)) * 0.15 : vec3(0.15);
}

// 0..1: how much of a fire this pixel is: bright (exposed), warm (r over g), far brighter than its albedo can reflect
// (with the G-buffer), not sky, 0.8..120 m. col: exposed colour.
float FireW(vec3 col, float z, vec3 alb) {
	if (z < 0.8 || z > 120.0) return 0.0;
	float l = Luma(col);
	float t = hp.y;
	float w = Smooth01((l - t) / t);
	if (w <= 0.0) return 0.0;
	float warm = Sat((col.r / max(col.g, 1e-4) - 1.35) / 0.8);
	// (local-1029) a flame's temperature: blue well under green (white / blue-white highlights, sky, lit UI and the moon
	// are not fire), and not a near-monochrome red (embers, blood, red cloth glints)
	warm *= Sat((0.8 - col.b / max(col.g, 1e-4)) / 0.3) * Sat((4.5 - col.r / max(col.g, 1e-4)) / 1.5);
	float gate = Gbuf() ? Sat((l / max(Luma(alb), 0.02) - 4.0) / 6.0) : 1.0;
	return w * warm * gate;
}

// ---- 0 detect ----
shared vec4  s_a[64]; // (w, w u, w v, -)
shared vec4  s_b[64]; // (w r, w g, w b, taps)
shared float s_z[64]; // nearest z of a fire tap

void Detect(uvec3 wg, uint li) {
	uvec2 cell = wg.xy;
	vec2  rs   = RenderSize();
	vec2  uv   = (vec2(cell) + (vec2(li % 8u, li / 8u) + 0.5) / 8.0) / vec2(CW, CH);
	ivec2 p    = clamp(ivec2(uv * rs), ivec2(0), ivec2(rs) - 1);
	float e    = GameExposure();
	vec3  c    = Safe(texelFetch(color_tex, p, 0).rgb) * e;
	float z    = ZAt(p);
	float w    = FireW(c, z, AlbedoAt(p, c / e));
	vec3  cc   = c * min(1.0, 64.0 / max(Luma(c), 1e-4)); // (a clipped sun of a pixel does not make a white light)
	s_a[li]    = vec4(w, w * uv, 0.0);
	s_b[li]    = vec4(w * cc, w > 0.0 ? 1.0 : 0.0);
	s_z[li]    = w > 0.0 ? z : 1e6;
	barrier();
	for (uint s = 32u; s > 0u; s >>= 1) {
		if (li < s) {
			s_a[li] += s_a[li + s];
			s_b[li] += s_b[li + s];
			s_z[li] = min(s_z[li], s_z[li + s]);
		}
		barrier();
	}
	if (li == 0u) {
		uint idx = (cell.y * uint(CW) + cell.x) * 2u;
		vec4 a   = s_a[0];
		vec4 b   = s_b[0];
		if (a.x <= 1e-4) {
			cand[idx] = vec4(0), cand[idx + 1u] = vec4(0);
		} else {
			cand[idx]      = vec4(a.x, a.yz / a.x, s_z[0]);
			cand[idx + 1u] = vec4(b.rgb / a.x, b.w);
		}
	}
}

// ---- 1 track ----
const int MAXB = 16;

void Track() {
	int   slots = int(hp.z);
	float dt    = clamp(push.motion.w, 0.001, 0.1);
	vec2  rs    = RenderSize();
	atomicAdd(stats[0], 1u);
	stats[14] = 0u; // (local-1029) the per-frame max lit radius (cm); mode 2 runs after this
	// Cluster: 8-connected cells of comparable depth.
	int   lab[NCELL];
	int   queue[NCELL];
	for (int i = 0; i < NCELL; ++i) lab[i] = -1;
	vec4  bw[MAXB]; // (weight, u, v, z)
	vec4  bc[MAXB]; // (rgb, taps)
	int   nb = 0;
	for (int i = 0; i < NCELL; ++i) {
		if (lab[i] >= 0 || cand[i * 2].x < 0.25) continue;
		int  head = 0, tail = 0;
		queue[tail++] = i;
		lab[i]        = 1;
		vec4 acc = vec4(0), accc = vec4(0);
		while (head < tail) {
			int  j  = queue[head++];
			vec4 cj = cand[j * 2];
			vec4 kj = cand[j * 2 + 1];
			acc += vec4(cj.x, cj.yz * cj.x, cj.w * cj.x);
			accc += vec4(kj.rgb * cj.x, kj.w);
			int jx = j % CW, jy = j / CW;
			for (int oy = -1; oy <= 1; ++oy)
				for (int ox = -1; ox <= 1; ++ox) {
					int nx = jx + ox, ny = jy + oy;
					if (nx < 0 || ny < 0 || nx >= CW || ny >= CH) continue;
					int k = ny * CW + nx;
					if (lab[k] >= 0) continue;
					vec4 ck = cand[k * 2];
					if (ck.x < 0.25 || abs(ck.w - cj.w) > max(1.5, 0.25 * cj.w)) continue;
					lab[k]          = 1;
					queue[tail++]   = k;
				}
		}
		if (acc.x < 0.5) continue;
		vec4 blob  = vec4(acc.x, acc.yz / acc.x, acc.w / acc.x);
		vec4 blobc = vec4(accc.rgb / acc.x, accc.w);
		// Keep the MAXB strongest (insertion).
		int at = nb < MAXB ? nb : -1;
		if (at < 0) {
			int weakest = 0;
			for (int k = 1; k < MAXB; ++k)
				if (bw[k].x < bw[weakest].x) weakest = k;
			if (bw[weakest].x < blob.x) at = weakest;
		} else {
			++nb;
		}
		if (at >= 0) bw[at] = blob, bc[at] = blobc;
	}
	atomicAdd(stats[1], uint(nb));
	// Power: the flame's world size (screen area x z^2 / focal^2) and brightness.
	float cellpx = (rs.x / float(CW * 8)) * (rs.y / float(CH * 8));
	float pw[MAXB];
	vec3  hu[MAXB];
	bool  claimed[MAXB];
	for (int b = 0; b < nb; ++b) {
		float area = bc[b].w * cellpx / (rs.x * rs.y * 0.25) * bw[b].w * bw[b].w / max(abs(push.proj.x * push.proj.y), 1e-6);
		float bri  = min(Luma(bc[b].rgb), 40.0);
		pw[b]      = clamp(6.0 * sqrt(area) * sqrt(bri / 4.0), 0.4, 6.0);
		vec3 h     = bc[b].rgb / max(Luma(bc[b].rgb), 1e-4);
		h          = 0.7 * h + 0.3;
		hu[b]      = h / max(Luma(h), 1e-4);
		claimed[b] = false;
	}
	// Match the tracked lights.
	int used = 0, flares = 0;
	for (int k = 0; k < 8; ++k) {
		vec4 l0 = lights[k * 4], l1 = lights[k * 4 + 1], l2 = lights[k * 4 + 2];
		if (k >= slots) {
			lights[k * 4] = vec4(0), lights[k * 4 + 1] = vec4(0), lights[k * 4 + 2] = vec4(0), lights[k * 4 + 3] = vec4(0);
			continue;
		}
		if (l0.w <= 0.0 && l2.w <= 0.0) continue;
		if (push.motion.z > 0.0 && all(greaterThan(l0.xy, vec2(0))) && all(lessThan(l0.xy, vec2(1))))
			l0.xy -= textureLod(motion_tex, l0.xy, 0).xy * push.motion.xy / rs;
		int   best = -1;
		float bd   = 3.5;
		for (int b = 0; b < nb; ++b) {
			if (claimed[b]) continue;
			float zr = bw[b].w / max(l0.z, 1e-3);
			if (zr < 0.5 || zr > 2.0) continue; // (stable-1028: the blob's nearest depth jitters; wider)
			float dist = length((bw[b].yz - l0.xy) * vec2(CW, CH));
			if (dist < bd) bd = dist, best = b;
		}
		float target_vis = 0.0;
		if (best >= 0) {
			claimed[best] = true;
			// (stable-1028) heavy smoothing: the blob's centroid and depth jitter with the flame's pixels; the light is held
			// still (the motion vectors carry it with the camera), position 0.6 s, depth 0.6 s, hue 2 s, power 4 s / 1 s
			l0.xy = mix(l0.xy, bw[best].yz, 1.0 - exp(-dt / 0.6));
			l0.z  = mix(l0.z, bw[best].w, 1.0 - exp(-dt / 0.6));
			l0.w  = min(1.0, l0.w + dt / 0.5);
			l1.rgb = mix(l1.rgb, hu[best], 1.0 - exp(-dt / 2.0));
			l1.w   = mix(l1.w, pw[best], 1.0 - exp(-dt / 4.0));
			l2.x   = mix(l2.x, pw[best], 1.0 - exp(-dt / 1.0));
			l2.w   = 0.0;
			target_vis = 1.0;
		} else {
			// (stable-1028) a fire missed holds 2 s (the detection finds a torch on ~half the frames), then fades over 1 s
			l2.w += dt;
			// (local-1029) probation: a light not yet faded in (seen < ~0.35 s: an ember, a glint, a one-frame false
			// detection) is dropped in 0.2 s instead of holding 3 s; a confirmed torch keeps the 2 s hold (no new popping)
			if (l0.w < 0.7 && l2.w > 0.1) l0.w = max(0.0, l0.w - dt / 0.2);
			else if (l2.w > 2.0) l0.w = max(0.0, l0.w - dt / 1.0);
			l2.x = mix(l2.x, l1.w, 1.0 - exp(-dt / 1.0));
		}
		// The flicker: the fast power over the slow one, clamped and eased (no frame-to-frame noise).
		// (natural-1028) the blob's own brightness (fast / slow, +-6 %) and two slow incommensurate sines per slot
		// (0.31 / 0.83 Hz, +-3 % / +-2 %), clamped 0.9..1.1, then low-passed (0.25 s): no frame-to-frame jumps.
		// (stable-1028) nearly steady, like a real torch: the blob's own swing +-1.5 %, two very slow sines (0.11 / 0.23 Hz,
		// +-1 % each), total 0.97..1.03, low-passed 0.6 s
		float tt  = push.flare.z + float(k) * 1.7;
		float org = 0.01 * sin(6.2831853 * 0.11 * tt) + 0.01 * sin(6.2831853 * 0.23 * tt + 1.3);
		float fl  = clamp(1.0 + clamp(l2.x / max(l1.w, 1e-3) - 1.0, -0.015, 0.015) + org, 0.97, 1.03);
		l2.y      = mix(l2.y <= 0.0 ? 1.0 : l2.y, fl, 1.0 - exp(-dt / 0.6));
		// The flare's source must be in view: the depth around it no nearer than the fire (a wall, a character in front).
		if (target_vis > 0.0) {
			float seen = 0.0;
			for (int t = 0; t < 9; ++t) {
				vec2 o = vec2(float(t % 3) - 1.0, float(t / 3) - 1.0) * 2.0 / rs;
				float d = DepthAt(clamp(l0.xy + o, vec2(0), vec2(1)));
				float zz = IsSky(d) ? 1e6 : ViewZ(d);
				seen += zz >= l0.z * 0.9 - 0.5 ? 1.0 : 0.0;
			}
			target_vis = seen / 9.0;
		}
		l2.z = clamp(l2.z + clamp(target_vis - l2.z, -dt / 0.35, dt / 0.35), 0.0, 1.0); // (the flare fades over 0.35 s)
		if (l0.w <= 0.0 && l2.z <= 0.0) {
			lights[k * 4] = vec4(0), lights[k * 4 + 1] = vec4(0), lights[k * 4 + 2] = vec4(0), lights[k * 4 + 3] = vec4(0);
			continue;
		}
		vec3 pos = ViewPosZ(l0.xy, l0.z);
		pos -= normalize(pos) * 0.3; // (the flame in front of what it is drawn on)
		lights[k * 4]     = l0;
		lights[k * 4 + 1] = l1;
		lights[k * 4 + 2] = l2;
		lights[k * 4 + 3] = vec4(pos, l1.w * l2.y);
		++used;
		if (l2.z > 0.05) ++flares;
	}
	// New lights: the strongest unclaimed blobs take free slots.
	for (int k = 0; k < slots; ++k) {
		if (lights[k * 4].w > 0.0 || lights[k * 4 + 2].z > 0.0) continue;
		int best = -1;
		for (int b = 0; b < nb; ++b) {
			if (claimed[b] || (best >= 0 && bw[b].x <= bw[best].x)) continue;
			if (bw[b].x < 1.0) continue; // (local-1029) a new light needs a real flame (>= ~1 full cell of fire), not a speck
			// (stable-1028) never a second light on a fire already tracked (a duplicate popped in and out: lights 2.7 a
			// frame for 0.8 blobs)
			bool near = false;
			for (int j = 0; j < 8; ++j)
				if ((lights[j * 4].w > 0.0 || lights[j * 4 + 2].w > 0.0) && length((bw[b].yz - lights[j * 4].xy) * vec2(CW, CH)) < 5.0) near = true;
			if (!near) best = b;
		}
		if (best < 0) break;
		claimed[best] = true;
		vec3 pos = ViewPosZ(bw[best].yz, bw[best].w);
		pos -= normalize(pos) * 0.3;
		lights[k * 4]     = vec4(bw[best].yz, bw[best].w, dt / 0.5);
		lights[k * 4 + 1] = vec4(hu[best], pw[best]);
		lights[k * 4 + 2] = vec4(pw[best], 1.0, 0.0, 0.0);
		lights[k * 4 + 3] = vec4(pos, pw[best]);
		++used;
	}
	atomicAdd(stats[2], uint(used));
	atomicAdd(stats[3], uint(flares));
}

// ---- 2 light ----
// (gpu-1028) the shadow passes run at half resolution (push.dec.z: the shift): their pixel p <-> the full pixel FullPx(p)
int   Shift() { return push.dec.z; }
ivec2 TraceSize() { return (ivec2(RenderSize()) + (1 << Shift()) - 1) >> Shift(); }
ivec2 FullPx(ivec2 p) { return min(p << Shift(), ivec2(RenderSize()) - 1); }
float Ign(vec2 p) { return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715)))); }

// The light's visibility from p (view space) toward lp: 1 lit, 0 occluded; unc: 1 when some sample could not tell
// (off-screen, or behind a surface nearer by more than the thickness).
float March(vec3 p, vec3 lp, int max_steps, float jit, out float unc) {
	unc = 0.0;
	vec2 s0, s1;
	if (!Project(p, s0)) return 1.0;
	bool l_on = Project(lp, s1);
	vec2  rs   = RenderSize();
	float slen = l_on ? length((s1 - s0) * rs) : 1e4;
	float n    = clamp(ceil(slen / 5.0), 4.0, float(max_steps));
	float occ  = 0.0;
	float z0 = p.z, z1 = lp.z;
	for (int s = 0; s < max_steps; ++s) {
		if (float(s) >= n) break;
		float f  = 0.03 + 0.94 * (float(s) + jit) / n;
		// (the 3D t whose projection is the screen fraction f: uniform steps on screen)
		float t  = l_on ? f * z0 / max((1.0 - f) * z1 + f * z0, 1e-4) : f;
		vec3  pt = mix(p, lp, t);
		vec2  uv;
		if (!Project(pt, uv) || any(lessThan(uv, vec2(0))) || any(greaterThan(uv, vec2(1)))) {
			unc = 1.0;
			continue;
		}
		float d = DepthAt(uv);
		if (IsSky(d)) continue;
		float dd   = pt.z - ViewZ(d);
		float bias = 0.03 + 0.004 * pt.z;
		float T    = clamp(0.4 + 0.08 * pt.z, 0.4, 3.0);
		if (dd > T) unc = 1.0;
		occ = max(occ, Sat((dd - bias) / bias) * Sat((T - dd) / (0.25 * T)));
		if (occ >= 0.999) break;
	}
	return 1.0 - occ;
}

// (local-1029) The one geometric test of modes 2 and 4 (so W and the light agree): a hard WORLD-space cutoff R
// (push.light.x m, KYTY_TORCH_RADIUS) with a windowed inverse-square falloff that reaches 0 at R; N.L > 0; no
// self-contact (< 0.45 m from the flame: the torch's own bracket, the hand holding it); the background well behind
// the flame rejected on its depth; the player's own body never lit by a light it carries (rej = 1).
// out att: the falloff (0: no light), l: unit vector to the light, dist (m).
bool PlayerPx(vec2 uv, float z) { return z < 3.5 && abs(uv.x - 0.5) < 0.2 && uv.y > 0.2 && uv.y < 0.98; }
bool Carried(vec3 lp) {
	vec2 luv;
	return lp.z < 3.0 && Project(lp, luv) && abs(luv.x - 0.5) < 0.3 && luv.y > 0.1 && luv.y < 0.98;
}
float Falloff(vec3 pos, vec3 N, vec3 lp, bool player, out vec3 l, out float dist, out float ndl, out int rej) {
	rej = 0, ndl = 0.0;
	vec3 L = lp - pos;
	dist   = length(L);
	l      = L / max(dist, 1e-4);
	float R = push.light.x;
	if (dist >= R) return 0.0;
	if (pos.z - lp.z > 0.6 * R) return 0.0;              // (far background behind the flame)
	if (dist < 0.45 || (player && dist < 1.3 && pos.z < lp.z + 0.3 && Carried(lp))) { rej = 1; return 0.0; } // (the body around a carried flame, not the wall behind it)
	ndl = dot(N, l);
	if (ndl <= 0.0) return 0.0;
	float x   = dist / R;
	float win = Sat(1.0 - x * x * x * x);
	return win * win / (dist * dist + 1.0);
}

void Shadow(ivec2 p) {
	vec2  rs = RenderSize();
	if (any(greaterThanEqual(p, TraceSize()))) return;
	ivec2 fp = FullPx(p);
	float d  = texelFetch(depth_tex, fp, 0).r;
	float z  = IsSky(d) ? 1e6 : ViewZ(d);
	if (IsSky(d) || z > push.light.w) {
		imageStore(aux_img, p, vec4(1.0, 0.0, 0.0, z));
		return;
	}
	vec2  uv   = (vec2(fp) + 0.5) / rs;
	vec3  pos  = ViewPosZ(uv, z);
	vec3  N    = NormalAt(fp, pos);
	bool  player = PlayerPx(uv, z);
	int   fr   = push.misc.y;
	float jit  = fract(Ign(vec2(p) + 5.588238 * float(fr & 63)));
	float ja   = fract(Ign(vec2(p.y, p.x) + 11.0 * float(fr & 63)) + 0.3);
	float jr   = fract(jit + 0.618034 * float(fr & 255));
	float jp   = fract(Ign(vec2(p) * 1.7 + 3.1 * float(fr & 63)) + 0.5);
	float W = 0.0, Wv = 0.0, U = 0.0;
	float wk[8], uk[8];
	for (int k = 0; k < 8; ++k) {
		wk[k] = 0.0, uk[k] = 0.0;
		vec4 l0 = lights[k * 4];
		if (l0.w <= 0.0) continue;
		vec4  l3  = lights[k * 4 + 3];
		float pwr = l3.w * l0.w;
		if (pwr <= 0.0) continue;
		vec3  l;
		float dist, ndl;
		int   rj;
		float att = Falloff(pos, N, l3.xyz, player, l, dist, ndl, rj);
		if (att <= 0.0) continue;
		float w   = Luma(lights[k * 4 + 1].rgb) * pwr * att * ndl;
		if (w <= 0.0) continue;
		// a point on the flame's disc, facing the receiver (the penumbra; resolved by the temporal pass)
		vec3  b1  = normalize(cross(l, abs(l.y) < 0.9 ? vec3(0, 1, 0) : vec3(1, 0, 0)));
		vec3  b2  = cross(l, b1);
		float a   = 6.2831853 * ja;
		vec3  tgt = l3.xyz + (b1 * cos(a) + b2 * sin(a)) * (0.1 * sqrt(jr));
		float u;
		float v = March(pos + N * 0.03, tgt, int(push.light.z), jit, u);
		W += w, Wv += w * v, U += w * u;
		wk[k] = w, uk[k] = w * u;
	}
	// The hybrid's pick among the inconclusive lights (probability uk / U).
	int   pick = 0;
	float acc  = 0.0, target = jp * U;
	for (int k = 0; k < 8; ++k) {
		if (uk[k] <= 0.0) continue;
		pick = k;
		acc += uk[k];
		if (acc >= target) break;
	}
	float ratio = W > 0.0 ? Wv / W : 1.0;
	float share = W > 0.0 ? min(U / W, 0.99) : 0.0;
	if ((p.x & 1) == 0 && (p.y & 1) == 0 && W > 0.0) {
		atomicAdd(stats[6], 1u);
		if (share > 0.02) atomicAdd(stats[7], 1u);
	}
	imageStore(aux_img, p, vec4(ratio, W, float(pick) + share, z));
}

// (denoise-1028) Temporal: the history reprojected with the motion vectors, rejected on a depth mismatch, clamped to
// this frame's 3x3 mean +- (1.25 sigma + 0.03) (variance-guided: a moving shadow is followed, a still one converges),
// alpha max(1 / n, 1 / 24). Out: (ratio, n (0: no torch light here), variance estimate, z).
void Temporal(ivec2 p) {
	vec2  rs = RenderSize();
	ivec2 sz = TraceSize();
	if (any(greaterThanEqual(p, sz))) return;
	vec4 cur = texelFetch(src_tex, p, 0);
	if (cur.y <= 0.0) {
		imageStore(aux_img, p, vec4(1.0, 0.0, 0.0, cur.w));
		return;
	}
	float m1 = 0.0, m2 = 0.0, cnt = 0.0;
	for (int y = -1; y <= 1; ++y)
		for (int x = -1; x <= 1; ++x) {
			vec4 q = texelFetch(src_tex, clamp(p + ivec2(x, y), ivec2(0), sz - 1), 0);
			if (q.y <= 0.0 || abs(q.w - cur.w) > 0.05 * cur.w + 0.05) continue;
			m1 += q.x, m2 += q.x * q.x, cnt += 1.0;
		}
	m1 /= max(cnt, 1.0), m2 /= max(cnt, 1.0);
	float sigma = sqrt(max(m2 - m1 * m1, 0.0));
	float r = cur.x, n = 1.0, var = sigma * sigma;
	if (push.motion.z > 0.0) {
		vec2 uv  = (vec2(FullPx(p)) + 0.5) / rs;
		vec2 puv = uv - textureLod(motion_tex, uv, 0).xy * push.motion.xy / rs;
		if (all(greaterThan(puv, vec2(0))) && all(lessThan(puv, vec2(1)))) {
			vec4 h = texelFetch(hist_tex, clamp(ivec2(puv * rs) >> Shift(), ivec2(0), sz - 1), 0);
			if (h.y > 0.0 && abs(h.w - cur.w) < 0.1 * cur.w + 0.05) {
				float g  = 1.25 * sigma + 0.03;
				float hr = clamp(h.x, m1 - g, m1 + g);
				n        = min(h.y + 1.0, 24.0);
				float al = max(1.0 / n, 1.0 / 24.0);
				r        = mix(hr, cur.x, al);
				var      = mix(h.z, sigma * sigma, al) ; // (the variance follows the same average: the a-trous' stop)
			}
		}
	}
	if ((p.x & 1) == 0 && (p.y & 1) == 0) {
		atomicAdd(stats[10], uint(n));
		if (r < 0.5) atomicAdd(stats[11], 1u);
	}
	imageStore(aux_img, p, vec4(Sat(r), n, var, cur.w));
}

// (denoise-1028) Spatial: one a-trous iteration (push.flare.w: the step, 1 / 2 / 4), 5x5 B3 kernel, edge-stopping on
// depth (relative), normal (G-buffer / depth normals, cos^32) and the ratio itself against the variance (the luminance
// stop of SVGF: a contact shadow's edge stays sharp where the history agrees). Pixels without torch light (n = 0) and
// other surfaces (characters in front) never mix in. Keeps (ratio, n, variance / 2 per pass, z).
void Spatial(ivec2 p) {
	vec2  rs = RenderSize();
	ivec2 sz = TraceSize();
	if (any(greaterThanEqual(p, sz))) return;
	vec4 c = texelFetch(src_tex, p, 0);
	if (c.y <= 0.0) {
		imageStore(aux_img, p, c);
		return;
	}
	int   step = max(int(push.flare.w), 1);
	vec3  np   = NormalAt(FullPx(p), ViewPosZ((vec2(FullPx(p)) + 0.5) / rs, c.w));
	float sd   = sqrt(max(c.z, 0.0)) * 4.0 + 0.02;
	// (fewer accumulated frames: the luminance stop is looser)
	sd *= mix(3.0, 1.0, Sat((c.y - 1.0) / 8.0));
	const float kw[3] = float[3](0.375, 0.25, 0.0625);
	float sum = 0.0, ws = 0.0, vs = 0.0;
	for (int y = -2; y <= 2; ++y)
		for (int x = -2; x <= 2; ++x) {
			ivec2 q = p + ivec2(x, y) * step;
			if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, sz))) continue;
			vec4 v = texelFetch(src_tex, q, 0);
			if (v.y <= 0.0) continue;
			float w = kw[abs(x)] * kw[abs(y)];
			w *= exp(-abs(v.w - c.w) / (0.01 * c.w * float(step) + 0.01));
			if (x != 0 || y != 0) {
				vec3 nq = NormalAt(FullPx(q), ViewPosZ((vec2(FullPx(q)) + 0.5) / rs, v.w));
				w *= pow(max(dot(np, nq), 0.0), 32.0);
				w *= exp(-abs(v.x - c.x) / sd);
			}
			sum += v.x * w, vs += v.z * w * w, ws += w;
		}
	float r = ws > 0.0 ? sum / ws : c.x;
	imageStore(aux_img, p, vec4(r, c.y, ws > 0.0 ? vs / (ws * ws) : c.z, c.w));
}

void Light(ivec2 p) {
	vec2  rs = RenderSize();
	ivec2 sz = ivec2(rs);
	if (any(greaterThanEqual(p, sz))) return;
	vec3  c  = Safe(texelFetch(color_tex, p, 0).rgb);
	float d  = texelFetch(depth_tex, p, 0).r;
	bool  sample_px = (p.x & 3) == 0 && (p.y & 3) == 0;
	if (sample_px) atomicAdd(stats[4], 1u);
	bool debug = (push.misc.z & 8) != 0;
	float zmax = push.light.w;
	float z    = IsSky(d) ? 1e6 : ViewZ(d);
	if (IsSky(d) || z > zmax) {
		imageStore(out_img, p, vec4(debug ? vec3(0) : c, 1.0));
		return;
	}
	float e     = GameExposure();
	vec2  uv    = (vec2(p) + 0.5) / rs;
	vec3  pos   = ViewPosZ(uv, z);
	vec3  N     = NormalAt(p, pos);
	vec3  V     = normalize(-pos);
	vec3  alb   = AlbedoAt(p, c);
	float rough = Gbuf() ? clamp(Field(push.dec.y, p), 0.25, 1.0) : 0.6;
	float selfw = FireW(c * e, z, alb);
	vec3  diff  = vec3(0), spec = vec3(0);
	// (gpu-1028) the half-resolution visibility, upsampled with depth weights (no bleeding across a character's edge)
	float shade;
	{
		ivec2 ts = textureSize(src_tex, 0);
		vec2  hp = (vec2(p) + 0.5) / float(1 << push.dec.z) - 0.5;
		ivec2 b  = ivec2(floor(hp));
		vec2  f  = hp - vec2(b);
		float sw = 0.0, sv = 0.0, bestd = 1e9, bestv = 1.0;
		for (int t = 0; t < 4; ++t) {
			ivec2 o  = ivec2(t & 1, t >> 1);
			vec4  q  = texelFetch(src_tex, clamp(b + o, ivec2(0), ts - 1), 0);
			float dz = abs(q.w - z);
			float w  = (o.x == 1 ? f.x : 1.0 - f.x) * (o.y == 1 ? f.y : 1.0 - f.y) * exp(-dz / (0.02 * z + 0.02));
			sw += w, sv += w * q.x;
			if (dz < bestd) bestd = dz, bestv = q.x;
		}
		shade = Sat(sw > 1e-3 ? sv / sw : bestv);
	}
	// (local-1029) the visibility test first: a pixel the shadow pass sees fully occluded gets nothing (and costs nothing)
	if (shade <= 0.02) {
		imageStore(out_img, p, vec4(debug ? vec3(0) : c, 1.0));
		return;
	}
	bool  player = PlayerPx(uv, z);
	bool  selfrej = false;
	float bestE = 0.0, bestd = 0.0;
	for (int k = 0; k < 8; ++k) {
		vec4 l0 = lights[k * 4];
		if (l0.w <= 0.0) continue;
		vec4  l3  = lights[k * 4 + 3];
		float pwr = l3.w * l0.w;
		if (pwr <= 0.0) continue;
		vec3  l;
		float dist, ndl;
		int   rj;
		float att = Falloff(pos, N, l3.xyz, player, l, dist, ndl, rj);
		if (rj != 0) selfrej = true;
		if (att <= 0.0) continue;
		if (att * pwr > bestE) bestE = att * pwr, bestd = dist;
		float vis = 1.0; // (the occlusion: the filtered ratio below)
		// A flicker that also shifts the hue: brighter = a little more yellow.
		float fl  = lights[k * 4 + 2].y;
		vec3  hue = lights[k * 4 + 1].rgb * mix(vec3(1.0), vec3(0.94, 1.06, 1.1), Sat((fl - 1.0) * 4.0));
		vec3  E   = hue * pwr * att * vis;
		diff += E * ndl;
		vec3  H   = normalize(l + V);
		float ndh = Sat(dot(N, H));
		float a2  = rough * rough * rough * rough;
		float den = ndh * ndh * (a2 - 1.0) + 1.0;
		float D   = min(a2 / (PI * den * den), 8.0);
		spec += E * ndl * D;
	}
	vec3  add  = (alb * diff * 3.0 + spec * push.light.y) * push.size.z * (1.0 - selfw) * shade;
	add *= 1.0 - smoothstep(zmax * 0.6, zmax, z); // (fog and distant walls stay as drawn)
	if (player && z < 3.0) add *= 0.5; // (local-1029) characters near the camera: the light is for the environment
	float al   = Luma(add);
	float cap  = push.size.w;
	add /= 1.0 + al / max(cap, 1e-3); // (soft cap, hue-preserving)
	add  = Safe(add);
	if (sample_px && Luma(add) > 0.01) {
		atomicAdd(stats[5], 1u);
		uint cm = uint(bestd * 100.0 + 0.5);
		atomicAdd(stats[13], cm);
		atomicMax(stats[14], cm);
		if (bestd > 4.0) atomicAdd(stats[15], 1u);
	}
	if (sample_px && selfrej) atomicAdd(stats[12], 1u);
	imageStore(out_img, p, vec4(debug ? add / e : c + add / e, 1.0));
}

// ---- 3 flare ----
float Ring(float r, float rad, float w) {
	float x = (r - rad) / w;
	return exp(-x * x);
}
float Disc(float r, float rad) {
	// A soft-edged aperture ghost, a little brighter toward its rim.
	float edge = Sat((rad - r) / (rad * 0.3));
	return edge * (0.55 + 0.45 * Sat(r / rad) * Sat(r / rad));
}

void Flare(ivec2 p) {
	vec2  rs = RenderSize();
	if (any(greaterThanEqual(p, ivec2(rs)))) return;
	vec3  c   = Safe(texelFetch(color_tex, p, 0).rgb);
	float e   = GameExposure();
	vec2  uv  = (vec2(p) + 0.5) / rs;
	float asp = push.flare.y;
	vec3  fl  = vec3(0);
	for (int k = 0; k < 8; ++k) {
		vec4  l2  = lights[k * 4 + 2];
		if (l2.z <= 0.01) continue;
		vec4  l0  = lights[k * 4];
		vec2  s   = l0.xy;
		float edge = Smooth01(min(min(s.x, 1.0 - s.x), min(s.y, 1.0 - s.y)) / 0.12);
		float I    = l2.z * edge * min(lights[k * 4 + 3].w, 4.0) / 4.0 * 0.5 * push.flare.x;
		if (I <= 0.003) continue;
		vec3  hue  = lights[k * 4 + 1].rgb;
		vec2  axis = vec2(0.5) - s;
		vec2  q    = (uv - s) * vec2(asp, 1.0);
		float r    = length(q);
		// Starburst (6 thin spokes, tiny) and a short anamorphic streak.
		float ang  = atan(q.y, q.x);
		float star = pow(abs(cos(3.0 * (ang + 0.35))), 120.0) * exp(-r / 0.014) * 0.18;
		float strk = exp(-abs(q.y) / 0.0012) * exp(-abs(q.x) / 0.06) * 0.10;
		fl += I * (star + strk) * hue;
		// Ghosts along the axis through the centre (aperture discs, tinted like coated glass).
		fl += I * 0.100 * Disc(length((uv - (s + axis * 0.45)) * vec2(asp, 1.0)), 0.020) * vec3(1.0, 0.55, 0.2);
		fl += I * 0.060 * Disc(length((uv - (s + axis * 1.25)) * vec2(asp, 1.0)), 0.034) * vec3(0.5, 0.8, 1.0);
		fl += I * 0.120 * Disc(length((uv - (s + axis * 1.62)) * vec2(asp, 1.0)), 0.012) * vec3(1.0, 0.7, 0.3);
		fl += I * 0.035 * Disc(length((uv - (s + axis * 2.10)) * vec2(asp, 1.0)), 0.055) * vec3(0.7, 1.0, 0.6);
		// A faint, thin ring.
		fl += I * 0.015 * Ring(length((uv - (s + axis * 1.45)) * vec2(asp, 1.0)), 0.11, 0.004) * hue * vec3(1.0, 0.9, 0.8);
	}
	fl = min(Safe(fl), vec3(0.6)); // (exposed: a flare never whites out a region)
	bool debug = (push.misc.z & 8) != 0;
	imageStore(out_img, p, vec4(debug ? c + fl / e : c + fl / e, 1.0));
}

void main() {
	int mode = push.misc.x;
	if (mode == 0) Detect(gl_WorkGroupID, gl_LocalInvocationIndex);
	else if (mode == 1) {
		if (gl_LocalInvocationIndex == 0u) Track();
	} else if (mode == 2) Light(ivec2(gl_GlobalInvocationID.xy));
	else if (mode == 4) Shadow(ivec2(gl_GlobalInvocationID.xy));
	else if (mode == 5) Temporal(ivec2(gl_GlobalInvocationID.xy));
	else if (mode == 7) Spatial(ivec2(gl_GlobalInvocationID.xy));
	else Flare(ivec2(gl_GlobalInvocationID.xy));
}
