#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
// KYTY_RT_REFLECTIONS (rt-reflections.cpp): screen-space ray-traced reflections with denoising on the PS5 Pro path's
// render-resolution color, recorded right before the upscaler (DLSS / XeSS / FSR) with its inputs: the game's depth,
// motion vectors, the pre-exposure lit HDR color (the game's exposure is applied after the upscale; read here from its
// own buffer so every threshold below works on display-referred values), the upscaler's view_to_clip.
//
// Modes (push.misc.x):
//   6 hi-z 0:    linear view distance of every render pixel (sky: far) into the hi-z pyramid's mip 0
//   7 hi-z down: mip push.dec.w = min (closest) of the 2x2 below it (odd sizes: the edge texel kept)
//   5 calib:     160x90 grid: every packed G-buffer layer x 5 normal layouts scored against the depth normal (view and
//                world space), byte field statistics (the CPU picks the decode, rt-reflections.cpp)
//   (refl3: no edge stretching, hits validated by depth / silhouette / facing, water a mirror at full resolution)
//   0 trace:     GGX VNDF-sampled reflection ray (the surface's roughness), hierarchical-Z march over the closest-depth
//                pyramid (thickness slab, sub-pixel hit), confidence = screen-edge fade x back-face x toward-camera fade;
//                misses and the sky give confidence 0 (the game's own reflection stays). Out: premultiplied
//                (tonemapped exposed color x confidence, confidence), (view normal, distance), (roughness, mask, hit
//                distance, hit flag)
//   1 temporal:  history reprojected by the surface's motion vector plus the reflection's parallax (the virtual image
//                point behind the mirror, through the camera's clip -> previous clip, used only where it agrees with the
//                motion vector), disocclusion rejection (distance, normal), YCoCg neighbourhood clamp (wider for rough
//                surfaces), history length and luminance moments
//   2 a-trous:   5x5 edge-aware filter (distance, normal, roughness, variance-guided luminance), radius by roughness and
//                hit distance (contact reflections stay sharp, mirrors untouched)
//   4 composite: bilateral upsample; the reflection replaces a Fresnel (Schlick with roughness) x mask x confidence share
//                of the game's color (a convex mix, never added on top), the game's own highlights kept
// (refl8) Guided by the game (misc.w & 512, the default): the game's own SSR result (binding 21, a half-resolution input
// of its deferred lighting; rgb its reflected color, a its confidence) decides which surfaces reflect and how much. Our
// sharper ray replaces only the game's SSR color, at the game's share (its confidence x a Fresnel): the color changes by
// strength x Fresnel x a x ours' confidence x (ours - the game's). Where our ray misses or leaves the screen, or the game
// has no confident SSR, the game's pixel stays unchanged (its IBL fallback included): no material guesses. Water (drawn
// after the lighting, so not in the game's SSR) keeps its depth-detected mirror. The roughness field only narrows where
// we sharpen (mirror-like), never adds a reflection.
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D color_tex;
layout(binding = 1) uniform sampler2D depth_tex;
layout(binding = 2) uniform sampler2D motion_tex;
layout(binding = 3) uniform sampler2D hiz_tex;
layout(binding = 4, r32f) uniform writeonly image2D hiz_out;
layout(binding = 5) uniform sampler2D src_a;
layout(binding = 6) uniform sampler2D src_b;
layout(binding = 7) uniform sampler2D gb_cur;
layout(binding = 8) uniform sampler2D gb_prev;
layout(binding = 9) uniform sampler2D aux_tex;
layout(binding = 10) uniform sampler2D meta_tex;
layout(binding = 11, rgba16f) uniform writeonly image2D out_a;
layout(binding = 12, rgba16f) uniform writeonly image2D out_b;
layout(binding = 13, rgba16f) uniform writeonly image2D out_c;
layout(binding = 14) uniform usampler2D packed0;
layout(binding = 15) uniform usampler2D packed1;
layout(binding = 16) uniform usampler2D packed2;
layout(binding = 17) uniform usampler2D packed3;
layout(std430, binding = 18) buffer Frame {
	vec4 view_rot[3];  // world -> view rotation rows
	vec4 clip_prev[4]; // rows of the current clip -> previous clip matrix (column vectors)
	vec4 up_view;      // world up in view space
	vec4 fparams;      // x: 1.0 (the exposure when the game gives none), y: wet surfaces' minimum reflectance,
	                   // z: the longest ray on screen (render pixels; 0 none), w: the puddle guess's scale
	vec4 mparams;      // the material roughness: x mirror below, y nothing from (perceptual roughness), z the material's
	                   // strength scale (refl6)
	vec4 gparams;      // (refl8) the guide: x / y the game's SSR confidence from which / to which it counts as a reflection,
	                   // z 1: its rgb premultiplied by a, w the guided strength (1: the game's own)
	vec4 xparams;      // (refl9) x the metal reflection's strength (KYTY_RT_REFLECTIONS_METAL), y the glossy surfaces'
	                   // (KYTY_RT_REFLECTIONS_GLOSSY), z how much of the albedo's hue tints a metal's reflection, w the albedo
	                   // layer (L0 bits 0..23 as sRGB rgb; < 0 none)
	vec4 yparams;      // (refl9b) x the minimum reflective area's radius (render pixels; 0 off: KYTY_RT_REFLECTIONS_MIN_AREA),
	                   // y the large pools' boost (KYTY_RT_REFLECTIONS_POOL_BOOST), (refl-sharp-1031) z the sharpness
	                   // (0 normal: as before, 1 alta, 2 maxima), w the water's waves in the reflection rays (0 as now, 1 soft, 2 mirror)
	vec4 rparams;      // (rt4) x the fill's scale (the game's specular IBL -> the radiance our hits see, calibrated from the data),
	                   // y the fill's model (0 the IBL image as radiance, 1 divided by the split-sum BRDF), z the fill's
	                   // strength (0: no fill yet / off), w the normal-variance (Toksvig) share added to the lobe
	int  calib[];      // see CALIB_* below (calibration sums, then the cumulative stats counters)
};
// calib[] layout (ints): [0] samples; [CALIB_NORMAL + ((layer * NLAYOUTS + layout) * 2 + space) * 2 + convention] sum of
// cos * 1000 (convention 0: the screen y convention in use, 1: mirrored); [CALIB_BYTES + field * 3 + k] byte stats;
// [CALIB_FLOORS + convention] up-facing depth normals (world up known); [CALIB_WET] puddle-guess pixels, then 16 byte
// field sums there, [CALIB_WET + 17] water pixels, then 16 byte field sums there (to find a material field);
// [STATS + k] cumulative counters, never cleared (1/16 of the pixels: 0 composite pixels (not sky), 1 weight > 0.05,
// 2 sum of weight * 1000, 3 reflective mask > 0.05, 4 rays traced, 5 ray hits, 6 G-buffer normal used, 7 water,
// 8 final depth != the G-buffer-time depth by > 2 %, 9..12 material roughness (the rougher of the roughness and 1 - gloss
// fields) < 0.1, 0.1..0.25, 0.25..0.4, >= 0.4, 13..16 the same for the roughness field alone, 17 moving (a character), 18
// metal > 0.5, 19 weight > 0.05 where the roughness < 0.1; refl8, the guide: 20 the game's SSR confidence > gparams.x, 21
// our hit replaced > 5 % of the game's SSR, 22 sum of its confidence * 1000, 23 water with our mirror (weight > 0.05),
// 24 its rgb set where its confidence is not; refl9: 25 metal > 0.5 (G-buffer surface), 26 glossy > 0.5 (not metal),
// 27 sum of the metal / glossy paths' added weight * 1000, 28 metal with an added weight > 0.05, 29 glossy with one > 0.05;
// 30 / 31 the flash fix, 32 / 33 moving; water-1030, water and mirror pools: 34 points probed on a still camera, 35 changed
// > 10 % of the pixel's light from the last frame, 36 > 20 %, 37 the largest jump (atomicMax, 1e-4 of the light; cleared
// every 10 s by the CPU), 38 the 3x3 clamp acted, 39 a miss filled from its hits);
// [CALIB_HIST + field * 16 + bin] byte histograms;
// [SURVEY ...] (refl9) the metal survey (mode 8, never cleared): [0] static G-buffer samples, [1] moving (characters),
// [2 + class * 128 + layer * 32 + bit] set-bit counts, [258 + class * 256 + field * 16 + bin] byte histograms (class 0
// static, 1 moving).

// (The buffer is device-local, copied to a host buffer once a frame: atomics on host memory cross PCIe one by one, which
// made the composite cost 3-4 ms in the 10-24 b7dd0fe6 build.)
const int NLAYOUTS     = 13;
const int CALIB_NORMAL = 1;
const int CALIB_BYTES  = CALIB_NORMAL + 4 * NLAYOUTS * 4;
const int CALIB_FLOORS = CALIB_BYTES + 16 * 3;
const int CALIB_WET    = CALIB_FLOORS + 2;
const int CALIB_HIST   = 300;
const int STATS        = 560;
const int SURVEY       = 600;
const int WSTATS       = 1400; // (water2-1030) [0] shown change > 10 %, [1] > 20 %, [2] its max (atomicMax, cleared every 10 s)
// (des-refl2-1108) PSTATS: which path the floors' reflection pixels take (1/16 of the render pixels, up-facing floors;
// cumulative, never cleared; the CPU logs the difference every second, "RT reflections: floor paths"): see PathStat
const int PSTATS       = 1404;
layout(std430, binding = 19) readonly buffer Exposure {
	float exposure_values[];
};
layout(binding = 20) uniform sampler2D gdepth; // the depth when the deferred lighting ran (misc.w & 64), before water
layout(binding = 21) uniform sampler2D game_ssr; // (refl8) the game's own SSR result (misc.w & 256), half resolution
// (rt4) The game's whole specular reflection, kRTT_SpecularIBL_HalfResX (misc.w & 524288): written by the same CS as the guide
// (9fb5cc274b5e4f82, IBLRendering: its SSR blended with the local box-projected cubemaps and the distant one), half width.
layout(binding = 22) uniform sampler2D spec_ibl;
// (rpost1: KYTY_REFL_POST) mode 4: this frame's reflection light added (the positive part of the change, render size);
// mode 9: the upscaler's result (its size), the added light put on it after the upscale. Never read otherwise.
layout(binding = 23, rgba16f) uniform image2D post_img;

layout(push_constant) uniform Push {
	vec4  proj;      // M[0], M[5], M[8], M[9]
	vec4  depth_map; // A = M[10], B = M[14], C = M[11], D = M[15]
	vec4  size;      // render w, h, trace w, h
	vec4  params;    // strength, thickness (view units), max ray length (view units), a-trous step
	vec4  motion;    // motion scale x, y, roughness cutoff, temporal minimum alpha scale
	ivec4 misc;      // mode, frame, level, flags (1 reset, 2 history valid, 4 camera matrices, 8 up known, 16 row 0 = NDC y +1,
	                 // 32 checkerboard trace: half the trace pixels march each frame, the others keep their history,
	                 // 64 the G-buffer-time depth is bound: water detection, 128 moving objects (characters) skipped,
	                 // 256 the game's SSR (binding 21) bound, 512 guided by the game: no material or guess mask,
                 // 1024 (rtfly-1029) the firefly limit and the contribution's stabilisation: Firefly / Stabilize,
                 // 2048 (water-1030) water / mirror pools held steady: WaterStable, 4096 the camera holds still (stats))
	ivec4 dec;       // normal code (-1: depth normals), roughness field (-1: heuristic), packed layers, mode 7: the hi-z mip,
	                 // else the gloss field (-1 none; its code inverts it: 1 - gloss)
	ivec4 misc2;     // exposure index, hi-z levels, max iterations, metal field + 1 (0: none, f0 0.04)
} push;

const float PI  = 3.14159265;
const float FAR = 1.0e5;
// The composite's largest darkening of the game's color (a share of its luminance; see Composite).
const float MaxDarken = 0.25;

vec2 RenderSize() { return push.size.xy; }
// The screen's y convention: the game's viewport (GNM, yscale < 0) puts NDC y +1 on the render's row 0 (RT shadows
// found the same, frame-gen.cpp); the reflections reconstructed with row 0 = NDC y -1 before, a vertically mirrored
// view space: its depth normals disagreed with the G-buffer's and with world up (floors read as ceilings, so the
// up-facing wet-surface mask was zero on floors). Decided by the calibration (G-buffer normals, else floor votes).
float YS() { return (push.misc.w & 16) != 0 ? -1.0 : 1.0; }
vec2 TraceSize() { return push.size.zw; }

float ViewZ(float d) {
	float den = d * push.depth_map.z - push.depth_map.x;
	return abs(den) > 1e-12 ? (push.depth_map.y - d * push.depth_map.w) / den : 1e6;
}
vec3 ViewPos(vec2 uv, float d) {
	float z  = ViewZ(d);
	float w  = z * push.depth_map.z + push.depth_map.w;
	vec2  nd = uv * 2.0 - 1.0;
	nd.y *= YS();
	return vec3((nd.x * w - z * push.proj.z) / push.proj.x, (nd.y * w - z * push.proj.w) / push.proj.y, z);
}
float ClipW(vec3 p) { return p.z * push.depth_map.z + push.depth_map.w; }
vec4  Clip(vec3 p) {
	return vec4(p.x * push.proj.x + p.z * push.proj.z, p.y * push.proj.y + p.z * push.proj.w, p.z * push.depth_map.x + push.depth_map.y,
	            ClipW(p));
}
vec2 Project(vec3 p) {
	vec4 c  = Clip(p);
	vec2 nd = c.xy / c.w;
	nd.y *= YS();
	return nd * 0.5 + 0.5;
}
bool  IsSky(float d) { return d <= 1e-7 || d >= 0.9999999 || abs(ViewZ(d)) > 2e3; }
float Ign(vec2 p) { return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715)))); }
float Luma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }
float Max3(vec3 c) { return max(c.r, max(c.g, c.b)); }
bool  Bad(vec4 v) { return any(isnan(v)) || any(isinf(v)); }
bool  BadV(vec3 v) { return any(isnan(v)) || any(isinf(v)); }
vec3  SafeColor(vec3 c) {
	if (BadV(c)) return vec3(0);
	return clamp(c, vec3(0), vec3(6.0e4));
}
// The reversible tonemap the filters work in (fireflies weigh little; display-referred after the exposure).
vec3 Tonemap(vec3 c) { return c / (1.0 + Max3(c)); }
vec3 InvTonemap(vec3 t) { return t / max(1.0 - min(Max3(t), 0.999), 1e-3); }
vec3 YCoCg(vec3 c) { return vec3(0.25 * c.r + 0.5 * c.g + 0.25 * c.b, 0.5 * c.r - 0.5 * c.b, -0.25 * c.r + 0.5 * c.g - 0.25 * c.b); }
vec3 Rgb(vec3 y) { return vec3(y.x + y.y - y.z, y.x + y.z, y.x - y.y - y.z); }
bool InScreen(vec2 uv) { return all(greaterThanEqual(uv, vec2(0))) && all(lessThanEqual(uv, vec2(1))); }

float GameExposure() {
	float e = exposure_values[push.misc2.x];
	return (e > 1e-12 && e < 1e12) ? e : 1.0;
}

ivec2 RenderPixel(vec2 uv) { return clamp(ivec2(uv * RenderSize()), ivec2(0), ivec2(RenderSize()) - 1); }
float DepthAt(vec2 uv) { return texelFetch(depth_tex, RenderPixel(uv), 0).r; }

// ---- G-buffer decode (the packed R32_UINT layers; the layout found by the calibration) ----
uint Packed(int layer, ivec2 p) {
	if (layer == 0) return texelFetch(packed0, p, 0).r;
	if (layer == 1) return texelFetch(packed1, p, 0).r;
	if (layer == 2) return texelFetch(packed2, p, 0).r;
	return texelFetch(packed3, p, 0).r;
}
vec3 OctDecode(vec2 e) {
	e       = e * 2.0 - 1.0;
	vec3  n = vec3(e, 1.0 - abs(e.x) - abs(e.y));
	float t = max(-n.z, 0.0);
	n.x += n.x >= 0.0 ? -t : t;
	n.y += n.y >= 0.0 ? -t : t;
	return normalize(n);
}
float Bits(uint w, int shift, int bits) {
	return float((w >> uint(shift)) & ((1u << uint(bits)) - 1u)) / float((1u << uint(bits)) - 1u);
}
vec3 Unit(vec3 n) {
	float l = length(n);
	return l > 1e-4 ? n / l : vec3(0, 0, 1);
}
float Snorm16(uint w, int shift) {
	int v = int(w << uint(16 - shift)) >> 16; // (sign-extended 16 bits at `shift`)
	return clamp(float(v) / 32767.0, -1.0, 1.0);
}
// 0 oct 16:16 (x low), 1 oct 12:12 bits 0..23, 2 oct 12:12 bits 8..31, 3 oct 11:11 bits 0..21, 4 xyz 10:10:10 unorm
// bits 0..29, 5 oct 16:16 (x high), 6 oct 16:16 snorm, 7 spheremap (Lambert azimuthal) 16:16, 8 xyz 11:11:10 unorm,
// 9 oct 8:8 bits 0..15, 10 oct 8:8 bits 16..31, 11 hemi-oct 16:16, 12 xyz 10:10:10 unorm bits 2..31.
vec3 DecodeNormal(uint w, int layout_) {
	if (layout_ == 0) return OctDecode(vec2(Bits(w, 0, 16), Bits(w, 16, 16)));
	if (layout_ == 1) return OctDecode(vec2(Bits(w, 0, 12), Bits(w, 12, 12)));
	if (layout_ == 2) return OctDecode(vec2(Bits(w, 8, 12), Bits(w, 20, 12)));
	if (layout_ == 3) return OctDecode(vec2(Bits(w, 0, 11), Bits(w, 11, 11)));
	if (layout_ == 4) return Unit(vec3(Bits(w, 0, 10), Bits(w, 10, 10), Bits(w, 20, 10)) * 2.0 - 1.0);
	if (layout_ == 5) return OctDecode(vec2(Bits(w, 16, 16), Bits(w, 0, 16)));
	if (layout_ == 6) return OctDecode(vec2(Snorm16(w, 0), Snorm16(w, 16)) * 0.5 + 0.5);
	if (layout_ == 7) {
		vec2  f  = vec2(Bits(w, 0, 16), Bits(w, 16, 16)) * 4.0 - 2.0;
		float ff = dot(f, f);
		float g  = sqrt(max(1.0 - ff * 0.25, 0.0));
		return Unit(vec3(f * g, 1.0 - ff * 0.5));
	}
	if (layout_ == 8) return Unit(vec3(Bits(w, 0, 11), Bits(w, 11, 11), Bits(w, 22, 10)) * 2.0 - 1.0);
	if (layout_ == 9) return OctDecode(vec2(Bits(w, 0, 8), Bits(w, 8, 8)));
	if (layout_ == 10) return OctDecode(vec2(Bits(w, 16, 8), Bits(w, 24, 8)));
	if (layout_ == 11) {
		vec2 e = vec2(Bits(w, 0, 16), Bits(w, 16, 16)) * 2.0 - 1.0;
		vec2 t = vec2(e.x + e.y, e.x - e.y) * 0.5;
		return Unit(vec3(t, 1.0 - abs(t.x) - abs(t.y)));
	}
	return Unit(vec3(Bits(w, 2, 10), Bits(w, 12, 10), Bits(w, 22, 10)) * 2.0 - 1.0);
}
vec3 ToView(vec3 n) { return vec3(dot(view_rot[0].xyz, n), dot(view_rot[1].xyz, n), dot(view_rot[2].xyz, n)); }
bool GbufNormal(ivec2 p, out vec3 n) {
	n     = vec3(0, 0, 1);
	int c = push.dec.x;
	if (c < 0 || (c & 3) >= push.dec.z) return false;
	vec3 d = DecodeNormal(Packed(c & 3, p), (c >> 2) & 15);
	if ((c & 64) != 0) d = ToView(d);
	if ((c & 128) != 0) d = -d;
	float l = length(d);
	if (!(l > 1e-4)) return false;
	n = d / l;
	return true;
}
float Field(int f, ivec2 p) {
	uint  w = Packed(f & 3, p);
	float v = Bits(w, (f >> 2) & 31, max((f >> 7) & 31, 1));
	return (f & 4096) != 0 ? 1.0 - v : v;
}

// The depth-derived (geometric) normal, facing the camera; the smaller-step side on each axis (no edge smearing).
vec3 NormalAt(vec2 uv, vec3 p) {
	vec2  t  = 1.0 / RenderSize();
	vec3  px = ViewPos(uv + vec2(t.x, 0), DepthAt(uv + vec2(t.x, 0)));
	vec3  nx = ViewPos(uv - vec2(t.x, 0), DepthAt(uv - vec2(t.x, 0)));
	vec3  py = ViewPos(uv + vec2(0, t.y), DepthAt(uv + vec2(0, t.y)));
	vec3  ny = ViewPos(uv - vec2(0, t.y), DepthAt(uv - vec2(0, t.y)));
	vec3  dx = abs(px.z - p.z) < abs(p.z - nx.z) ? px - p : p - nx;
	vec3  dy = abs(py.z - p.z) < abs(p.z - ny.z) ? py - p : p - ny;
	vec3  n  = cross(dx, dy);
	float l  = length(n);
	if (!(l > 1e-12)) return normalize(-p);
	n /= l;
	if (dot(n, -p) < 0.0) n = -n;
	return n;
}

// ---- (refl8) The game's own SSR as the guide ----
bool  GuideMode() { return (push.misc.w & 512) != 0; }
bool  HaveGuide() { return (push.misc.w & 256) != 0; }
vec4  GameSsr(vec2 uv) {
	if (!HaveGuide()) return vec4(0);
	vec4 g = textureLod(game_ssr, uv, 0);
	if (Bad(g)) return vec4(0);
	return vec4(max(g.rgb, vec3(0)), clamp(g.a, 0.0, 1.0));
}
// (refl-res-1031) Alta / Maxima: the game's half-resolution SSR (the guide) upsampled joint-bilaterally: the 4 texels
// weighted by how close their depth is to this pixel's (no stair or wave pattern along edges and over floors); Normal:
// the plain bilinear sample, as before.
vec4 GameSsrAt(vec2 uv, float z) {
	if (!HaveGuide() || int(yparams.z + 0.5) < 1) return GameSsr(uv);
	vec2  gsz = vec2(textureSize(game_ssr, 0));
	vec2  tc  = uv * gsz - 0.5;
	vec2  i0  = floor(tc), fr = tc - i0;
	vec4  sum = vec4(0);
	float ws  = 0.0;
	for (int k = 0; k < 4; ++k) {
		vec2  o   = vec2(k & 1, k >> 1);
		vec2  tuv = clamp((i0 + o + 0.5) / gsz, vec2(0.0), vec2(1.0));
		float bw  = (o.x > 0.5 ? fr.x : 1.0 - fr.x) * (o.y > 0.5 ? fr.y : 1.0 - fr.y);
		float tz  = abs(ViewZ(DepthAt(tuv)));
		float w   = bw * exp(-abs(tz - z) / (0.03 * z + 0.02)) + 1e-4 * bw;
		vec4  g   = textureLod(game_ssr, tuv, 0);
		if (Bad(g)) continue;
		sum += vec4(max(g.rgb, vec3(0)), clamp(g.a, 0.0, 1.0)) * w, ws += w;
	}
	return ws > 1e-6 ? sum / ws : GameSsr(uv);
}
// How much the game counts this pixel as reflecting (its SSR confidence through gparams.x..y).
float GameMask(float a) { return smoothstep(gparams.x, max(gparams.y, gparams.x + 1e-3), a); }
// The game's reflected color itself (not premultiplied).
vec3  GameReflColor(vec4 g) { return gparams.z > 0.5 ? g.rgb / max(g.a, 1e-3) : g.rgb; }
// The pixel holds the G-buffer's surface (the game's SSR belongs to it): the normals agree, or the final depth is the
// lighting's (nothing drawn over it after).
bool  GbufSurface(ivec2 rp, float d, bool match) {
	if (match) return true;
	if ((push.misc.w & 64) == 0) return false;
	float d0 = texelFetch(gdepth, rp, 0).r;
	if (IsSky(d0)) return false;
	float z = abs(ViewZ(d)), z0 = abs(ViewZ(d0));
	return abs(z0 - z) < 0.01 * z + 0.01;
}

// ---- (rt4: KYTY_RT4) Reflections that cover the screen and stay still on stone ----
// Rt4(): the changes (misc.w & 131072; KYTY_RT4_AB alternates it); Rt4Stats(): the [rt4] counters, both phases of the A/B
// (misc.w & 262144); HaveIbl(): the game's specular IBL copy bound (binding 22, misc.w & 524288).
bool Rt4() { return (push.misc.w & 131072) != 0; }
bool Rt4Stats() { return (push.misc.w & 262144) != 0; }
bool HaveIbl() { return (push.misc.w & 524288) != 0; }
// R4STATS (cumulative, never cleared; the CPU logs the difference, "[rt4]"): trace (1 pixel in 16): 0 rays, 1 hit (confidence
// >= 0.5), 2 hit faded (< 0.5: screen edge, silhouette, facing), 3 miss off screen (or toward the camera), 4 miss occluded /
// rejected (behind an object, silhouette, back face, own plane), 5 miss sky, 6 miss other (length, steps), 7 filled from the
// game's IBL (fill share > 0.05), 8 reflective water pixels, 9 reflective other pixels; the fill's calibration (1 pixel in 64,
// confident mirror-like hits on G-buffer surfaces): 10 samples, 11 / 12 sum of v / v^2 / 4 (v = 64 log2(hit / IBL as
// radiance)), 13 / 14 the same for the IBL divided by the split-sum BRDF; composite (Stabilize, 1 in 16, static surfaces
// with a reflection, valid history): 15 / 16 not water, camera still: samples / sum of the shown change x 1000 (of the
// pixel's light), 17 / 18 not water moving, 19 / 20 water still, 21 / 22 water moving; temporal (1 in 16, static: motion
// vector within 2 px of the camera's reprojection): 23 / 24 not water: samples / sum of |motion vector - camera| x 100 px,
// 25 / 26 water, 27 the camera's reprojection taken (rt4, not water); trace: 28 the smoothed normal used, 29 sum of its
// deviation from the pixel's normal map normal (degrees x 10); 30 the reflection ray's lobe widened by the normal variance.
const int R4STATS = 1432;
void R4Stat(int k, int v) {
	int sum = subgroupAdd(v);
	if (subgroupElect()) atomicAdd(calib[R4STATS + k], sum);
}
// (rt4) The GGX sample's random numbers: a per-pixel hash rotating the R2 sequence over frames (Cranley-Patterson). The
// interleaved gradient noise before (Ign(px) + frame x golden ratio) is a diagonal stripe pattern that shifts every frame:
// where little history is kept (moving: 85-95 % new a frame) it reads as bands sliding over the floor.
uint Pcg(uint v) {
	uint st = v * 747796405u + 2891336453u;
	uint w  = ((st >> ((st >> 28u) + 4u)) ^ st) * 277803737u;
	return (w >> 22u) ^ w;
}
vec2 Rt4Xi(ivec2 px) {
	uint  a  = Pcg(uint(px.x) + Pcg(uint(px.y)));
	uint  b  = Pcg(a ^ 0x9e3779b9u);
	vec2  h  = vec2(float(a >> 8), float(b >> 8)) * (1.0 / 16777216.0);
	float fi = float(push.misc.y & 4095);
	return fract(h + vec2(0.7548776662, 0.5698402910) * fi);
}
// (rt4) Not water: the reflection ray along the G-buffer normal smoothed over its footprint (the pixel and 4 taps 3 render
// pixels away at 720p, same surface), not the per-pixel normal map: on stone and tiles the normal map's bumps bent each
// pixel's ray its own way, a distorted image that slides as the camera moves (water-like). The bumps' spread is kept as
// lobe width (Toksvig: variance 2 (1 - |mean|) / |mean|), so a bumpy surface reflects blurred, not rippled.
bool SmoothGbufNormal(ivec2 p, float z, vec3 n0, vec3 Nd, out vec3 ns, out float nvar) {
	ns   = n0;
	nvar = 0.0;
	ivec2 hi  = ivec2(RenderSize()) - 1;
	int   o   = max(int(3.0 * RenderSize().y / 720.0 + 0.5), 1);
	vec3  sum = n0;
	float cnt = 1.0;
	for (int i = 0; i < 4; ++i) {
		ivec2 q  = clamp(p + ivec2(i == 0 ? o : i == 1 ? -o : 0, i == 2 ? o : i == 3 ? -o : 0), ivec2(0), hi);
		float qd = texelFetch(depth_tex, q, 0).r;
		if (IsSky(qd) || abs(abs(ViewZ(qd)) - z) > 0.05 * z + 0.05) continue;
		vec3 nq;
		if (!GbufNormal(q, nq) || dot(nq, Nd) < 0.5) continue;
		sum += nq, cnt += 1.0;
	}
	float L = length(sum) / cnt;
	if (cnt < 2.5 || !(L > 0.5)) return false;
	ns   = sum / (L * cnt);
	nvar = clamp(2.0 * (1.0 - L) / L, 0.0, 1.0);
	return true;
}
// (rt4) The game's specular IBL at a render uv: its half-width image upsampled joint-bilaterally by depth (as GameSsrAt).
vec3 SpecIblAt(vec2 uv, float z) {
	vec2  gsz = vec2(textureSize(spec_ibl, 0));
	vec2  tc  = uv * gsz - 0.5;
	vec2  i0  = floor(tc), fr = tc - i0;
	vec3  sum = vec3(0);
	float ws  = 0.0;
	for (int k = 0; k < 4; ++k) {
		vec2  o   = vec2(k & 1, k >> 1);
		vec2  tuv = clamp((i0 + o + 0.5) / gsz, vec2(0.0), vec2(1.0));
		float bw  = (o.x > 0.5 ? fr.x : 1.0 - fr.x) * (o.y > 0.5 ? fr.y : 1.0 - fr.y);
		float tz  = abs(ViewZ(DepthAt(tuv)));
		float w   = bw * exp(-abs(tz - z) / (0.03 * z + 0.02)) + 1e-4 * bw;
		vec4  g   = textureLod(spec_ibl, tuv, 0);
		if (Bad(g)) continue;
		sum += max(g.rgb, vec3(0)) * w, ws += w;
	}
	return ws > 1e-6 ? sum / ws : vec3(0);
}
// (rt4) The split-sum BRDF's scale and bias (Karis' analytic fit of the 256x256 RG16F LUT the game's IBL pass binds).
float EnvBrdf(float rough, float nv, float f0) {
	vec4  r    = rough * vec4(-1.0, -0.0275, -0.572, 0.022) + vec4(1.0, 0.0425, 1.04, -0.04);
	float a004 = min(r.x * r.x, exp2(-9.28 * nv)) * r.x + r.y;
	vec2  ab   = vec2(-1.04, 1.04) * a004 + r.zw;
	return max(f0 * ab.x + ab.y, 0.02);
}
// (rt4) What the game reflects at this pixel, as the radiance our ray sees: its IBL image as is (model 0) or divided by
// the BRDF it was multiplied with (model 1); the model and the scale come from the data (confident hits vs the IBL, CPU).
vec3 IblRadiance(vec3 ibl, float prough, float nv, float metal, int model) {
	float f0 = mix(0.04, 0.75, clamp(metal, 0.0, 1.0));
	return model == 1 ? ibl / EnvBrdf(clamp(prough, 0.0, 1.0), clamp(nv, 0.0, 1.0), f0) : ibl;
}

// ---- (rt5: KYTY_RT5) The game's own material response, the reflection's own reprojection in translation ----
// Ghidra (eboot 1.07, rt5/ghidra): RenderSpecularIBL -> RenderIBL (FUN_009d66d0) runs RenderSSR (SSRCreateRays, SSRRaymarch)
// and then ONE IBL compute pass (CS 9fb5cc274b5e4f82) that reads the G-buffer array (kRTT_GBufferArray: 4 layers, R32_UINT),
// the SSR, the local / distant cubemaps and the BRDF LUT (RG16F 256x256) and writes kRTT_SpecularIBL_<r_iblResolution>
// (HalfResX here, binding 22): the game's whole specular reflection at this pixel, SSR and cubemaps blended, its material
// (BRDFModifyGBuffer's wetness parameters, FUN_00933d10, are passed to the same pass). So the composite replaces exactly
// that term: delta = EnvBRDF x (ours - the game's reflected radiance), the radiance from the calibrated model (rt4). Where
// our ray misses, ours IS the game's (the fill at scale 1): no change at all; where it hits, the game's estimate (SSR or a
// cubemap) is swapped for what the screen shows, at the game's own split-sum weight (Fresnel and roughness): a dielectric's
// 4 % from above, its grazing mirror, rough stone nearly nothing (no plastic sheen), never where the game reflects nothing.
// Rt5(): misc.w & 1048576 (with rt4 on); Rt5Stats(): & 2097152.
bool Rt5() { return (push.misc.w & 1048576) != 0; }
bool Rt5Stats() { return (push.misc.w & 2097152) != 0; }
// R5STATS (cumulative; the CPU logs the difference, "[rt5]"): temporal (1 in 16, static surfaces with a reflection), per camera
// motion class c (0 still, 1 rotation only, 2 translation: CamClass): [c * 4 + 0] samples, + 1 history accepted, + 2 sum of the
// history's weight x 1000, + 3 sum of its distance to this frame's neighbourhood (sigmas x 100, capped at 10); composite
// (Stabilize, not water, static, valid history): [12 + c * 2] samples, [13 + c * 2] sum of the shown change frame to frame x
// 1000 (of the pixel's light); composite (1 in 16, G-buffer surfaces the material lets reflect, not water): 18 such pixels,
// 19 with our own hit (the trace's confidence > 0.05), 20 the game's own reflection only (the fill), 21 nothing (the trace
// skipped it: below the visible weight); trace rays by angle (n.v < 0.3 grazing, < 0.7 middle, else frontal): [22 + b * 2]
// rays, [23 + b * 2] hits (confidence >= 0.5); 28 rays left to the temporal pass on rough surfaces (half rate), 29 traced;
// 30 composite pixels changed by > 1 % of their light; 31 sum of the delta's weight (EnvBRDF x coverage) x 1000.
const int R5STATS = 1464;
void R5Stat(int k, int v) {
	int sum = subgroupAdd(v);
	if (subgroupElect()) atomicAdd(calib[R5STATS + k], sum);
}
// The reflection's virtual distance along the view ray (the image behind a mirror): the hit's for a hit, far away for the
// game's fill (a cubemap: the environment at infinity), mixed in 1 / distance (parallax is linear in it) by the trace's
// confidence; rough lobes move partly with the surface (60 % of the way at roughness 0.7).
float Rt5VirtDist(float dS, float hd, float conf, float rough) {
	const float FARV = 300.0;
	float c   = hd > 0.0 ? clamp(conf, 0.0, 1.0) : 0.0;
	float inv = (hd > 0.0 ? c / (dS + hd) : 0.0) + (1.0 - c) / (dS + FARV);
	float dv  = 1.0 / max(inv, 1e-6);
	return mix(dS, dv, 1.0 - 0.7 * smoothstep(0.3, 0.7, rough));
}
// The trace's confidence of its own hit, kept in out_c.w's fraction (rt5): 0.51 .. 1.0 for a hit (mod 2 > 0.5 still reads
// "hit"), 0 for none.
float HitConf(float w) {
	float f = mod(w, 2.0);
	return f > 0.5 ? clamp((f - 0.51) / 0.49, 0.0, 1.0) : 0.0;
}
// The material's reach (rt5): every G-buffer surface reflects by its roughness up to mparams.y (the trace's cutoff), faded
// over its last quarter; the strength is the split-sum weight, not this.
float Rt5Reach(float r) { return 1.0 - smoothstep(0.75 * mparams.y, mparams.y, r); }
// The game's split-sum weight at this pixel (f0 0.04 dielectric, toward 0.75 metal: as Spec); below 0.03 our change could not
// show (the trace skips it), faded in to 0.045.
float Rt5Weight(float prough, float nv, float metal) {
	return EnvBrdf(clamp(prough, 0.0, 1.0), clamp(nv, 0.0, 1.0), mix(0.04, 0.75, clamp(metal, 0.0, 1.0)));
}

// ---- The surface: normal, roughness, reflection mask (how much of a reflector it is) ----
struct Surf {
	vec3  N;  // shading normal (the G-buffer's when it matches)
	vec3  Ng; // geometric normal (depth)
	float rough;  // the lobe the ray samples (0: a mirror)
	float prough; // the material's perceptual roughness (Fresnel)
	float mask;
	float metal;
	float water;
	float gb; // 1: the G-buffer normal was used
	float extra; // (refl9) the metal / glossy paths' weight (ExtraWeight)
	float tok;   // (rt4) the normal map's variance over the footprint (0: the per-pixel normal kept, or water)
	float dev;   // (rt4) the smoothed normal's angle to the pixel's own (degrees; stats)
};
// (refl6) Reflectivity follows the material's roughness per pixel, as light does: smooth surfaces (polished stone,
// metal, wet floors, water) reflect, rough dry stone does not; walls and metal too, not only floors. Sources:
//   material: the G-buffer's roughness (L2.b0) and gloss (L1.b2, as 1 - gloss), the rougher of the two (either alone
//             marked dry stone smooth in the 10-24 logs): full strength and a mirror below mparams.x (0.1), weaker and
//             blurrier (the GGX lobe widens) up to mparams.y (0.4), nothing from there
//   water:    the final depth nearer than the depth the deferred lighting read (drawn after the G-buffer), up-facing
//             (the only source restricted to floors), a mirror with the minimum reflectance fparams.y
//   guess:    without a material field only: up-facing, flat, plain, darker than around it, faint (fparams.w, 0 default)
// The share is a Fresnel (Schlick with roughness; f0 0.04, from the metal field when one is given): a smooth dry stone
// floor seen from above barely changes, the same floor at a grazing angle mirrors the hall. Moving objects (characters:
// their motion vector disagrees with the camera's) and the sky never get a reflection.
float RoughFade(float r) { return 1.0 - smoothstep(mparams.x, mparams.y, r); }
float LobeRough(float r) { return mparams.y * smoothstep(mparams.x, mparams.y, r); }
// The material's roughness at a G-buffer pixel (r0: the roughness field alone, for the stats).
float GbufRough(ivec2 p, out float r0) {
	r0      = push.dec.y >= 0 ? clamp(Field(push.dec.y, p), 0.0, 1.0) : 1.0;
	float r = r0;
	if (push.misc.x != 7 && push.dec.w >= 0) r = max(r, clamp(Field(push.dec.w, p), 0.0, 1.0));
	return r;
}
float GbufMetal(ivec2 p) { return push.misc2.w > 0 ? clamp(Field(push.misc2.w - 1, p), 0.0, 1.0) : 0.0; }
// (refl9) The albedo (L0 bits 0..23, sRGB-encoded rgb), linear; white without one.
vec3 GbufAlbedo(ivec2 p) {
	int l = int(xparams.w);
	if (l < 0 || l >= push.dec.z) return vec3(1);
	uint w = Packed(l, p);
	vec3 a = vec3(Bits(w, 0, 8), Bits(w, 8, 8), Bits(w, 16, 8));
	return a * a; // (gamma 2.0: close enough for a hue)
}
// (refl9) The metal's reflection tint: the albedo's hue (metals reflect in their own color: F0 = the base color), its
// brightness normalized away (the brightness comes from what is reflected), only partly (xparams.z) so a dark or
// strongly saturated albedo never turns the reflection into a flat color.
vec3 MetalTint(vec3 albedo) {
	float m = Max3(albedo);
	vec3  h = m > 0.02 ? albedo / m : vec3(1);
	return mix(vec3(1), h, clamp(xparams.z, 0.0, 1.0));
}
// (refl9) How glossy a dielectric is (the material roughness `r`, the rougher of the fields): floors (up-facing) from a
// roughness of 0.30 down, walls and everything else facing elsewhere only when genuinely glossy (from 0.12 down, and at
// 70 %: the game's own probes already hold most of a wall's sheen).
float Glossy(float r, float upf) {
	float up   = 1.0 - smoothstep(0.08, 0.30, r);
	float wall = 0.7 * (1.0 - smoothstep(0.03, 0.12, r));
	return mix(wall, up, clamp(upf, 0.0, 1.0));
}
// (refl9) The weight our hit takes beyond the game's own share on metals (armour, weapons, shields: rough-ish, any
// orientation) and glossy dielectrics (polished stone, marble, wet stone, glass, polished wood), before our ray's
// confidence and the composite's limits: metals at KYTY_RT_REFLECTIONS_METAL, fading out by a roughness of 0.65, a little
// more at grazing angles; glossy surfaces at KYTY_RT_REFLECTIONS_GLOSSY x a soft Fresnel (seen from above about half,
// grazing all). Where the game's own SSR is confident the full weight, elsewhere 65 % of it (the game decides first).
float ExtraWeight(float metal, float r, float nv, float upf, float gmask) {
	float g    = 1.0 - pow(1.0 - clamp(nv, 0.0, 1.0), 3.0);
	float wmet = xparams.x * metal * (1.0 - smoothstep(0.30, 0.65, r)) * (0.85 + 0.15 * (1.0 - g));
	float wgl  = xparams.y * (1.0 - metal) * Glossy(r, upf) * mix(1.0, 0.45, g);
	return clamp(max(wmet, wgl) * mix(0.65, 1.0, clamp(gmask, 0.0, 1.0)), 0.0, 0.9);
}
// (refl9) Our lobe on those surfaces: sharper than the material (the game's own is the blurry one), still a cone.
float ExtraLobe(float r) { return clamp(r * 0.7, 0.0, 0.42); }
float UpFacing(vec3 Nd) {
	if ((push.misc.w & 8) != 0) return smoothstep(0.80, 0.95, dot(Nd, up_view.xyz));
	return smoothstep(0.80, 0.95, abs(Nd.y));
}
float Flatness(vec2 uv, vec3 Nd, float lo, float hi) {
	vec2  t  = 1.0 / RenderSize();
	vec2  ua = uv + vec2(3.0 * t.x, 0), ub = uv + vec2(0, 3.0 * t.y);
	vec3  Na = NormalAt(ua, ViewPos(ua, DepthAt(ua)));
	vec3  Nb = NormalAt(ub, ViewPos(ub, DepthAt(ub)));
	return smoothstep(lo, hi, min(dot(Na, Nd), dot(Nb, Nd)));
}
float PuddleGuess(vec2 uv, vec3 Nd) {
	float upf = UpFacing(Nd);
	if (upf <= 0.0) return 0.0;
	float flat_ = Flatness(uv, Nd, 0.97, 0.995);
	if (flat_ <= 0.0) return 0.0;
	vec2  t  = 1.0 / RenderSize();
	float m1 = 0.0, m2 = 0.0;
	for (int y = -1; y <= 1; ++y)
		for (int x = -1; x <= 1; ++x) {
			float l = Luma(SafeColor(textureLod(color_tex, uv + vec2(x, y) * t * 2.0, 0).rgb));
			m1 += l, m2 += l * l;
		}
	m1 /= 9.0, m2 /= 9.0;
	float cv    = sqrt(max(m2 - m1 * m1, 0.0)) / max(m1, 1e-12);
	float plain = 1.0 - smoothstep(0.06, 0.20, cv);
	if (plain <= 0.0) return 0.0;
	float ring  = 0.0;
	for (int i = 0; i < 8; ++i) {
		float a = float(i) * (PI * 0.25);
		ring += Luma(SafeColor(textureLod(color_tex, uv + vec2(cos(a), sin(a)) * t * 24.0, 0).rgb));
	}
	ring /= 8.0;
	float dark = 1.0 - smoothstep(0.65, 0.95, m1 / max(ring, 1e-12));
	return upf * flat_ * plain * dark;
}
// Water: something nearer than the G-buffer's surface (by 2 % of the distance or more), up-facing and flat.
float WaterMask(ivec2 rp, float d, vec2 uv, vec3 Nd) {
	if ((push.misc.w & 64) == 0) return 0.0;
	float d0 = texelFetch(gdepth, rp, 0).r;
	float z  = abs(ViewZ(d));
	float z0 = IsSky(d0) ? FAR : abs(ViewZ(d0));
	// (refl3: 0.5 % of the distance and 3 cm, was 2 %: far and shallow water was lost)
	float nearer = smoothstep(0.004, 0.015, (z0 - z) / max(z, 1e-3)) * smoothstep(0.02, 0.06, z0 - z);
	if (nearer <= 0.0) return 0.0;
	float upf = UpFacing(Nd);
	if (upf <= 0.0) return 0.0;
	// (water-1030: with WaterStable a little more lenient, so rippling water does not drop in and out of the mask, a
	// 40 % mirror on one frame and none the next)
	bool ws = (push.misc.w & 2048) != 0;
	return nearer * upf * Flatness(uv, Nd, ws ? 0.88 : 0.93, ws ? 0.97 : 0.985); // (refl4: must be flat: never a character or a particle)
}
// Flat water reflects as a mirror: its depth normal (noisy from the depth's precision far away) snapped to world up
// when it is close to it; waves (normals further off) keep their own.
vec3 WaterNormal(vec3 Nd) {
	if ((push.misc.w & 8) == 0) return Nd;
	vec3  up = normalize(up_view.xyz);
	// (refl-sharp-1031) the waves' perturbation of the reflection ray: soft keeps 40 % of it, mirror none (flat water)
	int   wv = int(yparams.w + 0.5);
	if (wv == 2 && dot(Nd, up) > 0.5) return up;
	if (wv == 1) Nd = normalize(mix(up, Nd, 0.4));
	float c  = dot(Nd, up);
	// (water-1030, WaterStable: the per-pixel depth normal of ripples is noise (the depth's precision, the vertex waves):
	// snapped level from 0.94, a smoothed blend below, so the mirror ray does not jump between hit and miss pixel to pixel)
	if ((push.misc.w & 2048) != 0) return c > 0.94 ? up : normalize(mix(Nd, up, smoothstep(0.75, 0.94, c)));
	return c > 0.97 ? up : normalize(mix(Nd, up, smoothstep(0.85, 0.97, c)));
}
// The previous frame's uv of a view-space point through clip -> previous clip (`flip`: the clip's y the other way).
vec2 PrevUv(vec3 X, bool flip) {
	vec4 c = Clip(X);
	if (flip) c.y = -c.y;
	vec4 p = vec4(dot(clip_prev[0], c), dot(clip_prev[1], c), 0.0, dot(clip_prev[3], c));
	if (!(abs(p.w) > 1e-8)) return vec2(-10.0);
	vec2 nd = p.xy / p.w;
	if (flip) nd.y = -nd.y;
	nd.y *= YS();
	return nd * 0.5 + 0.5;
}

// (refl6) Moving objects: the pixel's motion vector against the camera's own reprojection of its point (both screen y
// conventions of the previous clip, as the temporal pass); a character the camera follows moves on screen by much less
// than the camera alone would move it, or the other way round. 1: moving. Needs the camera matrices (misc.w & 4).
float MovingRaw(vec2 uv, vec3 P) {
	if ((push.misc.w & 4) == 0) return 0.0;
	vec2  rs  = RenderSize();
	vec2  mv  = texelFetch(motion_tex, RenderPixel(uv), 0).xy * push.motion.xy; // (render pixels)
	vec2  s0  = PrevUv(P, false), s1 = PrevUv(P, true);
	vec2  e0  = (s0 - uv) * rs - mv, e1 = (s1 - uv) * rs - mv;
	bool  fl  = dot(e1, e1) < dot(e0, e0);
	float e   = sqrt(min(dot(e0, e0), dot(e1, e1)));
	float cam = length(((fl ? s1 : s0) - uv) * rs);
	if (isnan(e) || isnan(cam)) return 0.0;
	return smoothstep(2.0, 4.0, e) * smoothstep(0.25, 0.45, e / max(max(length(mv), cam), 1e-3));
}
float Moving(vec2 uv, vec3 P) { return (push.misc.w & 128) != 0 ? MovingRaw(uv, P) : 0.0; }
// (rt5) // The camera's motion at this point (needs the matrices): its parallax against a point at infinity on the same ray
// (translation) and the infinity point's own shift (rotation), in render pixels a frame.
int CamClass(vec2 uv, vec3 P) {
	if ((push.misc.w & 4) == 0) return 0;
	vec2  rs = RenderSize();
	vec3  Pf = normalize(P) * 1.0e4;
	// (the previous clip's y convention: the one whose reprojection agrees with the motion vector, as the temporal pass)
	vec2  pm = uv + texelFetch(motion_tex, RenderPixel(uv), 0).xy * push.motion.xy / rs;
	vec2  a0 = PrevUv(P, false), a1 = PrevUv(P, true);
	bool  fl = dot((a1 - pm) * rs, (a1 - pm) * rs) < dot((a0 - pm) * rs, (a0 - pm) * rs);
	vec2  s0 = fl ? a1 : a0, f0 = PrevUv(Pf, fl);
	float tr = length((s0 - f0) * rs), ro = length((f0 - uv) * rs);
	if (isnan(tr) || isnan(ro)) return 0;
	return tr > 0.3 ? 2 : ro > 0.3 ? 1 : 0;
}

// (refl-motion-1031) Flat floors that are not water: the reflection's normal settled toward world up where the geometry
// (the depth's normal) and the surface's own normal are both level, so the depth's stair-steps and the normal map's
// bumps do not make a wave that slides over a mirror-like floor while walking. Water keeps WaterNormal (its own option).
// (des-refl2-1108) KYTY_RT_REFLECTIONS_FLAT_FLOOR (misc.w & 8192, default on; 0: des-refl-flat's per-pixel test only):
// the level test also on the floor's plane over a wider footprint (LevelWide: the depth 6 render pixels each way at
// 720p), so a floor whose per-pixel depth normal is not level (the tessellation's displacement on "extremo", the depth's
// precision at a distance) still reflects flat; and, on level floors, the game's own SSR confidence and the material's
// roughness that gate the reflection are taken over the same footprint (GuideWide / RoughWide) instead of per pixel: the
// game's SSR (its normal-mapped, jittered half-resolution rays) and the stone's per-tile roughness cut our flat
// reflection into wobbling blobs, which is what the des-refl-flat build still showed on the Nexus floor.
bool FlatFix() { return (push.misc.w & 8192) != 0; }
float LevelPixel(vec3 Nd) {
	if (!(mparams.w > -0.5) || (push.misc.w & 8) == 0) return 0.0;
	return smoothstep(0.93, 0.98, dot(Nd, normalize(up_view.xyz)));
}
float LevelWide(vec2 uv, vec3 P, vec3 Nd) {
	float f = LevelPixel(Nd);
	if (!FlatFix() || f >= 1.0 || !(mparams.w > -0.5) || (push.misc.w & 8) == 0) return f;
	vec3 up = normalize(up_view.xyz);
	if (dot(Nd, up) < 0.6) return f; // (walls, steps' risers: never)
	vec2  t  = vec2(6.0 * RenderSize().y / 720.0) / RenderSize();
	vec2  ua = uv + vec2(t.x, 0), ub = uv - vec2(t.x, 0), uc = uv + vec2(0, t.y), ud = uv - vec2(0, t.y);
	float da = DepthAt(ua), db = DepthAt(ub), dc = DepthAt(uc), dd = DepthAt(ud);
	if (IsSky(da) || IsSky(db) || IsSky(dc) || IsSky(dd)) return f;
	vec3 A = ViewPos(ua, da), B = ViewPos(ub, db), C = ViewPos(uc, dc), D = ViewPos(ud, dd);
	// (one plane: 1 / distance is linear across a plane on screen; an edge or a step between the taps: no)
	float iz = 1.0 / max(abs(P.z), 1e-3);
	float jx = abs(1.0 / max(abs(A.z), 1e-3) + 1.0 / max(abs(B.z), 1e-3) - 2.0 * iz) / iz;
	float jy = abs(1.0 / max(abs(C.z), 1e-3) + 1.0 / max(abs(D.z), 1e-3) - 2.0 * iz) / iz;
	if (max(jx, jy) > 0.02) return f;
	vec3  n = cross(A - B, C - D);
	float l = length(n);
	if (!(l > 1e-12)) return f;
	n /= l;
	if (dot(n, -P) < 0.0) n = -n;
	return max(f, smoothstep(0.95, 0.985, dot(n, up)));
}
vec3 FlatFloor(vec3 N, float lvl) {
	if (!(lvl > 0.0)) return N;
	// (des-refl-flat) Solid floors reflect flat: when the geometry is level, the reflection ray uses world up fully,
	// whatever the normal map's bumps say. Only water (WaterNormal) keeps its waves.
	return normalize(mix(N, normalize(up_view.xyz), lvl));
}
// (des-refl2-1108) The game's SSR confidence over the level floor's footprint (8 taps at 4 and 8 render pixels at 720p on
// the same plane, with the pixel itself): its per-pixel blobs gone, its overall extent kept.
float GuideWide(vec2 uv, float z, float ga, float lvl) {
	if (!FlatFix() || !(lvl > 0.0) || !HaveGuide()) return ga;
	vec2  t   = vec2(RenderSize().y / 720.0) / RenderSize();
	float sum = ga, ws = 1.0;
	for (int i = 0; i < 8; ++i) {
		float a   = float(i) * (PI * 0.25) + (i >= 4 ? PI * 0.125 : 0.0);
		vec2  tuv = uv + vec2(cos(a), sin(a)) * t * (i >= 4 ? 8.0 : 4.0);
		if (!InScreen(tuv)) continue;
		float td = DepthAt(tuv);
		if (IsSky(td) || abs(abs(ViewZ(td)) - z) > 0.05 * z + 0.05) continue;
		sum += GameSsr(tuv).a, ws += 1.0;
	}
	return mix(ga, sum / ws, lvl);
}
// (des-refl2-1108) The material roughness over the level floor's footprint (the pixel and 4 taps 3 render pixels away,
// same plane, G-buffer surfaces): the stone's per-tile roughness no longer cuts the reflection into tiles.
float RoughWide(ivec2 p, float z, float rm, float lvl) {
	if (!FlatFix() || !(lvl > 0.0)) return rm;
	ivec2 hi  = ivec2(RenderSize()) - 1;
	int   o   = max(int(3.0 * RenderSize().y / 720.0 + 0.5), 1);
	float sum = rm, ws = 1.0;
	for (int i = 0; i < 4; ++i) {
		ivec2 q  = clamp(p + ivec2(i == 0 ? o : i == 1 ? -o : 0, i == 2 ? o : i == 3 ? -o : 0), ivec2(0), hi);
		float qd = texelFetch(depth_tex, q, 0).r;
		if (IsSky(qd) || abs(abs(ViewZ(qd)) - z) > 0.05 * z + 0.05) continue;
		float r0;
		sum += GbufRough(q, r0), ws += 1.0;
	}
	return mix(rm, sum / ws, lvl);
}

Surf SurfaceAt(ivec2 rp, vec2 ruv, vec3 P, float d) {
	Surf s;
	vec3 Nd = NormalAt(ruv, P);
	vec3 Ng;
	// The G-buffer belongs to the visible surface only when its normal roughly agrees with the depth's (water or
	// particles drawn after the G-buffer copy do not: depth normals there).
	bool match = GbufNormal(rp, Ng) && dot(Ng, Nd) > 0.6;
	vec3 V     = normalize(-P);
	float water = WaterMask(rp, d, ruv, Nd);
	if (water > 0.0) match = false; // (the G-buffer holds the bed under the water)
	s.N  = match ? Ng : (water > 0.0 ? WaterNormal(Nd) : Nd);
	float lvl = water <= 0.0 ? LevelWide(ruv, P, Nd) : 0.0; // (des-refl2-1108)
	s.tok = 0.0, s.dev = 0.0;
	// (rt4) not water: the footprint's smoothed G-buffer normal (level floors already take world up: FlatFloor)
	if (Rt4() && water <= 0.0 && match && lvl < 0.999) {
		vec3  ns;
		float vr;
		if (SmoothGbufNormal(rp, abs(P.z), Ng, Nd, ns, vr)) {
			s.dev = degrees(acos(clamp(dot(ns, Ng), -1.0, 1.0)));
			s.N = ns, s.tok = max(vr, 1e-6);
		}
	}
	if (water <= 0.0) s.N = FlatFloor(s.N, lvl); // (refl-motion-1031)
	s.Ng = Nd;
	s.gb = match ? 1.0 : 0.0;
	if (dot(s.N, V) < 0.02) s.N = normalize(s.N + V * (0.02 - dot(s.N, V) + 0.01)); // (back-facing by a little: bent)
	bool  have_mat = push.dec.y >= 0;
	float mat = 0.0, mat_r = 1.0, mat_pr = 1.0, metal = 0.0;
	s.extra    = 0.0;
	if (GuideMode()) {
		// (refl8) The game decides: its SSR confidence here; the roughness field (when decoded) only narrows it to the
		// mirror-like surfaces we sharpen and sets our lobe.
		if (water <= 0.0 && GbufSurface(rp, d, match)) {
			float gm  = GameMask(GuideWide(ruv, abs(P.z), GameSsrAt(ruv, abs(P.z)).a, lvl)); // (des-refl2-1108: level floors wide)
			float mir = 1.0;
			mat_pr = 0.05, mat_r = 0.0; // (no roughness field: a mirror ray, at the game's share)
			if (match && have_mat) {
				float r0;
				mat_pr = RoughWide(rp, abs(P.z), GbufRough(rp, r0), lvl);
				mir    = RoughFade(mat_pr);
				mat_r  = LobeRough(mat_pr);
				metal  = GbufMetal(rp);
				// (refl9) Metals and glossy surfaces: our own weight on any orientation, the game's mask only scales it.
				s.extra = ExtraWeight(metal, mat_pr, clamp(dot(s.N, V), 0.0, 1.0), UpFacing(Nd), gm);
				if (s.extra > gm * mir) mat_r = min(ExtraLobe(mat_pr), push.motion.z);
				// (rt5) every G-buffer surface by its own material, the game's SSR confidence no longer the gate (it marked
				// 2-3 % of the floors); the strength is the game's split-sum weight in the composite, not a fixed share
				if (Rt5()) {
					s.extra = 0.0;
					mat_r   = LobeRough(mat_pr);
					gm      = 0.0;
					mir     = Rt5Reach(mat_pr);
				}
			}
			mat = Rt5() && match && have_mat ? mir : max(gm * mir, s.extra);
		}
	} else if (match && have_mat) {
		float r0;
		mat_pr = RoughWide(rp, abs(P.z), GbufRough(rp, r0), lvl);
		mat    = RoughFade(mat_pr) * mparams.z;
		mat_r  = LobeRough(mat_pr);
		metal  = GbufMetal(rp);
	}
	float guess = (water > 0.0 || have_mat || GuideMode()) ? 0.0 : PuddleGuess(ruv, Nd) * fparams.w;
	s.mask   = max(water, max(mat, guess));
	bool wat = water > 0.0 && water >= mat && water >= guess;
	s.water  = wat ? water : 0.0;
	s.rough  = wat ? 0.0 : mat >= guess ? mat_r : 0.12; // (water: a mirror, no lobe)
	s.prough = wat ? 0.0 : mat >= guess ? mat_pr : 0.12;
	s.metal  = wat ? 0.0 : metal;
	// (rt4) the normal map's spread as lobe width (GGX alpha^2 + rparams.w x variance), never past the roughness cutoff
	if (s.tok > 0.0 && !wat) {
		float a  = s.rough * s.rough;
		float rn = sqrt(sqrt(a * a + max(rparams.w, 0.0) * s.tok));
		s.rough  = max(s.rough, min(rn, max(s.rough, push.motion.z * 0.9)));
	}
	if (wat) s.tok = 0.0;
	// (characters: never, except (refl9) their metal: armour, swords, shields, at the metal path's weight alone)
	if (s.mask > 0.0 && Moving(ruv, P) > 0.5) s.mask = (s.metal > 0.5 && !wat) ? s.extra : 0.0;
	if (wat) s.extra = 0.0;
	if (s.mask < 0.05) s.mask = 0.0;
	return s;
}
// The share of the reflection in the composite (and the trace's early out): Fresnel (Schlick with roughness; f0 0.04
// for dielectrics, toward 0.75 for metal) and, on water only, the minimum reflectance.
float Spec(float rough, float nv, float metal, float water) {
	float f0 = mix(0.04, 0.75, clamp(metal, 0.0, 1.0));
	float fr = f0 + (max(1.0 - rough, f0) - f0) * pow(1.0 - nv, 5.0);
	return max(fr, fparams.y * smoothstep(0.3, 0.8, water));
}

// ---- Hi-Z ----
void HizBase(ivec2 p) {
	float d = texelFetch(depth_tex, p, 0).r;
	float z = IsSky(d) ? FAR : min(abs(ViewZ(d)), FAR);
	if (isnan(z)) z = FAR;
	imageStore(hiz_out, p, vec4(z));
}
void HizDown(ivec2 p) {
	int   src = push.dec.w - 1;
	ivec2 sw  = textureSize(hiz_tex, src);
	ivec2 dw  = textureSize(hiz_tex, push.dec.w);
	ivec2 b   = p * 2;
	// (an odd size below: the last row / column of this mip takes the extra texel too, so floor(p / 2^level) covers all)
	int   ex  = (p.x == dw.x - 1 && sw.x > 2 * dw.x) ? 2 : 1;
	int   ey  = (p.y == dw.y - 1 && sw.y > 2 * dw.y) ? 2 : 1;
	float z   = FAR;
	for (int y = 0; y <= ey; ++y)
		for (int x = 0; x <= ex; ++x) z = min(z, texelFetch(hiz_tex, min(b + ivec2(x, y), sw - 1), src).r);
	imageStore(hiz_out, p, vec4(z));
}

// A ray as a screen segment (render pixels) with perspective-correct depth: a = P0 / w0, b = P1 / w1, h = 1 / w.
struct Ray {
	vec2  p0, dp;
	vec3  a, b;
	float h0, h1, sgn;
};
float RayDist(Ray r, float t) { return abs(mix(r.a.z, r.b.z, t) / mix(r.h0, r.h1, t)); }
// The t at which the ray reaches view distance `dist` (-1: never).
float RayTAt(Ray r, float dist) {
	float zt  = r.sgn * dist;
	float num = zt * r.h0 - r.a.z;
	float den = (r.b.z - r.a.z) - zt * (r.h1 - r.h0);
	return abs(den) > 1e-20 ? num / den : -1.0;
}
// Hierarchical-Z march over the closest-distance pyramid, t in [t, t_end] along the segment: the hit's t (-1: none).
int g_hiz_exit; // (rt4 stats) why HizTrace found nothing: 1 the segment's end, 2 the steps, 3 it left the screen
float HizTrace(Ray r, float t, float t_end, int max_iter, out float hit_z) {
	hit_z           = 0.0;
	g_hiz_exit      = 2;
	int   max_level = clamp(push.misc2.y - 1, 0, 9);
	int   level     = 0;
	bool  mx        = abs(r.dp.x) > 1e-5, my = abs(r.dp.y) > 1e-5;
	vec2  inv_dp    = vec2(mx ? 1.0 / r.dp.x : 0.0, my ? 1.0 / r.dp.y : 0.0);
	float eps_t     = 0.02 / max(max(abs(r.dp.x), abs(r.dp.y)), 1.0);
	vec2  rs        = RenderSize();
	for (int i = 0; i < max_iter; ++i) {
		if (t >= t_end) { g_hiz_exit = 1; return -1.0; }
		vec2 p = r.p0 + r.dp * t;
		if (p.x < 0.0 || p.y < 0.0 || p.x >= rs.x || p.y >= rs.y) { g_hiz_exit = 3; return -1.0; }
		float cs   = float(1 << level);
		vec2  cell = floor(p / cs);
		vec2  bnd  = (cell + vec2(r.dp.x > 0.0 ? 1.0 : 0.0, r.dp.y > 0.0 ? 1.0 : 0.0)) * cs;
		float tx   = mx ? (bnd.x - r.p0.x) * inv_dp.x : 2.0;
		float ty   = my ? (bnd.y - r.p0.y) * inv_dp.y : 2.0;
		float t_ex = max(min(tx, ty), t) + eps_t;
		float te   = min(t_ex, t_end);
		ivec2 ms   = textureSize(hiz_tex, level);
		float zmin = texelFetch(hiz_tex, clamp(ivec2(cell), ivec2(0), ms - 1), level).r;
		float d0 = RayDist(r, t), d1 = RayDist(r, te);
		float dlo = min(d0, d1), dhi = max(d0, d1);
		if (dhi < zmin) { // the ray passes in front of everything in this cell
			t     = t_ex;
			level = min(level + 1, max_level);
			continue;
		}
		if (level > 0) {
			// (moving away and still in front at the entry: skip to where it reaches the cell's closest distance)
			if (d0 < zmin && d1 > d0) {
				float tz = RayTAt(r, zmin);
				if (tz > t && tz < te) t = tz;
			}
			--level;
			continue;
		}
		// One pixel: a hit when the ray's span here overlaps the surface slab [zmin, zmin + thickness].
		float thick = push.params.y * (1.0 + zmin * 0.01); // (refl3: was 3 %/m: thick slabs smeared objects behind edges)
		if (dlo <= zmin + thick && dhi >= zmin) {
			float th = t;
			if (d0 < zmin) {
				float tz = RayTAt(r, zmin);
				if (tz >= t && tz <= te) th = tz;
			}
			hit_z = zmin;
			return th;
		}
		t = t_ex; // (behind the slab: the ray passes behind this pixel's surface)
	}
	return -1.0;
}

// GGX visible-normal sample around N (Dupuy & Benyoub 2023, spherical caps), the lobe's grazing tail trimmed.
vec3 SampleGgxVndf(vec3 N, vec3 V, float alpha, vec2 u) {
	vec3  up = abs(N.z) < 0.999 ? vec3(0, 0, 1) : vec3(1, 0, 0);
	vec3  tx = normalize(cross(up, N));
	vec3  ty = cross(N, tx);
	vec3  vl = vec3(dot(V, tx), dot(V, ty), dot(V, N));
	vec3  wi = normalize(vec3(alpha * vl.x, alpha * vl.y, vl.z));
	float phi = 2.0 * PI * u.x;
	float z   = (1.0 - u.y * 0.8) * (1.0 + wi.z) - wi.z;
	float st  = sqrt(clamp(1.0 - z * z, 0.0, 1.0));
	vec3  h   = vec3(st * cos(phi), st * sin(phi), z) + wi;
	vec3  hl  = normalize(vec3(alpha * h.x, alpha * h.y, max(h.z, 1e-6)));
	return normalize(tx * hl.x + ty * hl.y + N * hl.z);
}

bool WaterStable() { return (push.misc.w & 2048) != 0; }
bool MotionFix() { return mparams.w > -0.5; } // (refl-motion-1031; KYTY_RT_REFLECTIONS_MOTION=0: -1, off) // (water-1030, see WaterClamp)
bool Sampled(ivec2 p) { return ((p.x | p.y) & 3) == 0; } // (the stats: 1 pixel in 16)
// (one atomic per subgroup: the lanes active here summed first)
void Stat(int k, int v) {
	int sum = subgroupAdd(v);
	if (subgroupElect()) atomicAdd(calib[STATS + k], sum);
}

// (rtq1) KYTY_RTQ: the ray budget by contribution (Trace), a thread per 2x2 trace block (main), the composite's early out
// where the trace marked nothing (rt3's, without rt2) and its exactness check, and the checks below. Flags: 4194304 this
// frame's phase is the new one, 8388608 the counters (both phases of KYTY_RTQ_AB), 16777216 the debug view (F10).
bool Rtq() { return (push.misc.w & 4194304) != 0; }
bool RtqStats() { return (push.misc.w & 8388608) != 0; }
bool RtqDebug() { return (push.misc.w & 16777216) != 0; }
// (rpost1) The reflection's added light goes to post_img and is put on after the upscaler (mode 9): the temporal upscaler
// never accumulates it, so it is not reprojected by the floor's motion vectors (the doubled reflection while turning).
bool PostMode() { return (push.misc.w & 33554432) != 0; }
// QSTATS + k (cumulative, 1 pixel in 16; the CPU logs the difference per phase, "[rtq] reflejos"): trace (not water): 0
// candidates (past the weight early out), 1..3 by band (full / half / quarter rate), 4 marched this frame; 5 water
// (always full rate); composite: 6 pixels the early out would return, 7 of those where the full path differs from the
// game's pixel (> 0.1 % of its light: the early out would not be exact); temporal: 8 pixels not traced this frame, 9 of
// those with no traced neighbour on the same surface (a hole: the history alone); still camera: 10 shown reflections,
// 11 sum of their change from the last frame (parts of the pixel's light x 1000).
const int QSTATS = 1496;
void QStat(int k, int v) {
	int sum = subgroupAdd(v);
	if (subgroupElect()) atomicAdd(calib[QSTATS + k], sum);
}

// (des-refl2-1108) The floors' paths (PSTATS + k, sampled floor pixels): 0 floor (up-facing > 0.5, not a character),
// 1 water (WaterMask), 2 level by the per-pixel depth normal (des-refl-flat's test), 3 level only by the footprint's plane
// (LevelWide), 4 not level (the G-buffer / depth normal kept: bumps), 5 the G-buffer's normal-mapped normal matched, 6 the
// game's SSR confident (> gparams.x), 7 level floor where the game's SSR confidence differs from its footprint's by > 0.15
// (its blobs), 8 level floor where the roughness differs from its footprint's by > 0.08 (per-tile), 9 reflective (the
// trace's mask), 10 shown (weight > 0.05), 11 shown with a screen-space hit, 12 shown without one (the hybrid's TLAS fill
// or the history), 13 the full-resolution mirror ray, 14 sum of our weight x 1000 on level floors, 15 sum of the game's
// SSR share taken out x 1000 (of the pixel's luminance) on level floors, 16 shown on level floors, 17 shown on not-level
// floors, 18 shown on water, 19 guided (the game's SSR as the guide) floor pixels.
void PathStat(int k, int v) {
	int sum = subgroupAdd(v);
	if (subgroupElect()) atomicAdd(calib[PSTATS + k], sum);
}
// (rtrefl1) RSTATS: the reflection's history in motion (1/16 of the trace / render pixels; cumulative, never cleared; the CPU
// logs the difference every 10 s, "RT reflections: reprojection"), with KYTY_RT_REFLECTIONS_REPROJ on or off: 0 moving
// trace samples (> 0.5 px) with a valid history, 1 / 2 / 3 the history taken at the surface's motion / the reflected point
// by this pixel's hit distance / by the 3x3 mean hit distance, 4 sum of the taken history's distance to this frame's
// neighbourhood (YCoCg, in sigmas) x 100 (capped at 10), 5 that distance > 2 sigma; composite (render pixels): 6 moving
// reflection samples (Stabilize), 7 moving only by the reflection's own motion (the fix's extra "moving").
const int RSTATS = 1424;
void RStat(int k, int v) {
	int sum = subgroupAdd(v);
	if (subgroupElect()) atomicAdd(calib[RSTATS + k], sum);
}
bool ReprojFix() { return (push.misc.w & 16384) != 0; } // (rtrefl1: KYTY_RT_REFLECTIONS_REPROJ=1)
// (rt2: KYTY_RT2=1) The history position by the material, not by a per-pixel score: rtrefl1 took, per pixel, whichever of
// the surface / reflected-point histories was closest to this frame's 3x3 box; in motion neighbouring pixels of one
// reflection took different candidates (the box is noisy), a pattern that moved with the camera (an "onda"). Now: the
// reflected point (this pixel's own hit distance, else the 3x3 mean) for mirror-like and glossy surfaces, the surface's
// motion for rough ones (a blurred lobe), mixed over roughness 0.3 .. 0.5; the scores stay for the stats only.
bool Rt2() { return (push.misc.w & 32768) != 0; }
bool Rt3() { return (push.misc.w & 65536) != 0; } // (rt3: KYTY_RT3, the composite's early out from the trace's mask)
// (rtrefl1) The history at uv through a 5-tap Catmull-Rom (bilinear taps): the bilinear fetch alone blurs the history a
// little more every frame the reflection moves. Ringing is cut by the neighbourhood clamp after it.
// (rt3) The trace-sized images may be allocated larger than the trace in use (KYTY_RT3: the trace at the render size in
// images made at rt2's output size, so on / off switch without a reallocation): the history's normalized uv scaled to the
// part in use, clamped half a texel inside it (as the sampler's clamp to edge does on an exact-size image). Exact-size
// images (rt2, rt3 off): uv unchanged.
vec2 HistUv(vec2 uv) {
	vec2 as = vec2(textureSize(src_b, 0)), ts = TraceSize();
	if (all(equal(as, ts))) return uv;
	return clamp(uv, 0.5 / ts, 1.0 - 0.5 / ts) * ts / as;
}
vec4 HistAt(vec2 uv) { return textureLod(src_b, HistUv(uv), 0); }
vec4 HistCR(vec2 uv) {
	vec2  ts  = TraceSize();
	vec2  sp  = uv * ts;
	vec2  tp1 = floor(sp - 0.5) + 0.5;
	vec2  f   = sp - tp1;
	vec2  w0  = f * (-0.5 + f * (1.0 - 0.5 * f));
	vec2  w1  = 1.0 + f * f * (-2.5 + 1.5 * f);
	vec2  w2  = f * (0.5 + f * (2.0 - 1.5 * f));
	vec2  w3  = f * f * (-0.5 + 0.5 * f);
	vec2  w12 = w1 + w2;
	vec2  t0  = (tp1 - 1.0) / ts, t3 = (tp1 + 2.0) / ts, t12 = (tp1 + w2 / max(w12, vec2(1e-4))) / ts;
	vec4  r   = HistAt(vec2(t12.x, t0.y)) * (w12.x * w0.y) + HistAt(vec2(t0.x, t12.y)) * (w0.x * w12.y) +
	            HistAt(t12) * (w12.x * w12.y) + HistAt(vec2(t3.x, t12.y)) * (w3.x * w12.y) +
	            HistAt(vec2(t12.x, t3.y)) * (w12.x * w3.y);
	float ws  = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;
	return r / max(ws, 1e-4);
}
// (rtrefl1) How far a history sample is from this frame's neighbourhood (premultiplied YCoCg mean / sigma, confidence).
float HistScore(vec4 h, vec3 m1, vec3 sig, float a1, float asig) {
	if (Bad(h)) return 1e6;
	vec3 dy = (YCoCg(h.rgb) - m1) / (sig + vec3(0.01));
	return length(dy) + abs(h.a - a1) / (asig + 0.02);
}

// (water2-1030) out_c.w: the hit flag + 2 on water (WaterStable): the hybrid fill's source hysteresis is water only.
float WaterFlag(Surf s) { return (push.misc.w & 2048) != 0 && s.water > 0.0 ? 2.0 : 0.0; }
void StoreMiss(ivec2 px, Surf s) {
	imageStore(out_a, px, vec4(0));
	imageStore(out_c, px, vec4(s.rough, s.mask, 0, WaterFlag(s)));
}

// The march and the hit's validation (refl3). A ray that leaves the screen or finds nothing is a miss (the game's own
// reflection stays): nothing is ever stretched from the screen's edge. A hit is kept only when the surface there agrees
// with the ray: depth within the slab at the full-resolution pixel, not a silhouette (a depth jump next to it: the ray
// passed behind an object's edge, the streaks), facing the ray, not on the reflector's own plane; then faded smoothly
// by its distance to the screen's edges and by how much the ray turns toward the camera. Out: premultiplied
// (tonemapped exposed color x confidence, confidence) and the hit distance.
// (rt4 stats) g_why: why March returned what it did: 0 a hit, 1 off screen / toward the camera, 2 occluded or rejected
// (behind an object, silhouette, back face, own plane), 3 the sky, 4 nothing found (length, steps, degenerate);
// g_hitlin: the hit's linear luminance (before the exposure: the fill's calibration).
int   g_why;
float g_hitlin;
bool March(vec3 P, vec3 N, vec3 R, vec3 V, int iters, out vec4 res, out float hdist) {
	res      = vec4(0);
	hdist    = 0.0;
	g_why    = 4;
	g_hitlin = 0.0;
	// Rays toward the camera see what the screen does not hold: faded out early, and not marched when gone.
	float toward = 1.0 - smoothstep(0.05, 0.45, dot(R, V));
	if (toward < 1e-3) { g_why = 1; return false; }
	float dist = abs(P.z);
	float sgn  = P.z >= 0.0 ? 1.0 : -1.0;
	vec3  P0   = P + N * (0.002 * dist + 0.002);
	float len  = push.params.z;
	float fwd  = R.z * sgn;
	float d0   = abs(P0.z);
	if (fwd < 0.0) len = min(len, max((d0 - 0.2) / -fwd, 0.0));
	if (len < 0.02) return false;
	vec3  P1 = P0 + R * len;
	float w0 = ClipW(P0), w1 = ClipW(P1);
	if (!(abs(w0) > 1e-8 && abs(w1) > 1e-8) || w0 * w1 <= 0.0) return false;
	vec2 rs  = RenderSize();
	vec2 sp0 = Project(P0) * rs, sp1 = Project(P1) * rs;
	vec2 dp  = sp1 - sp0;
	if (BadV(vec3(sp0, sp1.x)) || isnan(sp1.y)) return false;
	float tmax = 1.0;
	if (dp.x > 1e-6) tmax = min(tmax, (rs.x - 0.5 - sp0.x) / dp.x);
	if (dp.x < -1e-6) tmax = min(tmax, (0.5 - sp0.x) / dp.x);
	if (dp.y > 1e-6) tmax = min(tmax, (rs.y - 0.5 - sp0.y) / dp.y);
	if (dp.y < -1e-6) tmax = min(tmax, (0.5 - sp0.y) / dp.y);
	if (fparams.z > 0.0) tmax = min(tmax, fparams.z / max(length(dp), 1e-6));
	tmax = clamp(tmax, 0.0, 1.0);
	// (rt4 stats: the segment ends at the screen's edge rather than at its length or the on-screen cap)
	bool clipped = tmax < 1.0 && !(fparams.z > 0.0 && tmax >= fparams.z / max(length(dp), 1e-6) - 1e-6);
	if (length(dp) * tmax < 1.0) { g_why = clipped ? 1 : 4; return false; }
	Ray r;
	r.p0  = sp0;
	r.dp  = dp;
	r.h0  = 1.0 / w0;
	r.h1  = 1.0 / w1;
	r.a   = P0 * r.h0;
	r.b   = P1 * r.h1;
	r.sgn = sgn;
	float t0    = min(1.5 / length(dp), tmax);
	float hit_z = 0.0;
	float th    = HizTrace(r, t0, tmax, iters, hit_z);
	if (th < 0.0) {
		g_why = (g_hiz_exit == 3 || (g_hiz_exit == 1 && clipped)) ? 1 : 4;
		return false;
	}
	vec2  hp  = r.p0 + r.dp * th;
	vec2  huv = hp / rs;
	if (!InScreen(huv)) { g_why = 1; return false; }
	float hd  = DepthAt(huv);
	if (IsSky(hd)) { g_why = 3; return false; } // (the sky is never a hit: the game's own sky reflection stays)
	g_why = 2; // (from here a refusal is an occlusion / rejection)
	vec3  HP = ViewPos(huv, hd);
	float zs = abs(HP.z);
	// Depth agreement at the full-resolution pixel: the ray within [surface - a little, surface + thickness].
	float zr    = RayDist(r, th);
	float thick = push.params.y * (1.0 + zs * 0.01);
	if (zr < zs - 0.05 * zs - 0.05 || zr > zs + thick) return false;
	// Silhouettes: a large depth jump next to the hit pixel (the ray slid behind an edge).
	// (1 / distance is linear across a plane on screen: its second difference is ~0 on any surface, large on an edge)
	vec2  t1 = 1.0 / rs;
	float iz = 1.0 / max(zs, 1e-3);
	float ixp = 1.0 / max(abs(ViewZ(DepthAt(huv + vec2(t1.x, 0)))), 1e-3), ixm = 1.0 / max(abs(ViewZ(DepthAt(huv - vec2(t1.x, 0)))), 1e-3);
	float iyp = 1.0 / max(abs(ViewZ(DepthAt(huv + vec2(0, t1.y)))), 1e-3), iym = 1.0 / max(abs(ViewZ(DepthAt(huv - vec2(0, t1.y)))), 1e-3);
	float j   = max(abs(ixp + ixm - 2.0 * iz), abs(iyp + iym - 2.0 * iz)) / iz;
	float sil = 1.0 - smoothstep(0.03, 0.10, j);
	vec3  HN   = NormalAt(huv, HP);
	float face = smoothstep(0.0, 0.25, dot(HN, -R));
	// (the reflector's own plane: a hit a short way off on a surface parallel to it is self-intersection)
	float self_ = (dot(HN, N) > 0.97 && length(HP - P) < 0.05 * dist + 0.1) ? 0.0 : 1.0;
	vec2  edge  = min(huv, 1.0 - huv);
	float fade  = smoothstep(0.0, 0.10, edge.x) * smoothstep(0.0, 0.10, edge.y);
	float conf  = clamp(fade * face * sil * self_ * toward, 0.0, 1.0);
	if (conf < 1e-3) return false;
	vec3 lin = SafeColor(textureLod(color_tex, huv, 0).rgb);
	vec3 c   = Tonemap(lin * GameExposure());
	res      = vec4(c * conf, conf);
	if (Bad(res)) return false;
	hdist    = length(HP - P);
	g_why    = 0;
	g_hitlin = Luma(lin);
	return true;
}

// `march`: false on the checkerboard's other half this frame: the surface is written, the reflection marked absent
// (alpha -1: the temporal pass keeps the history there).
void Trace(ivec2 px, bool march) {
	vec2  uv  = (vec2(px) + 0.5) / TraceSize();
	ivec2 rp  = RenderPixel(uv);
	vec2  ruv = (vec2(rp) + 0.5) / RenderSize();
	float d   = texelFetch(depth_tex, rp, 0).r;
	if (IsSky(d)) {
		imageStore(out_a, px, vec4(0));
		imageStore(out_b, px, vec4(0, 0, 1, 6.0e4)); // (f16: a far sky, never a neighbour)
		imageStore(out_c, px, vec4(1, 0, 0, 0));
		return;
	}
	vec3  P    = ViewPos(ruv, d);
	float dist = abs(P.z);
	Surf  s    = SurfaceAt(rp, ruv, P, d);
	imageStore(out_b, px, vec4(s.N, dist));
	if (s.mask < 0.01 || s.rough > push.motion.z) { StoreMiss(px, s); return; }
	vec3 V = normalize(-P);
	// Early out: the composite's weight (below) would stay under 0.02: no ray, and no reflection downstream.
	float wq = 1.0; // (rtq1) that weight: the ray budget's band below
	{
		// (refl8, guided: the game's share, strength gparams.w; the threshold lower, the share is the game's own)
		bool  gd   = GuideMode() && s.water <= 0.0;
		float west = (gd ? gparams.w : push.params.x) * s.mask * Spec(s.prough, clamp(dot(s.N, V), 0.0, 1.0), s.metal, s.water);
		if (gd) west = max(west, s.extra); // (refl9: the metal / glossy paths)
		wq = west;
		// (rt5) the game's split-sum weight x the material's reach (the composite's own weight, below 0.03 invisible)
		if (Rt5() && s.water <= 0.0 && s.gb > 0.5) {
			wq   = s.mask * Rt5Weight(s.prough, clamp(dot(s.N, V), 0.0, 1.0), s.metal);
			west = wq >= 0.03 ? 1.0 : 0.0;
		}
		if (west < (gd ? 0.01 : 0.02)) {
			s.mask = 0.0;
			StoreMiss(px, s);
			return;
		}
	}
	// (rt5) Adaptive sampling: rough lobes (perceptual roughness > 0.25, not water) march on half the pixels a frame (a
	// checkerboard alternating each frame); the temporal pass takes the traced neighbours on the same surface for the others
	// (as the whole-frame checkerboard does), so their blurred reflection costs half; mirrors and glossy surfaces every pixel.
	if (march && Rt5() && s.water <= 0.0 && s.prough > 0.25 && ((px.x + px.y + push.misc.y) & 1) != 0) {
		march = false;
		if (Sampled(px) && Rt5Stats()) R5Stat(28, 1);
	}
	// (rtq1) The ray budget by contribution: where the composite's weight is small, a ray only on part of the pixels each
	// frame and the temporal pass fills the others from this frame's traced neighbours on the same surface (as the
	// checkerboard): weight >= 0.10 every pixel, 0.05..0.10 half (the checkerboard, alternating per frame), below 0.05 a
	// quarter (of the checkerboard's pixels, the rows alternating every second frame: each 2x2 block one ray a frame, all
	// four in four frames). The pattern is the same in every aligned 2x2 block, so with a thread per block (main) the
	// lanes of a band march in the same iteration. Water keeps every ray. The level's checkerboard is applied here too.
	int qband = wq >= 0.10 ? 0 : (wq >= 0.05 ? 1 : 2);
	if (Rtq()) {
		bool odd = ((px.x + px.y + push.misc.y) & 1) != 0;
		if ((push.misc.w & 32) != 0 && odd) march = false;
		if (s.water <= 0.0 && qband >= 1 && odd) march = false;
		if (s.water <= 0.0 && qband >= 2 && (px.y & 1) != ((push.misc.y >> 1) & 1)) march = false;
	}
	if (RtqStats() && Sampled(px)) {
		if (s.water <= 0.0) QStat(0, 1), QStat(1 + qband, 1), QStat(4, march ? 1 : 0);
		else QStat(5, 1);
	}
	if (!march) {
		imageStore(out_a, px, vec4(0, 0, 0, -1));
		imageStore(out_c, px, vec4(s.rough, s.mask, 0, WaterFlag(s)));
		return;
	}
	bool st = Sampled(px);
	if (st) Stat(4, 1);
	if (st && Rt4Stats()) {
		R4Stat(8, s.water > 0.0 ? 1 : 0), R4Stat(9, s.water > 0.0 ? 0 : 1);
		R4Stat(28, s.tok > 0.0 ? 1 : 0), R4Stat(29, int(min(s.dev, 90.0) * 10.0)), R4Stat(30, s.tok > 1e-4 ? 1 : 0);
	}
	float f  = float(push.misc.y & 1023);
	vec2  xi = Rt4() ? Rt4Xi(px) : vec2(fract(Ign(vec2(px)) + f * 0.6180340), fract(Ign(vec2(px) + vec2(47.0, 17.0)) + f * 0.7548777));
	vec3  R;
	if (s.rough < 0.02) R = reflect(-V, s.N);
	else {
		vec3 H = SampleGgxVndf(s.N, V, max(s.rough * s.rough, 1e-3), xi);
		R      = reflect(-V, H);
		if (dot(R, s.N) <= 0.02) R = reflect(-V, s.N);
	}
	// (a normal-mapped normal can send the ray into the surface itself: kept just above its geometric plane)
	float rg = dot(R, s.Ng);
	if (rg < 0.01) R += s.Ng * (0.01 - rg);
	R = normalize(R);
	if (BadV(R)) { StoreMiss(px, s); return; }

	vec4 hc;
	float hdist;
	int   iters = max(int(float(push.misc2.z) * mix(1.0, 0.5, smoothstep(0.15, 0.45, s.rough))), 8);
	if (WaterStable() && s.water > 0.0) iters += iters / 2; // (water-1030: water's mirror ray finds more, a finer march)
	bool  hit  = March(P, s.N, R, V, iters, hc, hdist);
	int   why  = hit ? 0 : g_why;
	if (!hit) hc = vec4(0), hdist = 0.0;
	float conf = hit ? clamp(hc.a, 0.0, 1.0) : 0.0;
	if (st && Rt5Stats()) {
		float nv5 = clamp(dot(s.N, V), 0.0, 1.0);
		int   b   = nv5 < 0.3 ? 0 : nv5 < 0.7 ? 1 : 2;
		R5Stat(29, 1);
		for (int k = 0; k < 3; ++k) R5Stat(22 + k * 2, b == k ? 1 : 0), R5Stat(23 + k * 2, b == k && hit && conf >= 0.5 ? 1 : 0);
	}
	if (st && Rt4Stats()) {
		R4Stat(0, 1), R4Stat(1, hit && conf >= 0.5 ? 1 : 0), R4Stat(2, hit && conf < 0.5 ? 1 : 0);
		R4Stat(3, why == 1 ? 1 : 0), R4Stat(4, why == 2 ? 1 : 0), R4Stat(5, why == 3 ? 1 : 0), R4Stat(6, !hit && why == 4 ? 1 : 0);
	}
	// (rt4) The fill: where the ray left the screen, was occluded, saw the sky or found nothing, and where its confidence fades
	// (the screen's edges, silhouettes, back faces, rays turning toward the camera), what the game itself reflects there: its
	// specular IBL (its SSR blended with the local box cubemaps and the distant one, kRTT_SpecularIBL_HalfResX) as radiance,
	// mixed in by 1 - the ray's confidence. The result is complete on every reflective pixel: no hole where a ray misses, no
	// reflection that appears or vanishes as an object enters or leaves the screen. Not water (the game's IBL there is the
	// bed's, under it) and only on the surface the game lit (not something drawn after the lighting).
	float fw  = clamp(rparams.z, 0.0, 1.0) * (1.0 - conf);
	bool  cal = hit && conf > 0.9 && s.rough < 0.2 && ((px.x | px.y) & 7) == 0 && g_hitlin > 1e-7;
	if (Rt4() && HaveIbl() && (fw > 1e-3 || cal) && s.water <= 0.0 && GbufSurface(rp, d, s.gb > 0.5)) {
		vec3  ibl = SpecIblAt(ruv, dist);
		float nv  = clamp(dot(s.N, V), 0.0, 1.0);
		// (the calibration: confident, mirror-like hits against the IBL here, both models; 1 pixel in 64)
		if (cal) {
			float l0 = Luma(IblRadiance(ibl, s.prough, nv, s.metal, 0)), l1 = Luma(IblRadiance(ibl, s.prough, nv, s.metal, 1));
			if (l0 > 1e-7 && l1 > 1e-7) {
				int v0 = int(clamp(log2(g_hitlin / l0), -8.0, 8.0) * 64.0);
				int v1 = int(clamp(log2(g_hitlin / l1), -8.0, 8.0) * 64.0);
				R4Stat(10, 1), R4Stat(11, v0), R4Stat(12, (v0 * v0) / 4), R4Stat(13, v1), R4Stat(14, (v1 * v1) / 4);
			}
		}
		if (fw > 1e-3) {
			// (rt5: the game's own radiance at scale 1, so a miss changes nothing in the composite's replacement)
			vec3 L  = IblRadiance(ibl, s.prough, nv, s.metal, rparams.y > 0.5 ? 1 : 0) * (Rt5() ? 1.0 : max(rparams.x, 0.0));
			vec3 fc = Tonemap(SafeColor(L * GameExposure()));
			vec4 hf = vec4(hc.rgb + fc * fw, conf + fw);
			if (!Bad(hf)) hc = hf;
			if (st && Rt4Stats()) R4Stat(7, fw > 0.05 ? 1 : 0);
		}
	}
	if (!(hc.a >= 1e-3)) { StoreMiss(px, s); return; }
	if (st && hit) Stat(5, 1);
	imageStore(out_a, px, hc);
	// (rt5: the hit's own confidence in the flag's fraction, HitConf)
	float hf = hit ? (Rt5() ? 0.51 + 0.49 * conf : 1.0) : 0.0;
	imageStore(out_c, px, vec4(s.rough, s.mask, hdist, hf + WaterFlag(s)));
}

void Temporal(ivec2 px) {
	vec2  ts  = TraceSize();
	vec2  uv  = (vec2(px) + 0.5) / ts;
	vec4  g   = texelFetch(gb_cur, px, 0);
	vec4  ax  = texelFetch(aux_tex, px, 0);
	vec4  cur = texelFetch(src_a, px, 0);
	bool  fresh = cur.a >= 0.0; // (false: not traced this frame, the checkerboard)
	if (g.w > 5e4 || ax.y < 0.01 || ax.x > push.motion.z) {
		imageStore(out_a, px, vec4(0));
		imageStore(out_b, px, vec4(0));
		return;
	}
	float rough = ax.x;
	// The 3x3 neighbourhood on the same surface (YCoCg of the premultiplied color, confidence).
	vec3  m1 = vec3(0), m2 = vec3(0);
	float a1 = 0.0, a2 = 0.0, l1 = 0.0, l2 = 0.0, wn = 0.0, wraw = 0.0;
	vec4  mean = vec4(0);
	ivec2 hi   = ivec2(ts) - 1;
	bool  rfix = ReprojFix();
	float hsum = 0.0, hn = 0.0; // (rtrefl1: the same-surface neighbours' hit distances)
	float cs5 = 0.0, cn5 = 0.0; // (rt5)
	for (int y = -1; y <= 1; ++y)
		for (int x = -1; x <= 1; ++x) {
			ivec2 q  = clamp(px + ivec2(x, y), ivec2(0), hi);
			vec4  sg = texelFetch(gb_cur, q, 0);
			vec4  sv = texelFetch(src_a, q, 0);
			float w  = (abs(sg.w - g.w) < 0.05 * g.w && dot(sg.xyz, g.xyz) > 0.8 && sv.a >= 0.0) ? 1.0 : 0.0;
			if ((rfix || Rt5()) && w > 0.0) {
				vec4 sa = texelFetch(aux_tex, q, 0);
				if (mod(sa.w, 2.0) > 0.5 && sa.z > 0.0) hsum += sa.z, hn += 1.0;
				cs5 += HitConf(sa.w), cn5 += 1.0; // (rt5: the neighbours' hit confidence, misses included)
			}
			vec3  yc = YCoCg(sv.rgb);
			float l  = Luma(sv.rgb);
			m1 += yc * w, m2 += yc * yc * w;
			a1 += sv.a * w, a2 += sv.a * sv.a * w;
			l1 += l * w, l2 += l * l * w;
			mean += sv * w;
			wn += w;
		}
	wraw = wn;
	wn   = max(wn, 1.0);
	m1 /= wn, m2 /= wn, a1 /= wn, a2 /= wn, l1 /= wn, l2 /= wn, mean /= wn;
	if (!fresh) cur = mean; // (the traced neighbours on the same surface; nothing: zero)
	if (RtqStats() && Sampled(px) && !fresh) QStat(8, 1), QStat(9, wraw < 0.5 ? 1 : 0); // (rtq1)
	vec3  sig  = sqrt(max(m2 - m1 * m1, vec3(0)));
	float asig = sqrt(max(a2 - a1 * a1, 0.0));
	float svar = max(l2 - l1 * l1, 0.0);
	// (refl9b) Fireflies: this frame's sample at most the neighbourhood's mean luminance + 2.5 sigma (a lone bright hit on
	// a noisy glossy pixel sparkled frame to frame)
	if (fresh && wraw > 2.0) {
		float lcur = Luma(cur.rgb), lim = l1 + 2.5 * sqrt(svar) + 0.02;
		if (lcur > lim) cur.rgb *= lim / max(lcur, 1e-6);
	}

	vec4  res;
	float len, mo1, mo2;
	float lc = Luma(cur.rgb);
	// (rt5) Static surfaces that are not water (the motion vector within 2 px of the camera's reprojection): the reflection's
	// history at its own previous position, the camera's reprojection of its virtual image point (Rt5VirtDist: the hits'
	// distance, the fill at infinity, mixed by the confidence), fetched once. rt2 mixed two history fetches (the surface's
	// and the reflected point's) on glossy surfaces and took 85-95 % of the new frame as soon as anything moved: rotating,
	// both positions are the same point (sharp); walking, they part (a double image, then a short noisy history that the
	// a-trous blurs, re-accumulating when the player stops: the blur seen when walking and stopping). Here the history keeps
	// its length in motion when its reprojection is right, and is let go by how far it is from this frame's neighbourhood
	// (sigmas), not by the speed. Characters (the motion vector disagrees) and water keep the paths below.
	bool done5 = false;
	if (Rt5() && (push.misc.w & 4) != 0 && ax.w <= 1.5) {
		vec2  rs  = RenderSize();
		vec2  ruv = (vec2(RenderPixel(uv)) + 0.5) / rs;
		vec3  P   = ViewPos(ruv, DepthAt(uv));
		vec2  pm  = uv + texelFetch(motion_tex, RenderPixel(uv), 0).xy * push.motion.xy / rs;
		vec2  s0  = PrevUv(P, false), s1 = PrevUv(P, true);
		float e0  = length((s0 - pm) * rs), e1 = length((s1 - pm) * rs);
		bool  fl  = e1 < e0;
		float em  = min(e0, e1);
		vec2  sc  = fl ? s1 : s0;
		if (!isnan(em) && em < 2.0 && !any(isnan(sc)) && !any(isinf(sc))) {
			done5 = true;
			float dS  = length(P);
			float own = (mod(ax.w, 2.0) > 0.5 && ax.z > 0.0) ? ax.z : 0.0;
			float hdv = hn > 0.0 ? hsum / hn : own;
			if (rough < 0.05 && own > 0.0) hdv = own; // (mirrors: their own hit, sharp)
			float cf  = cn5 > 0.0 ? cs5 / cn5 : HitConf(ax.w);
			vec2  pv  = PrevUv(normalize(P) * Rt5VirtDist(dS, hdv, cf, rough), fl);
			vec2  pr  = (any(isnan(pv)) || any(isinf(pv))) ? sc : pv;
			int   cls = CamClass(ruv, P);
			bool  vld = (push.misc.w & 1) == 0 && (push.misc.w & 2) != 0 && InScreen(sc);
			vec4  mt  = vec4(0);
			if (vld) {
				ivec2 pp = clamp(ivec2(sc * ts), ivec2(0), hi);
				vec4  pg = texelFetch(gb_prev, pp, 0);
				vld      = abs(pg.w - g.w) / max(g.w, 1e-3) < 0.06 && dot(pg.xyz, g.xyz) > 0.85;
				mt       = texelFetch(meta_tex, pp, 0);
				if (Bad(mt)) vld = false;
			}
			// (the reflected point's previous position must lie on the same kind of surface: else the surface's own)
			bool vfail = false;
			if (vld && (!InScreen(pr) || !(texelFetch(gb_prev, clamp(ivec2(pr * ts), ivec2(0), hi), 0).w < 5e4) ||
			            dot(texelFetch(gb_prev, clamp(ivec2(pr * ts), ivec2(0), hi), 0).xyz, g.xyz) < 0.85))
				pr = sc, vfail = true;
			float hsc = 0.0, hw = 0.0;
			if (vld) {
				float vp   = length((pr - uv) * rs);
				vec4  hist = vp > 0.5 ? HistCR(pr) : HistAt(pr);
				if (Bad(hist)) hist = cur;
				hist = max(hist, vec4(0));
				hsc  = wraw >= 3.0 ? HistScore(hist, m1, sig, a1, asig) : 0.0;
				float k  = mix(0.75, 2.5, smoothstep(0.05, 0.4, rough)) * (vfail ? 0.5 : 1.0);
				vec3  hy = clamp(YCoCg(hist.rgb), m1 - k * sig - 1e-4, m1 + k * sig + 1e-4);
				hist.rgb = max(Rgb(hy), vec3(0));
				hist.a   = clamp(hist.a, a1 - k * asig - 0.02, a1 + k * asig + 0.02);
				int   sh   = int(yparams.z + 0.5);
				len        = min(mt.x + 1.0, sh == 2 ? 8.0 : sh == 1 ? 16.0 : 32.0);
				float amin = mix(0.25, 0.04, smoothstep(0.02, 0.3, rough)) * push.motion.w;
				if (sh == 1) amin = max(amin * 1.5, mix(0.35, 0.08, smoothstep(0.02, 0.3, rough)));
				if (sh == 2) amin = max(amin * 2.0, mix(0.45, 0.14, smoothstep(0.02, 0.3, rough)));
				float alpha = max(1.0 / len, amin);
				// (let go by disagreement, not by speed: a history 2..4 sigmas off this frame's neighbourhood fades to 70 % new)
				float rj = max(smoothstep(2.0, 4.0, hsc), vfail ? 0.5 : 0.0);
				alpha    = mix(alpha, max(alpha, 0.7), rj);
				len      = mix(len, min(len, 4.0), rj);
				if (fresh && cur.a < hist.a * 0.5) alpha *= 0.5;
				{
					float lh = Luma(hist.rgb), lf = Luma(cur.rgb);
					if (fresh && (lf > 2.0 * lh + 0.02 || lh > 2.0 * lf + 0.02)) alpha *= 0.5;
				}
				if (!fresh) {
					len   = max(mt.x, 1.0);
					alpha = wraw > 0.0 ? alpha * 0.5 : 0.0;
				}
				res = mix(hist, cur, alpha);
				mo1 = mix(mt.y, lc, alpha);
				mo2 = mix(mt.z, lc * lc, alpha);
				hw  = 1.0 - alpha;
			} else {
				res = rough > 0.1 ? mix(cur, mean, 0.5) : cur;
				len = 1.0;
				mo1 = lc, mo2 = lc * lc;
			}
			if (Rt5Stats() && Sampled(px)) {
				R5Stat(cls * 4 + 0, 1), R5Stat(cls * 4 + 1, vld ? 1 : 0), R5Stat(cls * 4 + 2, int(hw * 1000.0));
				R5Stat(cls * 4 + 3, int(min(hsc, 10.0) * 100.0));
			}
		}
	}
	if (!done5) {
	// Reprojection: the surface by its motion vector; its reflection by the virtual image point behind the mirror.
	vec2 mv    = texelFetch(motion_tex, RenderPixel(uv), 0).xy * push.motion.xy / RenderSize();
	vec2 puv_s = uv + mv;
	vec2 puv   = puv_s;
	// (rtrefl1) the reflected point's candidates (the history position is chosen below, against this frame's neighbourhood)
	vec2 cand_own = puv_s, cand_nb = puv_s;
	bool own_ok = false, nb_ok = false, par_used = false;
	if (rfix && (push.misc.w & 4) != 0) {
		float d  = DepthAt(uv);
		vec3  P  = ViewPos((vec2(RenderPixel(uv)) + 0.5) / RenderSize(), d);
		vec2  s0 = PrevUv(P, false), s1 = PrevUv(P, true);
		float e0 = length((s0 - puv_s) * RenderSize()), e1 = length((s1 - puv_s) * RenderSize());
		bool  fl = e1 < e0;
		// (water, WaterStable's flag in ax.w: the camera's reprojection, never the motion vector: the game's water writes its
		// animated ripples into the motion vectors, which moved the history in waves on a still camera, as Stabilize knew)
		bool wat = ax.w > 1.5;
		// (rt4) How far the game's motion vectors are from the camera's own reprojection on static surfaces (within 2 px),
		// water apart: water's animated ripples write their own motion; stone and tiles should show ~0 here.
		float em = min(e0, e1);
		if (Rt4Stats() && Sampled(px) && !isnan(em) && em < 2.0) {
			if (wat) R4Stat(25, 1), R4Stat(26, int(em * 100.0));
			else R4Stat(23, 1), R4Stat(24, int(em * 100.0));
		}
		// (rt4) Not water and static (within 2 px of the camera's reprojection): the camera's reprojection itself, as water
		// already has; the history of stone and tiles no longer follows any wobble in the motion vectors.
		bool cam4 = Rt4() && !wat && !isnan(em) && em < 2.0;
		if (cam4 && Sampled(px)) R4Stat(27, 1);
		if ((wat || cam4) && !any(isnan(fl ? s1 : s0)) && !any(isinf(fl ? s1 : s0))) {
			puv_s = fl ? s1 : s0;
			mv    = puv_s - uv;
			if (wat) e0 = e1 = 0.0;
		}
		if (min(e0, e1) < 3.0) {
			vec2  sc   = fl ? s1 : s0;
			float hown = (mod(ax.w, 2.0) > 0.5 && ax.z > 0.0) ? ax.z : 0.0;
			float hnb  = hn > 0.0 ? hsum / hn : 0.0;
			if (hown > 0.0) {
				vec2 dv = PrevUv(P + normalize(P) * hown, fl) - sc;
				if (!any(isnan(dv)) && !any(isinf(dv)) && length(dv) < 0.25) cand_own = puv_s + dv, own_ok = InScreen(cand_own);
			}
			if (hnb > 0.0) {
				vec2 dv = PrevUv(P + normalize(P) * hnb, fl) - sc;
				if (!any(isnan(dv)) && !any(isinf(dv)) && length(dv) < 0.25) cand_nb = puv_s + dv, nb_ok = InScreen(cand_nb);
			}
		}
		// (the motion measure below: the reflected point's, as before from this pixel's own hit, else the neighbours')
		puv = own_ok ? cand_own : nb_ok ? cand_nb : puv_s;
	}
	if (!rfix && (push.misc.w & 4) != 0 && mod(ax.w, 2.0) > 0.5 && ax.z > 0.0) {
		float d  = DepthAt(uv);
		vec3  P  = ViewPos((vec2(RenderPixel(uv)) + 0.5) / RenderSize(), d);
		vec3  Xv = P + normalize(P) * ax.z;
		vec2  s0 = PrevUv(P, false), s1 = PrevUv(P, true);
		float e0 = length((s0 - puv_s) * RenderSize()), e1 = length((s1 - puv_s) * RenderSize());
		bool  fl = e1 < e0;
		// (only where the camera's matrices agree with the game's motion vector: static surfaces, the right frame)
		if (min(e0, e1) < 3.0) {
			// (refl-motion-1031: alta / maxima the reflected point's parallax up to glossier surfaces too)
			float wv = MotionFix() && int(yparams.z + 0.5) >= 1 ? 1.0 - smoothstep(0.25, 0.6, rough) : 1.0 - smoothstep(0.1, 0.45, rough);
			vec2  vp = PrevUv(Xv, fl);
			vec2  dv = vp - (fl ? s1 : s0);
			if (!any(isnan(dv)) && length(dv) < 0.25) puv = puv_s + dv * wv, par_used = wv > 0.5;
		}
	}
	bool  valid = (push.misc.w & 1) == 0 && (push.misc.w & 2) != 0 && InScreen(puv_s) && InScreen(puv);
	vec4  meta  = vec4(0);
	// (refl-motion-1031) How fast the surface and its reflection move on screen (render pixels a frame, the larger of the
	// two reprojections): 0 below 0.5 px (a still camera, its jitter: exactly as before), 1 from 3 px (Normal) / 2 px (Alta,
	// Maxima). At speed the history's share falls and its colour box tightens, so the reflection does not smear.
	float tmov = 0.0;
	if (MotionFix()) {
		vec2  rsz = RenderSize();
		float vp  = max(length(mv * rsz), length((puv - uv) * rsz));
		if (isnan(vp) || isinf(vp)) vp = 0.0;
		tmov = smoothstep(0.5, int(yparams.z + 0.5) >= 1 ? 2.0 : 3.0, vp);
	}
	if (valid) {
		ivec2 pp = clamp(ivec2(puv_s * ts), ivec2(0), hi);
		vec4  pg = texelFetch(gb_prev, pp, 0);
		float dz = abs(pg.w - g.w) / max(g.w, 1e-3);
		valid    = dz < 0.06 && dot(pg.xyz, g.xyz) > 0.85;
		meta     = texelFetch(meta_tex, pp, 0);
		if (Bad(meta)) valid = false;
	}
	if (valid) {
		vec4  hist = HistAt(puv);
		bool  rst  = Sampled(px) && tmov > 0.5; // (rtrefl1: the stats, moving samples)
		int   pick = par_used ? 1 : 0;
		float hsc  = 0.0;
		if (rfix) {
			// (rtrefl1) the candidate whose history agrees best with this frame's neighbourhood (few neighbours: no
			// measure, this pixel's own reflected point as before, else the neighbours', else the surface)
			vec4  h0 = HistAt(puv_s);
			vec4  h1 = own_ok ? HistAt(cand_own) : h0;
			vec4  h2 = nb_ok ? HistAt(cand_nb) : h0;
			float c0 = HistScore(h0, m1, sig, a1, asig);
			float c1 = own_ok ? HistScore(h1, m1, sig, a1, asig) : 1e6;
			float c2 = nb_ok ? HistScore(h2, m1, sig, a1, asig) : 1e6;
			if (wraw < 3.0) pick = own_ok ? 1 : nb_ok ? 2 : 0;
			else pick = (c2 <= c1 && c2 < c0 * 0.98) ? 2 : (c1 < c0 * 0.98) ? 1 : 0; // (ties: the surface, a still camera)
			float wpar = 0.0; // (rt2: the reflected point's share)
			if (Rt2()) {
				int rp = own_ok ? 1 : nb_ok ? 2 : 0;
				wpar   = rp != 0 ? 1.0 - smoothstep(0.3, 0.5, rough) : 0.0;
				pick   = wpar > 0.5 ? rp : 0;
				vec4 hr = rp == 1 ? h1 : rp == 2 ? h2 : h0;
				if (Bad(hr)) hr = h0, wpar = 0.0;
				puv  = pick == 1 ? cand_own : pick == 2 ? cand_nb : puv_s;
				hist = Bad(h0) ? hr : mix(h0, hr, wpar);
				hsc  = HistScore(hist, m1, sig, a1, asig);
				if (tmov > 0.0) {
					// (moving: the sharper fetch for both, mixed the same way)
					vec2 pr  = rp == 1 ? cand_own : rp == 2 ? cand_nb : puv_s;
					vec4 hc0 = length((puv_s - uv) * RenderSize()) > 0.5 ? HistCR(puv_s) : h0;
					vec4 hcr = length((pr - uv) * RenderSize()) > 0.5 ? HistCR(pr) : hr;
					if (!Bad(hc0) && !Bad(hcr)) hist = max(mix(hc0, hcr, wpar), vec4(0));
				}
			} else {
			puv  = pick == 1 ? cand_own : pick == 2 ? cand_nb : puv_s;
			hist = pick == 1 ? h1 : pick == 2 ? h2 : h0;
			hsc  = pick == 1 ? c1 : pick == 2 ? c2 : c0;
			// (moving more than half a pixel: the sharper fetch; still: the bilinear one, exactly as before)
			if (tmov > 0.0 && length((puv - uv) * RenderSize()) > 0.5) {
				vec4 hc = HistCR(puv);
				if (!Bad(hc)) hist = max(hc, vec4(0));
			}
			}
		} else if (rst) hsc = HistScore(hist, m1, sig, a1, asig);
		if (rst) {
			RStat(0, 1), RStat(1, pick == 0 ? 1 : 0), RStat(2, pick == 1 ? 1 : 0), RStat(3, pick == 2 ? 1 : 0);
			RStat(4, int(min(hsc, 10.0) * 100.0)), RStat(5, hsc > 2.0 ? 1 : 0);
		}
		if (Bad(hist)) hist = cur;
		float k    = mix(0.75, 2.5, smoothstep(0.05, 0.4, rough)); // (refl3: mirrors clamped tighter: no ghosts)
		k         *= mix(1.0, int(yparams.z + 0.5) >= 1 ? 0.4 : 0.6, tmov); // (refl-motion-1031: the YCoCg box tighter in motion)
		vec3  hy   = clamp(YCoCg(hist.rgb), m1 - k * sig - 1e-4, m1 + k * sig + 1e-4);
		hist.rgb   = max(Rgb(hy), vec3(0));
		hist.a     = clamp(hist.a, a1 - k * asig - 0.02, a1 + k * asig + 0.02);
		int   sh    = int(yparams.z + 0.5); // (refl-sharp-1031: alta / maxima a shorter history)
		len        = min(meta.x + 1.0, sh == 2 ? 8.0 : sh == 1 ? 16.0 : 32.0);
		// Mirrors follow quickly (a parallax error would ghost); rough surfaces average longer.
		float amin  = mix(0.25, 0.04, smoothstep(0.02, 0.3, rough)) * push.motion.w; // (refl3: mirrors 0.25, was 0.15)
		if (sh == 1) amin = max(amin * 1.5, mix(0.35, 0.08, smoothstep(0.02, 0.3, rough)));
		if (sh == 2) amin = max(amin * 2.0, mix(0.45, 0.14, smoothstep(0.02, 0.3, rough)));
		float alpha = max(1.0 / len, amin);
		// (refl-motion-1031) in motion the new frame's share rises toward amov (less on rough surfaces: their noise)
		if (tmov > 0.0) {
			float amov = (sh == 2 ? 0.85 : sh == 1 ? 0.7 : 0.5) * mix(1.0, 0.6, smoothstep(0.1, 0.5, rough));
			alpha      = mix(alpha, max(alpha, amov), tmov);
			len        = mix(len, min(len, 4.0), tmov);
		}
		// (a miss this frame against a held reflection: the history fades slowly instead of popping)
		if (fresh && cur.a < hist.a * 0.5) alpha *= 0.5;
		// (refl9b) a sample far brighter or darker than the history: taken in more slowly (per-pixel flicker)
		{
			float lh = Luma(hist.rgb), lf = Luma(cur.rgb);
			if (fresh && (lf > 2.0 * lh + 0.02 || lh > 2.0 * lf + 0.02)) alpha *= 0.5;
		}
		if (!fresh) {
			// (no sample of its own this frame: the history, nudged toward the traced neighbours)
			len   = max(meta.x, 1.0);
			alpha = wraw > 0.0 ? alpha * 0.5 : 0.0;
		}
		res         = mix(hist, cur, alpha);
		mo1         = mix(meta.y, lc, alpha);
		mo2         = mix(meta.z, lc * lc, alpha);
	} else {
		// (no history: rough surfaces start from the neighbourhood's mean, less noisy)
		res = rough > 0.1 ? mix(cur, mean, 0.5) : cur;
		len = 1.0;
		mo1 = lc, mo2 = lc * lc;
	}
	}
	float var = max(mo2 - mo1 * mo1, 0.0);
	if (len < 4.0) var = max(var, svar);
	if (Bad(res)) res = vec4(0);
	res.rgb = clamp(res.rgb, vec3(0), vec3(1));
	res.a   = clamp(res.a, 0.0, 1.0);
	imageStore(out_a, px, res);
	imageStore(out_b, px, vec4(len, mo1, mo2, var));
}

void Atrous(ivec2 px) {
	vec2 ts = TraceSize();
	vec4 g  = texelFetch(gb_cur, px, 0);
	vec4 c  = texelFetch(src_a, px, 0);
	vec4 ax = texelFetch(aux_tex, px, 0);
	float rough = ax.x;
	// Mirrors (and pixels with nothing) stay as they are.
	int sh = int(yparams.z + 0.5); // (refl-sharp-1031: 0 normal, 1 alta, 2 maxima)
	if (g.w > 5e4 || ax.y < 0.01 || rough < (sh == 2 ? 0.08 : sh == 1 ? 0.05 : 0.03)) {
		imageStore(out_a, px, c);
		return;
	}
	// (fgrt-1029) Sharp glossy reflections: the passes by roughness (none below 0.12, one below 0.25, all above), and a
	// smaller radius the glossier the surface.
	int allowed = rough < 0.12 ? 0 : rough < 0.25 ? 1 : 8;
	if (sh == 1) allowed = rough < 0.18 ? 0 : rough < 0.35 ? 1 : 2;
	if (sh == 2) allowed = rough < 0.25 ? 0 : rough < 0.45 ? 1 : 2;
	if (push.params.w >= float(1 << allowed)) {
		imageStore(out_a, px, c);
		return;
	}
	float var  = texelFetch(meta_tex, px, 0).w;
	float step = push.params.w * mix(0.2, 1.0, smoothstep(0.12, 0.50, rough));
	// Contact reflections (a short hit distance) stay sharp: the blur grows with the hit distance.
	// (far away the same pixel radius covers far more surface: the radius shrinks with distance; grazing, sharper)
	step *= clamp(25.0 / max(g.w, 1e-3), 0.3, 1.0);
	if (ax.z > 0.0) step *= clamp(ax.z / max(g.w * 0.1, 1e-3), 0.3, 1.0);
	step          *= sh == 2 ? 0.4 : sh == 1 ? 0.65 : 1.0; // (refl-sharp-1031: a smaller radius)
	step           = max(step, 1.0);
	const float kern[3] = float[](0.375, 0.25, 0.0625);
	float lc       = c.a > 1e-3 ? Luma(c.rgb / c.a) : 0.0;
	float sl       = 4.0 * sqrt(max(var, 0.0)) + 0.02;
	vec4  sum      = vec4(0);
	float wsum     = 0.0;
	ivec2 hi       = ivec2(ts) - 1;
	for (int y = -2; y <= 2; ++y)
		for (int x = -2; x <= 2; ++x) {
			ivec2 q  = clamp(px + ivec2(round(vec2(x, y) * step)), ivec2(0), hi);
			vec4  sg = texelFetch(gb_cur, q, 0);
			vec4  sa = texelFetch(aux_tex, q, 0);
			vec4  sc = texelFetch(src_a, q, 0);
			if (sa.y < 0.01 || sg.w > 5e4) continue;
			float wz = exp(-abs(sg.w - g.w) / max(g.w * 0.02 * step, 1e-3));
			float wn = pow(max(dot(sg.xyz, g.xyz), 0.0), 64.0);
			float wr = exp(-abs(sa.x - rough) * 10.0);
			float wl = (sc.a > 1e-3 && c.a > 1e-3) ? exp(-abs(Luma(sc.rgb / sc.a) - lc) / sl) : 1.0;
			float w  = kern[abs(x)] * kern[abs(y)] * wz * wn * wr * wl;
			sum += sc * w;
			wsum += w;
		}
	vec4 r = wsum > 1e-6 ? sum / wsum : c;
	if (Bad(r)) r = c;
	imageStore(out_a, px, r);
}

// Bilateral upsample of the trace-resolution reflection and its surface (roughness, mask): distance and normal weights.
void Upsample(vec2 uv, float z, vec3 N, out vec4 rf, out vec4 ax) {
	vec2  tc   = uv * TraceSize() - 0.5;
	vec2  f    = fract(tc);
	ivec2 b    = ivec2(floor(tc));
	ivec2 mx   = ivec2(TraceSize()) - 1;
	vec4  sum  = vec4(0), asum = vec4(0);
	float wsum = 0.0;
	for (int i = 0; i < 4; ++i) {
		ivec2 o  = ivec2(i & 1, i >> 1);
		ivec2 q  = clamp(b + o, ivec2(0), mx);
		float bw = (o.x == 1 ? f.x : 1.0 - f.x) * (o.y == 1 ? f.y : 1.0 - f.y);
		vec4  sg = texelFetch(gb_cur, q, 0);
		float w  = (bw + 1e-3) * exp(-abs(sg.w - z) / max(z * 0.03, 1e-3)) * pow(max(dot(sg.xyz, N), 0.0), 16.0);
		sum += texelFetch(src_a, q, 0) * w;
		asum += texelFetch(aux_tex, q, 0) * w;
		wsum += w;
	}
	rf = wsum > 1e-5 ? sum / wsum : vec4(0);
	ax = wsum > 1e-5 ? asum / wsum : vec4(1, 0, 0, 0);
}

// (refl9b) How much of the floor around a pixel reflects too: 16 taps of the trace's mask (8 directions x half and the
// whole of yparams.x render pixels) on the same surface (distance within 10 %, normal within ~35 degrees). Tiny puddles
// and closely packed wet specks in mud (a few noisy glossy pixels: the floor sparkled, refl9 feedback) cover little of it
// and are faded out; large puddles and water cover nearly all of it and are boosted (Pools). 1 when off.
float Coverage(vec2 uv, float z, vec3 N) {
	if (!(yparams.x > 0.5)) return 1.0;
	vec2  ts = TraceSize();
	ivec2 hi = ivec2(ts) - 1;
	vec2  tc = uv * ts;
	float r  = yparams.x * ts.y / RenderSize().y; // (trace pixels)
	float c  = 0.0;
	for (int i = 0; i < 16; ++i) {
		float a  = (float(i & 7) + (i >= 8 ? 0.5 : 0.0)) * (PI * 0.25);
		float rr = i >= 8 ? r : r * 0.5;
		ivec2 q  = clamp(ivec2(tc + vec2(cos(a), sin(a)) * max(rr, 1.0)), ivec2(0), hi);
		vec4  sg = texelFetch(gb_cur, q, 0);
		float m  = texelFetch(aux_tex, q, 0).y;
		bool  same = sg.w < 5e4 && abs(sg.w - z) < 0.1 * z + 0.05 && dot(sg.xyz, N) > 0.8;
		c += same ? smoothstep(0.03, 0.15, m) : 0.0;
	}
	return c / 16.0;
}
float AreaFade(float cov) { return smoothstep(0.35, 0.7, cov); }
float Pool(float cov) { return smoothstep(0.75, 0.95, cov); }
// (refl9b) Fireflies: a floor's reflection at most (3 .. 6 in pools) x the pixel's own luminance (a lone bright hit on a
// small wet speck was a glint that came and went).
vec3 ClampEnergy(vec3 refl, float lc, float pool) {
	float lr  = Luma(refl), cap = lc * mix(3.0, 6.0, pool) + 1e-4;
	return lr > cap ? refl * (cap / lr) : refl;
}

// ---- (rtfly-1029) The flashes ("fogonazos"): firefly limit and the composited contribution's temporal stabilisation ----
// The RTFLICKER self-check (rt-flicker.cpp) showed, with the camera still: 0.4-0.7 % of the points the reflections touch
// changed by > 10 % of the pixel's light from one frame to the next (0.2 % by > 20 %), the largest jump 95-98 %, every
// other pass ~0. Single bright hits (lights, emissives, a lit wall) and hits toggling hit / miss under the upscaler's
// jitter: the full-resolution mirror ray (water, pools, near-mirrors) is this frame's alone, and the trace's mask and
// confidence change per pixel per frame, so the composite's weight did too. Two limits (misc.w & 1024,
// KYTY_RT_REFLECTIONS_STABLE=1, the default; 0: the previous behaviour):
//   Firefly:   the reflected light at most 4x the light around the reflector (the pixel and 4 taps 2 px away) + a little,
//              and at most 4.0 display-referred (after the game's exposure); never below the pixel's own light or the
//              game's own reflected colour (a lower target would darken it).
//   Stabilize: the composite's contribution (its colour out - the game's colour in) kept per render pixel (binding 12,
//              with the view distance), reprojected by the motion vector next frame (a different distance: no history,
//              from zero), averaged (30 % new on a still camera, 85 % when it moves) and limited to a change of 6 % of
//              the pixel's light a frame (36 % when moving), so a still camera gives a still reflection and nothing
//              pops in or out in one frame. It only moves between the last result and this frame's, both within the
//              darkening limit (MaxDarken), so it adds no darkening (vegetation, surfaces against walls).
bool Stable() { return (push.misc.w & 1024) != 0; }
// ---- (water-1030) Water flashes ----
// Water and mirror pools reflect with a high weight (the minimum reflectance 0.4, the pool boost): one bright hit (sky,
// sun, an emissive) or a ray that hits on one frame and misses on the next (rippling normals, the jitter) is a big jump
// there, and the stabilisation let everything through as soon as the camera moved (water is still while the camera
// moves). With WaterStable (misc.w & 2048, KYTY_RT_REFLECTIONS_WATER_STABLE=1, the default):
