#version 450
// KYTY_RT_SHADOWS (frame-gen.cpp, "Sombras RT"; KYTY_CONTACT_SHADOWS is the old name): screen-space ray-traced sun
// shadows on the PS5 Pro path's render-resolution HDR color (linear, before the game's exposure, the upscaler and
// its TAA). Short rays from each pixel toward the sun, marched against the game's depth buffer (Bend Studio style:
// contact detail the shadow maps miss), then denoised and multiplied into the color (darken only). Modes (misc.x):
//   0 trace:     12 / 20 / 32 steps (levels 1 / 2 / 3; half res at 1), ray <= 1 m (x1.25 at 3) and <= a screen
//                length (48 / 96 / 160 px at 1440p), thickness test, per-frame IGN jitter, soft ends; the result is
//                weighted by the surface's facing to the sun (N.L: back-facing surfaces untouched, grazing ones fade)
//                -> raw (visibility in .r) + gbuf_out (view normal, linear depth)
//   1 temporal:  reprojection by the game's motion vectors, history rejected on depth / normal discontinuity,
//                neighbourhood clamp (3x3, edge-aware), alpha max(1 / count, 0.1 (0.07 at 3)); count in aux .x
//   2 a-trous:   5x5 B3 kernel with depth / normal / visibility edge stops; steps 1, 2 (, 4 at 2 and 3)
//   4 composite: joint bilateral upsample; color *= 1 - strength * fade * stable * (1 - vis); fade 0 on the sky and
//                beyond KYTY_RT_SHADOWS fade distance; stable ramps with the history count (no popping noise)
//   5 calibrate: the depth buffer's floors against the world axes (the camera's view of world X, Y, Z in cand[0..2]),
//                both signs, both screen y conventions: which world axis is up and whether the screen's y is mirrored
//                (12 counters per slot into vote_buf; the CPU reads them back)
// Screen y convention (misc.w bit 2): set = the render's row 0 is NDC y +1 (the GNM / D3D viewport, the default).
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D color_tex;
layout(binding = 1) uniform sampler2D depth_tex;
layout(binding = 2) uniform sampler2D motion_tex;
layout(binding = 3) uniform sampler2D src_a;
layout(binding = 4) uniform sampler2D src_b;
layout(binding = 5) uniform sampler2D gbuf_cur;
layout(binding = 6) uniform sampler2D gbuf_prev;
layout(binding = 7, rgba16f) uniform writeonly image2D out_img;
layout(binding = 8, rgba16f) uniform writeonly image2D gbuf_out;
layout(binding = 9) uniform sampler2D aux_tex;
layout(binding = 10, rgba16f) uniform writeonly image2D aux_out;
layout(binding = 11, std430) buffer VoteBuf { uint v[]; } vote_buf; // per slot 16 words

layout(push_constant) uniform Push {
	vec4  proj;      // M[0], M[5], M[8], M[9] (row vectors)
	vec4  depth_map; // A = M[10], B = M[14], C = M[11], D = M[15]
	vec4  motion;    // motion_scale.xy, render size.xy
	vec4  trace;     // trace size.xy, strength, length scale
	ivec4 misc;      // mode, frame, level, flags (bit0 reset, bit1 history valid, bit2 row 0 = NDC y +1); slot: misc.w >> 8
	vec4  extra;     // a-trous step; light direction in view space (toward the light) in yzw
	vec4  cand[4];   // calibrate: world X, Y, Z in view space (w 1 = in use); cand[3]: screen cap px, thickness
	                 // scale, fade start, fade end (m)
} push;

vec2 RenderSize() { return push.motion.zw; }
vec2 TraceSize() { return push.trace.xy; }
float YSign() { return (push.misc.w & 4) != 0 ? -1.0 : 1.0; }

float ViewZ(float d) {
	float den = d * push.depth_map.z - push.depth_map.x;
	return abs(den) > 1e-12 ? (push.depth_map.y - d * push.depth_map.w) / den : 1e6;
}
vec3 ViewPosY(vec2 uv, float d, float ys) {
	float z  = ViewZ(d);
	float w  = z * push.depth_map.z + push.depth_map.w;
	vec2  nd = vec2(uv.x * 2.0 - 1.0, ys * (uv.y * 2.0 - 1.0));
	return vec3((nd.x * w - z * push.proj.z) / push.proj.x, (nd.y * w - z * push.proj.w) / push.proj.y, z);
}
vec3 ViewPos(vec2 uv, float d) { return ViewPosY(uv, d, YSign()); }
vec3 Project(vec3 p) {
	float w  = p.z * push.depth_map.z + push.depth_map.w;
	vec2  nd = vec2(p.x * push.proj.x + p.z * push.proj.z, p.y * push.proj.y + p.z * push.proj.w) / w;
	return vec3(nd.x * 0.5 + 0.5, YSign() * nd.y * 0.5 + 0.5, (p.z * push.depth_map.x + push.depth_map.y) / w);
}
bool IsSky(float d) { return d <= 1e-7 || d >= 0.9999999 || abs(ViewZ(d)) > 2e3; }
float Ign(vec2 p) { return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715)))); }

vec3 NormalAtY(vec2 uv, vec3 p, float ys) {
	vec2 t  = 1.0 / RenderSize();
	vec3 px = ViewPosY(uv + vec2(t.x, 0), textureLod(depth_tex, uv + vec2(t.x, 0), 0).r, ys);
	vec3 nx = ViewPosY(uv - vec2(t.x, 0), textureLod(depth_tex, uv - vec2(t.x, 0), 0).r, ys);
	vec3 py = ViewPosY(uv + vec2(0, t.y), textureLod(depth_tex, uv + vec2(0, t.y), 0).r, ys);
	vec3 ny = ViewPosY(uv - vec2(0, t.y), textureLod(depth_tex, uv - vec2(0, t.y), 0).r, ys);
	// The smaller-step side each way (no normals across silhouettes).
	vec3 dx = abs(px.z - p.z) < abs(p.z - nx.z) ? px - p : p - nx;
	vec3 dy = abs(py.z - p.z) < abs(p.z - ny.z) ? py - p : p - ny;
	vec3 n  = cross(dx, dy);
	float l = length(n);
	n = l > 1e-20 ? n / l : normalize(-p);
	if (dot(n, -p) < 0.0) n = -n;
	return n;
}
vec3 NormalAt(vec2 uv, vec3 p) { return NormalAtY(uv, p, YSign()); }

// The march: occlusion toward the light (0 lit, 1 occluded by something in the depth buffer).
float March(vec3 p, vec3 n, vec3 l, ivec2 pixel) {
	int   q     = push.misc.z;
	int   steps = q >= 3 ? 48 : q >= 2 ? 28 : 16; // (10-24) more: the rays are longer
	float z     = abs(p.z);
	// World length, capped to a screen length (the detail scale Bend's shadows work at; long rays are the shadow
	// maps' business and only double them).
	float px_m  = abs(push.proj.y) * 0.5 * RenderSize().y / max(z, 1e-3);
	float cap   = push.cand[3].x * RenderSize().y / 1440.0;
	float len   = min((q >= 3 ? 1.25 : 1.0) * push.trace.w, cap / px_m);
	// Thickness: an occluder is taken as this deep behind its depth-buffer surface (thin-object leak guard).
	float thick = clamp(0.06 + 0.02 * z, 0.06, 1.0) * push.cand[3].y;
	float bias  = 0.0015 * z + 0.002;
	float jit   = Ign(vec2(pixel) + float(push.misc.y % 64) * 5.588238);
	vec3  o     = p + n * (0.002 * z + 0.003);
	// The first sample one pixel out (no self-hit on the start texel).
	float t0    = 1.0 / px_m;
	for (int s = 0; s < steps; ++s) {
		float k  = (float(s) + jit) / float(steps);
		float t  = t0 + (len - t0) * k * k; // denser near the surface: contact detail
		vec3  qp = o + l * t;
		vec3  pr = Project(qp);
		if (any(lessThan(pr.xy, vec2(0))) || any(greaterThan(pr.xy, vec2(1)))) break;
		float sd = textureLod(depth_tex, pr.xy, 0).r;
		if (IsSky(sd)) continue;
		float delta = abs(qp.z) - abs(ViewZ(sd)); // > 0: the ray point is behind the depth surface there
		if (delta > bias && delta < thick) {
			// Screen-edge and ray-end fades (no hard cut where the ray leaves what the screen knows), and a softer
			// hit near the thickness limit.
			vec2  e    = min(pr.xy, 1.0 - pr.xy);
			float edge = smoothstep(0.0, 0.04, min(e.x, e.y));
			float end  = 1.0 - smoothstep(0.85, 1.0, k); // (10-24) only the last stretch (was 0.65: rays felt short)
			float soft = 1.0 - smoothstep(0.6 * thick, thick, delta);
			return edge * end * soft;
		}
	}
	return 0.0;
}

void Trace(ivec2 pixel) {
	vec2  uv = (vec2(pixel) + 0.5) / TraceSize();
	float d  = textureLod(depth_tex, uv, 0).r;
	if (IsSky(d)) {
		imageStore(out_img, pixel, vec4(1));
		imageStore(gbuf_out, pixel, vec4(0, 0, 1, 1e6));
		return;
	}
	vec3 p = ViewPos(uv, d);
	vec3 n = NormalAt(uv, p);
	imageStore(gbuf_out, pixel, vec4(n, abs(p.z)));
	vec3  l   = normalize(push.extra.yzw);
	float ndl = dot(n, l);
	// Surfaces facing away get no direct sun: the game's own lighting has them dark already (nothing to add);
	// grazing ones fade in (their depth-buffer self-hits are noise).
	float w   = smoothstep(0.04, 0.22, ndl) * (1.0 - smoothstep(push.cand[3].w, push.cand[3].w * 1.2, abs(p.z)));
	float occ = w > 0.0 ? March(p, n, l, pixel) * w : 0.0;
	float v   = 1.0 - occ;
	imageStore(out_img, pixel, vec4(isnan(v) ? 1.0 : clamp(v, 0.0, 1.0)));
}

void Temporal(ivec2 pixel) {
	vec2 ts  = 1.0 / TraceSize();
	vec2 uv  = (vec2(pixel) + 0.5) * ts;
	float cur = textureLod(src_a, uv, 0).r;
	vec4 g   = textureLod(gbuf_cur, uv, 0);
	if (g.w > 1e5) {
		imageStore(out_img, pixel, vec4(1));
		imageStore(aux_out, pixel, vec4(0));
		return;
	}
	// The 3x3 neighbourhood of the same surface: mean and deviation (the history's clamp box).
	float m1 = 0.0, m2 = 0.0, wn = 0.0;
	for (int y = -1; y <= 1; ++y)
		for (int x = -1; x <= 1; ++x) {
			vec2  suv = uv + vec2(x, y) * ts;
			vec4  sg  = textureLod(gbuf_cur, suv, 0);
			float w   = (abs(sg.w - g.w) < 0.05 * g.w && dot(sg.xyz, g.xyz) > 0.8) ? 1.0 : 0.0;
			float sv  = textureLod(src_a, suv, 0).r;
			m1 += sv * w;
			m2 += sv * sv * w;
			wn += w;
		}
	wn = max(wn, 1.0);
	m1 /= wn, m2 /= wn;
	float sigma = sqrt(max(m2 - m1 * m1, 0.0));
	float a_min = push.misc.z >= 3 ? 0.07 : 0.1;
	float count = 1.0;
	float res   = mix(m1, cur, 0.5);
	vec2  puv   = uv + textureLod(motion_tex, uv, 0).xy * push.motion.xy / RenderSize();
	if ((push.misc.w & 1) == 0 && (push.misc.w & 2) != 0 && all(greaterThanEqual(puv, vec2(0))) && all(lessThanEqual(puv, vec2(1)))) {
		vec4 pg = textureLod(gbuf_prev, puv, 0);
		// History rejection: another surface there last frame (depth > 5 % off, or the normal turned > 25 degrees).
		if (pg.w < 1e5 && abs(pg.w - g.w) / max(g.w, 1e-3) < 0.05 && dot(pg.xyz, g.xyz) > 0.9) {
			float pc    = textureLod(aux_tex, puv, 0).x;
			count       = min(max(pc, 1.0) + 1.0, 32.0);
			float alpha = max(1.0 / count, a_min);
			float k     = mix(1.0, 2.5, clamp(count / 16.0, 0.0, 1.0));
			float hist  = clamp(textureLod(src_b, puv, 0).r, m1 - k * sigma - 0.05, m1 + k * sigma + 0.05);
			res         = mix(hist, cur, alpha);
		}
	}
	res = clamp(isnan(res) ? 1.0 : res, 0.0, 1.0);
	imageStore(out_img, pixel, vec4(res));
	imageStore(aux_out, pixel, vec4(count, 0, 0, 0));
}

void Atrous(ivec2 pixel) {
	vec2 ts = 1.0 / TraceSize();
	vec2 uv = (vec2(pixel) + 0.5) * ts;
	vec4 g  = textureLod(gbuf_cur, uv, 0);
	float c = textureLod(src_a, uv, 0).r;
	if (g.w > 1e5) {
		imageStore(out_img, pixel, vec4(c));
		return;
	}
	const float kern[3] = float[](0.375, 0.25, 0.0625);
	float step = push.extra.x;
	// Visibility edge stop: loose on the first pass (noise), tighter after (keeps the contact line crisp).
	float sv_den = step <= 1.0 ? 0.6 : 0.35;
	float sum = 0.0, wsum = 0.0;
	for (int y = -2; y <= 2; ++y)
		for (int x = -2; x <= 2; ++x) {
			vec2  suv = uv + vec2(x, y) * step * ts;
			vec4  sg  = textureLod(gbuf_cur, suv, 0);
			float sc  = textureLod(src_a, suv, 0).r;
			float w   = kern[abs(x)] * kern[abs(y)] * pow(max(dot(sg.xyz, g.xyz), 0.0), 16.0) *
			          exp(-abs(sg.w - g.w) / max(g.w * 0.015 * step, 1e-3)) * exp(-abs(sc - c) / sv_den);
			w = sg.w > 1e5 ? 0.0 : w;
			sum += sc * w;
			wsum += w;
		}
	float r = wsum > 1e-6 ? sum / wsum : c;
	imageStore(out_img, pixel, vec4(clamp(isnan(r) ? c : r, 0.0, 1.0)));
}

float Upsample(vec2 uv, float z) {
	vec2  tc = uv * TraceSize() - 0.5;
	vec2  f  = fract(tc);
	ivec2 b  = ivec2(floor(tc));
	ivec2 mx = ivec2(TraceSize()) - 1;
	float sum = 0.0, wsum = 0.0;
	for (int i = 0; i < 4; ++i) {
		ivec2 o  = ivec2(i & 1, i >> 1);
		ivec2 q  = clamp(b + o, ivec2(0), mx);
		float bw = (o.x == 1 ? f.x : 1.0 - f.x) * (o.y == 1 ? f.y : 1.0 - f.y);
		float w  = (bw + 1e-3) / (1e-3 + abs(texelFetch(gbuf_cur, q, 0).w - z) / max(z * 0.02, 1e-3));
		sum += texelFetch(src_a, q, 0).r * w;
		wsum += w;
	}
	return sum / max(wsum, 1e-6);
}

void Composite(ivec2 pixel) {
	vec2  uv  = (vec2(pixel) + 0.5) / RenderSize();
	vec4  col = texelFetch(color_tex, pixel, 0);
	float d   = texelFetch(depth_tex, pixel, 0).r;
	float z   = abs(ViewZ(d));
	// Sky and far geometry / fog unchanged: screen-space data is only reliable near.
	float fade = IsSky(d) ? 0.0 : 1.0 - smoothstep(push.cand[3].z, push.cand[3].w, z);
	float amt  = push.trace.z * fade;
	if (amt <= 0.0) {
		imageStore(out_img, pixel, col);
		return;
	}
	float vis = TraceSize().x == RenderSize().x ? texelFetch(src_a, pixel, 0).r : Upsample(uv, z);
	vis = (isnan(vis) || isinf(vis)) ? 1.0 : clamp(vis, 0.0, 1.0);
	// A tiny partial occlusion (blur tails, jitter noise) is not a shadow: no grey veil.
	float occ = clamp((1.0 - vis - 0.04) / 0.96, 0.0, 1.0);
	// Temporal-stable mask: newly disoccluded / reset pixels ramp in over a few frames instead of flickering.
	float count  = textureLod(aux_tex, uv, 0).x;
	float stable = smoothstep(1.0, 5.0, count);
	// Multiply only, in the linear HDR input: factor in [1 - strength, 1]; never above the input (no lightening).
	float factor = 1.0 - clamp(amt * stable * occ, 0.0, 0.95);
	vec3  rgb    = min(col.rgb * factor, col.rgb);
	if (any(isnan(rgb)) || any(isinf(rgb))) rgb = col.rgb;
	imageStore(out_img, pixel, vec4(rgb, col.a));
}

shared uint s_vote[12];
void Calibrate(ivec2 pixel) {
	uint li = gl_LocalInvocationIndex;
	if (li < 12u) s_vote[li] = 0u;
	barrier();
	// Every 4th pixel each way of the render (dispatched at render / 4).
	ivec2 rp = pixel * 4 + 2;
	if (rp.x < int(RenderSize().x) && rp.y < int(RenderSize().y)) {
		vec2  uv = (vec2(rp) + 0.5) / RenderSize();
		float d  = texelFetch(depth_tex, rp, 0).r;
		if (!IsSky(d) && abs(ViewZ(d)) < 40.0) {
			// The normal as reconstructed with row 0 = NDC y +1; the other convention mirrors its y.
			vec3 p  = ViewPosY(uv, d, -1.0);
			vec3 na = NormalAtY(uv, p, -1.0);
			vec3 nb = vec3(na.x, -na.y, na.z);
			for (int k = 0; k < 3; ++k) {
				if (push.cand[k].w < 0.5) continue;
				vec3  a  = normalize(push.cand[k].xyz);
				float ca = dot(na, a), cb = dot(nb, a);
				if (ca > 0.97) atomicAdd(s_vote[k * 2 + 0], 1u);
				if (ca < -0.97) atomicAdd(s_vote[k * 2 + 1], 1u);
				if (cb > 0.97) atomicAdd(s_vote[6 + k * 2 + 0], 1u);
				if (cb < -0.97) atomicAdd(s_vote[6 + k * 2 + 1], 1u);
			}
		}
	}
	barrier();
	if (li < 12u && s_vote[li] != 0u) atomicAdd(vote_buf.v[uint(push.misc.w >> 8) * 16u + li], s_vote[li]);
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	int   mode  = push.misc.x;
	if (mode == 5) { Calibrate(pixel); return; } // (all invocations reach its barriers)
	ivec2 size = ivec2(mode == 4 ? RenderSize() : TraceSize());
	if (pixel.x >= size.x || pixel.y >= size.y) return;
	if (mode == 0) Trace(pixel);
	else if (mode == 1) Temporal(pixel);
	else if (mode == 4) Composite(pixel);
	else Atrous(pixel);
}
