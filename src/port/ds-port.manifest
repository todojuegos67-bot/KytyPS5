<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- (KYTY_SEGMENT_HEAP, default ON) The process heap, and so the C runtime's malloc and operator new, as the Windows 10
     2004+ Segment Heap: freed memory decommitted promptly instead of kept in the NT heap's segments. Older Windows
     ignores the element. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <heapType xmlns="http://schemas.microsoft.com/SMI/2020/WindowsSettings">SegmentHeap</heapType>
    </windowsSettings>
  </application>
</assembly>
