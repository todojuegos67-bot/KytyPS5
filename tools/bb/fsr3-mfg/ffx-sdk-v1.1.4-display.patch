+// Kyty display meter. With KYTY_FSR3_DISPLAY_IDS=1 the emulator gives each game present a VkPresentIdKHR (a count) and every present
+// to the driver swapchain carries id = count * 4 + slot: the real frame is slot 3, the generated frames the slots before it
+// (3 - generated + k), so each one is a distinct, increasing present id the emulator can wait for (VK_KHR_present_wait) to time
+// when it is displayed. The ids are listed in kytyFfxTakeDisplayIds in present order.
+bool kytyDisplayIdsOn()
+{
+    static const bool on = []
+    {
+        char value[8] = {};
+        return GetEnvironmentVariableA("KYTY_FSR3_DISPLAY_IDS", value, sizeof(value)) > 0 && value[0] == '1';
+    }();
+    return on;
+}
+
+template <typename Entry, typename FrameTypeT>
+uint64_t kytyDisplayIdOf(Entry&& entry, FrameTypeT frameType)
+{
+    const uint64_t count = entry.kytyPresentId;
+    if (count == 0)
+        return 0;
+    const bool real = frameType == PacingData::FrameType::Real;
+    if (!kytyDisplayIdsOn())
+        return real ? count : 0;
+    if (real)
+        return count * 4 + 3;
+    uint32_t generated = (entry.frames[PacingData::FrameType::Interpolated_1].doPresent ? 1u : 0u)
+                         + (entry.frames[PacingData::FrameType::Interpolated_2].doPresent ? 1u : 0u)
+                         + (entry.frames[PacingData::FrameType::Interpolated_3].doPresent ? 1u : 0u);
+    const uint32_t k = frameType == PacingData::FrameType::Interpolated_1 ? 0u : (frameType == PacingData::FrameType::Interpolated_2 ? 1u : 2u);
+    if (generated < k + 1)
+        generated = k + 1;
+    return count * 4 + (3 - generated) + k;
+}
+
+uint64_t kytyRealDisplayId(uint64_t count)
+{
+    return count == 0 ? 0 : (kytyDisplayIdsOn() ? count * 4 + 3 : count);
+}
+
+constexpr uint32_t kytyIdRingSize = 512;
+SRWLOCK            kytyIdLock     = SRWLOCK_INIT;
+uint64_t           kytyIdRing[kytyIdRingSize] = {};
+uint32_t           kytyIdHead = 0;  // the next id to hand out
+uint32_t           kytyIdTail = 0;  // the next slot to fill
+
+void kytyRecordDisplayId(uint64_t id)
+{
+    AcquireSRWLockExclusive(&kytyIdLock);
+    kytyIdRing[kytyIdTail % kytyIdRingSize] = id;
+    ++kytyIdTail;
+    if (kytyIdTail - kytyIdHead > kytyIdRingSize)
+        kytyIdHead = kytyIdTail - kytyIdRingSize;
+    ReleaseSRWLockExclusive(&kytyIdLock);
+}
+}  // namespace
+
+// The display ids presented since the last call, oldest first (at most max). Count returned.
+extern "C" __declspec(dllexport) uint32_t kytyFfxTakeDisplayIds(uint64_t* out, uint32_t max)
+{
+    uint32_t n = 0;
+    AcquireSRWLockExclusive(&kytyIdLock);
+    while (kytyIdHead != kytyIdTail && n < max)
+        out[n++] = kytyIdRing[kytyIdHead++ % kytyIdRingSize];
+    ReleaseSRWLockExclusive(&kytyIdLock);
+    return n;
+}
